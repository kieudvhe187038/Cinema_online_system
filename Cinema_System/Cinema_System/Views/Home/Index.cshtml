@section Scripts {
    <script>
        // Chờ trang load xong rồi mới chạy script carousel
        document.addEventListener('DOMContentLoaded', function() {
            // Biến lưu chỉ số slide hiện tại
            let currentSlide = 0;
            const slides = document.querySelectorAll('.carousel-slide');
            const dots = document.querySelectorAll('.carousel-dot');
            const nextBtn = document.querySelector('.carousel-next');
            const prevBtn = document.querySelector('.carousel-prev');

            // Hàm hiển thị slide theo chỉ số n
            function showSlide(n) {
                // Ẩn tất cả slide trước
                slides.forEach(slide => {
                    slide.classList.remove('opacity-100');
                    slide.classList.add('opacity-0');
                });
                // Đổi màu dot tương ứng với slide đang hiển thị
                dots.forEach(dot => dot.style.background = dot.getAttribute('data-slide') == n ? 'rgba(255,255,255,0.8)' : 'rgba(255,255,255,0.3)');
                // Nếu vượt quá slide cuối thì quay về đầu
                if (n >= slides.length) currentSlide = 0;
                // Nếu lùi trước slide đầu thì chuyển về slide cuối
                if (n < 0) currentSlide = slides.length - 1;
                // Hiển thị slide hiện tại
                slides[currentSlide].classList.remove('opacity-0');
                slides[currentSlide].classList.add('opacity-100');
            }

            function nextSlide() {
                // Chuyển sang slide kế tiếp
                currentSlide++;
                if (currentSlide >= slides.length) currentSlide = 0; // nếu đến cuối thì quay lại slide đầu
                showSlide(currentSlide);
            }

            function prevSlide() {
                // Chuyển sang slide trước
                currentSlide--;
                if (currentSlide < 0) currentSlide = slides.length - 1; // nếu lùi trước slide đầu thì về slide cuối
                showSlide(currentSlide);
            }

            // Đăng ký sự kiện cho nút next/prev
            nextBtn?.addEventListener('click', nextSlide);
            prevBtn?.addEventListener('click', prevSlide);

            // Đăng ký sự kiện cho các dot ở dưới
            dots.forEach((dot, index) => {
                dot.addEventListener('click', function() {
                    currentSlide = index;
                    showSlide(currentSlide);
                });
            });

            // Khởi tạo trạng thái ban đầu cho dot và slide
            showSlide(currentSlide);

            // Tự động chuyển slide sau mỗi 5 giây
            setInterval(nextSlide, 5000);
        });
    </script>
}

