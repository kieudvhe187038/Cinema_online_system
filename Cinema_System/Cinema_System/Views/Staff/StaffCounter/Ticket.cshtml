@model TicketPrintViewModel
@{
    ViewData["Title"] = "In Vé";
    // CỐ Ý không set Layout: dùng _Layout công khai để trang in không có sidebar Staff.
}

@section Styles {
    <style>
        /* Chỉ giữ phần CSS cho IN ẤN — phần hiển thị dùng Tailwind utilities.
           Lưu ý: _Layout bật `important: true` nên utility của Tailwind mang !important,
           mọi rule muốn đè lên chúng lúc in đều phải có !important. */
        @@media print {
            /* Ẩn khung trang public: header cố định + footer (footer KHÔNG có class riêng). */
            #main-header, footer { display: none !important; }
            main { padding-top: 0 !important; }
            body { background: #fff !important; }

            /* Nhân viên có thể đang bật chế độ tối — ép vé về đen/trắng, nếu không sẽ
               in ra chữ xám nhạt trên giấy trắng (không đọc được). */
            html.dark, html.dark body, html.dark .bg-white { background: #fff !important; }
            html.dark * { color: #000 !important; border-color: #cbd5e1 !important; box-shadow: none !important; }
        }
    </style>
}

<div class="mx-auto max-w-3xl px-6 pb-12 print:max-w-full print:px-0">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-4 print:hidden">
        <h1 class="font-head text-2xl font-extrabold text-slate-900">Vé đã đặt</h1>
        <div class="flex flex-wrap gap-2">
            <button type="button" onclick="window.print()"
                    class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-primary-dark">
                <span class="material-symbols-outlined" style="font-size:18px">print</span> In vé (PDF)
            </button>
            <a href="@Url.Action("Index", "StaffCounter")"
               class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-200">
                <span class="material-symbols-outlined" style="font-size:18px">add_circle</span> Đơn mới
            </a>
            <a href="@Url.Action("Index", "StaffBooking")"
               class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-200">
                <span class="material-symbols-outlined" style="font-size:18px">receipt_long</span> Danh sách đơn
            </a>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm print:rounded-none print:border-0 print:p-0 print:shadow-none">
        <div class="text-center font-head text-2xl font-extrabold tracking-wide text-primary">CineStar</div>
        <div class="mb-5 text-center text-xs text-slate-500">Vé xem phim — @(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")</div>

        <div class="my-4 rounded-lg border-2 border-dashed border-slate-300 p-3 text-center font-mono text-xl font-extrabold tracking-[.1em] text-slate-900">
            @Model.BookingCode
        </div>

        <div class="mb-5 grid grid-cols-1 gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
            <div><span class="text-slate-500">Phim:</span> <strong class="text-slate-900">@Model.MovieTitle</strong></div>
            <div><span class="text-slate-500">Rạp:</span> <span class="text-slate-900">@Model.CinemaName</span></div>
            <div><span class="text-slate-500">Phòng:</span> <span class="text-slate-900">@Model.RoomName</span></div>
            <div><span class="text-slate-500">Suất:</span> <span class="text-slate-900">@Model.ShowStartTime.ToString("dd/MM/yyyy HH:mm")</span></div>
            <div><span class="text-slate-500">Khách:</span> <span class="text-slate-900">@Model.CustomerName</span></div>
            <div><span class="text-slate-500">Nhân viên:</span> <span class="text-slate-900">@(Model.StaffName ?? "—")</span></div>
        </div>

        @foreach (var t in Model.Tickets)
        {
            <div class="mb-2 flex items-center justify-between gap-3 rounded-lg border border-slate-200 px-4 py-3">
                <div class="min-w-0">
                    <div class="text-xl font-extrabold text-slate-900">@t.SeatLabel</div>
                    <div class="font-mono text-xs text-slate-500">@t.SeatType · @t.TicketCode</div>
                </div>
                <div class="shrink-0 font-bold text-slate-900">@t.Price.ToString("#,##0") đ</div>
            </div>
        }

        @if (Model.Foods.Any())
        {
            <table class="mt-4 w-full text-sm">
                <tbody>
                    @foreach (var f in Model.Foods)
                    {
                        <tr>
                            <td class="py-1 text-slate-600">@f.Name x @f.Quantity</td>
                            <td class="py-1 text-right font-semibold text-slate-900">@f.LineTotal.ToString("#,##0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <table class="mt-4 w-full text-sm">
            <tbody>
                <tr>
                    <td class="py-1 text-slate-600">Tạm tính</td>
                    <td class="py-1 text-right font-semibold text-slate-900">@Model.TotalAmount.ToString("#,##0") đ</td>
                </tr>
                @if (Model.DiscountAmount > 0)
                {
                    <tr>
                        <td class="py-1 text-slate-600">Giảm giá</td>
                        <td class="py-1 text-right font-semibold text-slate-900">-@Model.DiscountAmount.ToString("#,##0") đ</td>
                    </tr>
                }
                <tr>
                    <td class="py-1 text-slate-600">VAT</td>
                    <td class="py-1 text-right font-semibold text-slate-900">@Model.VatAmount.ToString("#,##0") đ</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3 flex items-center justify-between border-t-2 border-slate-100 pt-3 text-lg font-extrabold text-primary">
            <span>Tổng cộng</span><span>@Model.FinalAmount.ToString("#,##0") đ</span>
        </div>

        @if (Model.Payment != null)
        {
            <table class="mt-3 w-full text-sm">
                <tbody>
                    <tr>
                        <td class="py-1 text-slate-600">Thanh toán (@Model.Payment.Method)</td>
                        <td class="py-1 text-right font-semibold text-slate-900">@Model.Payment.Amount.ToString("#,##0") đ</td>
                    </tr>
                    @if (Model.Payment.CashReceived.HasValue)
                    {
                        <tr>
                            <td class="py-1 text-slate-600">Khách đưa</td>
                            <td class="py-1 text-right font-semibold text-slate-900">@Model.Payment.CashReceived.Value.ToString("#,##0") đ</td>
                        </tr>
                        <tr>
                            <td class="py-1 text-slate-600">Tiền thừa</td>
                            <td class="py-1 text-right font-semibold text-slate-900">@((Model.Payment.ChangeAmount ?? 0).ToString("#,##0")) đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="mt-6 text-center text-xs text-slate-500">
            Cảm ơn quý khách! Vui lòng giữ vé để vào cửa. Vé không hoàn lại sau khi suất chiếu bắt đầu.
        </div>
    </div>
</div>
