@{
    ViewData["Title"] = "Tra Cứu Thành Viên";
    Layout = "_StaffLayout";
}

<div class="mx-auto max-w-xl">
    <div class="mb-6">
        <h1 class="mb-0.5 font-head text-2xl font-extrabold text-[#191c1d]">Tra Cứu Thành Viên</h1>
        <p class="text-sm text-gray-500">Nhập số điện thoại để xem thông tin và điểm thưởng của khách</p>
    </div>

    <div class="rounded-xl border border-[#e8eaed] bg-white p-6 shadow-sm">
        <div class="flex gap-2">
            <input type="tel" inputmode="numeric" maxlength="11" id="phone" placeholder="Nhập số điện thoại khách hàng..."
                   class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
            <button type="button" id="btn"
                    class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-primary px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-primary-dark">
                <span class="material-symbols-outlined" style="font-size:18px">search</span> Tra cứu
            </button>
        </div>

        <div id="result">
            <div class="mt-8 text-center text-sm text-gray-400">
                <span class="material-symbols-outlined mb-2 block" style="font-size:44px">badge</span>
                Chưa có kết quả — nhập số điện thoại rồi bấm Tra cứu.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Class dùng lại cho các dòng kết quả (JS dựng bằng chuỗi HTML nên phải khai ở đây).
        const LINE = 'flex items-center justify-between gap-3 border-b border-dashed border-gray-100 py-2.5 text-sm last:border-0';
        const LABEL = 'text-gray-500';
        const VALUE = 'min-w-0 text-right font-semibold text-[#191c1d] [overflow-wrap:anywhere]';

        function row(label, value, valueCls) {
            return '<div class="' + LINE + '"><span class="' + LABEL + '">' + label + '</span>' +
                   '<span class="' + (valueCls || VALUE) + '">' + value + '</span></div>';
        }

        function lookup() {
            const phone = $('#phone').val().trim();
            const $r = $('#result');
            if (!phone) { $r.html(''); return; }
            $.getJSON('/Staff/Counter/LookupMember', { phone: phone }, function (res) {
                if (res.found) {
                    const m = res.member;
                    $r.html(
                        '<div class="mt-6">' +
                        row('Họ tên', m.fullName) +
                        row('SĐT', m.maskedPhone || '—') +
                        row('Email', m.email || '—') +
                        row('Điểm thưởng', (m.rewardPoints || 0), 'text-lg font-extrabold text-primary') +
                        '</div>');
                } else {
                    $r.html('<div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">' +
                            'Không tìm thấy thành viên với SĐT này.</div>');
                }
            });
        }

        $('#btn').on('click', lookup);
        $('#phone').on('keypress', function (e) { if (e.which === 13) lookup(); });
    </script>
}
