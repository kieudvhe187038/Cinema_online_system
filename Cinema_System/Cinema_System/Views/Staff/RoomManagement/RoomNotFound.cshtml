@model Cinema_System.Application.ViewModels.RoomSeatsViewModel
@{
    ViewData["Title"] = "Không tìm thấy phòng";
    Layout = "_StaffLayout";
}

<div class="mb-5 flex items-center justify-between">
    <h1 class="font-head text-2xl font-bold text-secondary-dark">Quản lý phòng chiếu</h1>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Cột trái: vẫn cho chọn phòng khác -->
    <div class="space-y-6">
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <h2 class="mb-3 font-head font-bold text-secondary-dark">Danh sách phòng</h2>
            <div class="space-y-2">
                @foreach (var r in Model.AllRooms)
                {
                    <a asp-action="Seats" asp-route-roomId="@r.Id"
                       class="block rounded-xl border border-gray-100 p-3 transition hover:bg-gray-50">
                        <div class="flex items-center justify-between">
                            <span class="font-semibold text-secondary-dark">@r.Name</span>
                            <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @r.StatusClass">@r.StatusLabel</span>
                        </div>
                        <p class="text-xs text-gray-400">@r.RoomTypeName · @r.TotalSeats ghế</p>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Cột phải: thông báo lỗi đẹp, nằm trong layout -->
    <div class="lg:col-span-2 flex flex-col items-center justify-center rounded-2xl bg-white p-12 text-center shadow-sm">
        <span class="material-symbols-outlined mb-3 text-6xl text-gray-300">meeting_room</span>
        <h2 class="font-head text-xl font-bold text-secondary-dark">Không tìm thấy phòng chiếu</h2>
        <p class="mt-2 max-w-md text-sm text-gray-500">
            Mã phòng bạn truy cập không tồn tại hoặc đã bị xóa. Vui lòng chọn một phòng
            ở danh sách bên trái, hoặc quay lại trang quản lý phòng.
        </p>
        <a asp-action="Index"
           class="mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 font-semibold text-white hover:bg-primary-dark transition">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Về danh sách phòng
        </a>
    </div>
</div>