@model Cinema_System.Application.ViewModels.RoomSeatsViewModel
@{
    ViewData["Title"] = "Quản lý ghế";
    Layout = "_StaffLayout";
}

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@TempData["Error"]</div>
}

<div class="mb-5 flex items-center justify-between">
    <h1 class="font-head text-2xl font-bold text-secondary-dark">Quản lý phòng chiếu</h1>
    <div class="flex items-center gap-3">
        <span class="rounded-full px-3 py-1 text-sm font-semibold @Model.RoomStatusClass">@Model.RoomName · @Model.RoomTypeName · @Model.RoomStatusLabel</span>
        <button type="button" id="roomToggleBtn" data-maintenance="@Model.IsUnderMaintenance.ToString().ToLower()"
                class="inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm font-semibold transition @(Model.IsUnderMaintenance ? "border-green-600 text-green-700 hover:bg-green-600 hover:text-white" : "border-orange-500 text-orange-600 hover:bg-orange-500 hover:text-white")">
            <span class="material-symbols-outlined text-sm">@(Model.IsUnderMaintenance ? "lock_open" : "build")</span>
            @(Model.IsUnderMaintenance ? "Mở lại phòng" : "Đặt bảo trì")
        </button>
    </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Cột trái -->
    <div class="space-y-6">
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <h2 class="mb-3 font-head font-bold text-secondary-dark">Danh sách phòng</h2>
            <div class="space-y-2">
                @foreach (var r in Model.AllRooms)
                {
                    <a asp-action="Seats" asp-route-roomId="@r.Id"
                       class="block rounded-xl border p-3 transition @(r.Id == Model.RoomId ? "border-primary bg-primary/5" : "border-gray-100 hover:bg-gray-50")">
                        <div class="flex items-center justify-between">
                            <span class="font-semibold text-secondary-dark">@r.Name</span>
                            <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @r.StatusClass">@r.StatusLabel</span>
                        </div>
                        <p class="text-xs text-gray-400">@r.RoomTypeName · @r.TotalSeats ghế</p>
                    </a>
                }
            </div>
        </div>

        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <h2 class="mb-3 font-head font-bold text-secondary-dark">Thống kê nhanh</h2>
            <div class="rounded-xl bg-green-50 p-3 text-center">
                <p class="font-head text-2xl font-bold text-green-600">@Model.AvailableCount</p>
                <p class="text-xs text-gray-500">Số ghế trong phòng</p>
            </div>
        </div>
    </div>

    <!-- Cột phải: sơ đồ ghế -->
    <div class="lg:col-span-2 rounded-2xl bg-white p-6 shadow-sm">
        <div class="mx-auto mb-8 w-2/3 border-t-4 border-secondary/40 pt-2 text-center text-xs font-semibold uppercase tracking-[0.3em] text-gray-400">Màn hình / Screen</div>

        <div class="space-y-2 overflow-x-auto">
            @foreach (var row in Model.Seats.GroupBy(s => s.RowNumber).OrderBy(g => g.Key))
            {
                <div class="flex items-center justify-center gap-1.5">
                    <span class="w-5 text-xs font-bold text-gray-400">@row.First().RowLabel</span>
                    @foreach (var seat in row.OrderBy(s => s.SeatNumber))
                    {
                        <div title="@seat.SeatLabel - @seat.SeatTypeName"
                             class="flex h-7 w-7 items-center justify-center rounded text-[10px] font-semibold @seat.CellClass">
                            @seat.SeatNumber
                        </div>
                    }

                    <span class="w-5 text-xs font-bold text-gray-400">@row.First().RowLabel</span>
                </div>
            }
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-4 border-t pt-4 text-xs text-gray-500">
            <span class="flex items-center gap-1"><span class="h-4 w-4 rounded bg-gray-100"></span> Ghế thường</span>
            <span class="flex items-center gap-1"><span class="h-4 w-4 rounded bg-blue-200"></span> Ghế VIP</span>
            <span class="flex items-center gap-1"><span class="h-4 w-4 rounded bg-purple-200"></span> Ghế đôi (Sweetbox)</span>
        </div>
    </div>
</div>

<!-- Popup xác nhận khóa/mở ghế -->
<div id="confirmModal" class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl">
        <div class="flex items-start gap-3">
            <span id="modalIcon" class="material-symbols-outlined text-primary">help</span>
            <div>
                <h3 id="modalTitle" class="font-head text-lg font-bold text-secondary-dark">Xác nhận</h3>
                <p id="modalMsg" class="mt-1 text-sm text-gray-600"></p>
            </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
            <button type="button" id="modalCancel" class="rounded-lg px-4 py-2 text-sm font-semibold text-gray-500 hover:bg-gray-100">Hủy</button>
            <button type="button" id="modalOk" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-dark">Xác nhận</button>
        </div>
    </div>
</div>

<form id="roomToggleForm" asp-action="ToggleRoomStatus" method="post" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roomId" value="@Model.RoomId" />
</form>

@section Scripts {
    <script>
        const modal = document.getElementById('confirmModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalMsg = document.getElementById('modalMsg');
        const modalIcon = document.getElementById('modalIcon');
        const modalOk = document.getElementById('modalOk');
        const modalCancel = document.getElementById('modalCancel');
        let pendingAction = null;   // việc sẽ chạy khi bấm Xác nhận (ghế hoặc phòng)

        function openModal(title, msg, danger, icon) {
            modalTitle.textContent = title;
            modalMsg.textContent = msg;
            modalIcon.textContent = icon;
            modalIcon.className = 'material-symbols-outlined ' + (danger ? 'text-red-500' : 'text-primary');
            modalOk.className = 'rounded-lg px-4 py-2 text-sm font-semibold text-white ' + (danger ? 'bg-red-500 hover:bg-red-600' : 'bg-primary hover:bg-primary-dark');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        function closeModal() { modal.classList.add('hidden'); modal.classList.remove('flex'); pendingAction = null; }

        // Nút đổi trạng thái phòng (Bảo trì <-> Hoạt động)
        const roomToggleBtn = document.getElementById('roomToggleBtn');
        if (roomToggleBtn) {
            roomToggleBtn.addEventListener('click', () => {
                const underMaintenance = roomToggleBtn.dataset.maintenance === 'true';
                if (underMaintenance) {
                    openModal('Mở lại phòng', 'Mở lại phòng này cho hoạt động bình thường?', false, 'lock_open');
                } else {
                    openModal('Đặt bảo trì phòng', 'Đặt phòng này sang trạng thái Bảo trì? Badge phòng sẽ chuyển thành "Bảo trì".', false, 'build');
                }
                pendingAction = () => document.getElementById('roomToggleForm').submit();
            });
        }

        modalOk.addEventListener('click', () => {
            if (pendingAction) pendingAction();
        });
        modalCancel.addEventListener('click', closeModal);
        modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
    </script>
}
