@model List<Cinema_System.Application.ViewModels.RoomListItemViewModel>
@{
    ViewData["Title"] = "Quản lý phòng chiếu";
    Layout = "_StaffLayout";
    var total = Model.Count;
    var active = Model.Count(r => r.IsActive);
    var maintenance = total - active;
}

<h1 class="mb-1 font-head text-2xl font-bold text-secondary-dark">Quản lý phòng chiếu</h1>
<p class="mb-6 text-sm text-gray-500">Tổng quan &amp; trạng thái các phòng chiếu trong rạp</p>

<!-- Thẻ thống kê -->
<div class="mb-7 grid grid-cols-1 gap-5 sm:grid-cols-3">
    <div class="flex items-center justify-between rounded-2xl border-l-4 border-secondary bg-white p-5 shadow-sm">
        <div><p class="text-sm text-gray-500">Tổng số phòng</p><p class="font-head text-3xl font-bold text-secondary-dark">@total</p></div>
        <span class="material-symbols-outlined rounded-xl bg-secondary/10 p-2 text-secondary">meeting_room</span>
    </div>
    <div class="flex items-center justify-between rounded-2xl border-l-4 border-green-500 bg-white p-5 shadow-sm">
        <div><p class="text-sm text-gray-500">Đang hoạt động</p><p class="font-head text-3xl font-bold text-green-600">@active</p></div>
        <span class="material-symbols-outlined rounded-xl bg-green-100 p-2 text-green-600">check_circle</span>
    </div>
    <div class="flex items-center justify-between rounded-2xl border-l-4 border-orange-500 bg-white p-5 shadow-sm">
        <div><p class="text-sm text-gray-500">Đang bảo trì</p><p class="font-head text-3xl font-bold text-orange-600">@maintenance</p></div>
        <span class="material-symbols-outlined rounded-xl bg-orange-100 p-2 text-orange-600">build</span>
    </div>
</div>

<h2 class="mb-4 font-head text-lg font-bold text-secondary-dark">Danh sách phòng chiếu</h2>
<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var room in Model)
    {
        <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
            <div class="mb-3 flex items-start justify-between">
                <span class="material-symbols-outlined rounded-lg bg-secondary/10 p-1.5 text-secondary">@(room.IsActive ? "videocam" : "build")</span>
                <span class="rounded-full px-3 py-1 text-xs font-semibold @room.StatusClass">@room.StatusLabel</span>
            </div>
            <h3 class="font-bold text-secondary-dark">@room.Name</h3>
            <p class="mt-2 flex items-center gap-1 text-sm text-gray-500"><span class="material-symbols-outlined text-[18px]">chair</span> Sức chứa: @room.TotalSeats ghế</p>
            <p class="flex items-center gap-1 text-sm text-gray-500"><span class="material-symbols-outlined text-[18px]">settings_input_component</span> Hệ thống: @room.RoomTypeName</p>
            <div class="mt-4 border-t pt-3">
                <a asp-action="Seats" asp-route-roomId="@room.Id" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline">
                    <span class="material-symbols-outlined text-[18px]">grid_on</span> Quản lý ghế
                </a>
            </div>
        </div>
    }
</div>
