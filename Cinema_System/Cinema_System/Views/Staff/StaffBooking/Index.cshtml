@model BookingListViewModel
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    Layout = "_StaffLayout";

    // Badge trạng thái / loại đơn — dùng chung bảng màu với màn Chi tiết đơn.
    (string cls, string dot, string text) StatusBadge(string? status) => status switch
    {
        "Paid" => ("bg-green-100 text-green-700", "bg-green-600", "Đã thanh toán"),
        "Cancelled" => ("bg-red-100 text-red-700", "bg-red-500", "Đã hủy"),
        _ => ("bg-amber-100 text-amber-700", "bg-amber-500", "Chờ thanh toán")
    };
    (string cls, string text) TypeBadge(string? type) => type == "Online"
        ? ("bg-blue-100 text-blue-700", "Online")
        : ("bg-amber-100 text-amber-700", "Tại quầy");

    const string thCls = "whitespace-nowrap px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wide text-gray-300";
    const string tdCls = "border-b border-gray-100 px-4 py-3.5 align-middle text-sm";
    const string filterCls = "rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20";
}

<div class="mx-auto max-w-[1280px]">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="mb-0.5 font-head text-2xl font-extrabold text-[#191c1d]">Quản Lý Đơn Hàng</h1>
            <p class="text-sm text-gray-500">Tra cứu đơn đặt vé online và tại quầy, xem chi tiết và in lại vé</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" id="bk-btnCamera"
                    class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-xs font-bold tracking-wide text-[#191c1d] transition-colors hover:bg-gray-50">
                <span class="material-symbols-outlined" style="font-size:18px">qr_code_scanner</span> QUÉT MÃ QR
            </button>
            <a href="@Url.Action("Index", "StaffCounter")"
               class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-lg bg-primary px-5 py-2.5 text-xs font-bold tracking-wide text-white transition-colors hover:bg-primary-dark">
                <span class="material-symbols-outlined" style="font-size:18px">point_of_sale</span> ĐẶT VÉ TẠI QUẦY
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@TempData["Error"]</div>
    }
    <div id="bk-qr-msg"></div>
    <div id="bk-qr-reader" class="mb-5 overflow-hidden rounded-xl border border-[#e8eaed] bg-white" style="display:none; max-width:320px;"></div>

    <form method="get" class="mb-5 flex flex-wrap items-center gap-3 rounded-xl border border-[#e8eaed] bg-white p-4">
        <input type="text" name="search" value="@Model.Search" class="@filterCls min-w-[260px] flex-1"
               placeholder="Tìm theo mã đặt vé, tên hoặc SĐT khách..." />
        <select name="bookingType" class="@filterCls">
            <option value="">-- Tất cả loại đơn --</option>
            <option value="Online" selected="@(Model.BookingType == "Online")">Online</option>
            <option value="Offline" selected="@(Model.BookingType == "Offline")">Tại quầy</option>
        </select>
        <select name="paymentStatus" class="@filterCls">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="Pending" selected="@(Model.PaymentStatus == "Pending")">Chờ thanh toán</option>
            <option value="Paid" selected="@(Model.PaymentStatus == "Paid")">Đã thanh toán</option>
            <option value="Cancelled" selected="@(Model.PaymentStatus == "Cancelled")">Đã hủy</option>
        </select>
        <button type="submit" class="rounded-lg bg-primary px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-primary-dark">Lọc</button>
        <a href="@Url.Action("Index", "StaffBooking")"
           class="rounded-lg bg-gray-100 px-5 py-2.5 text-sm font-semibold text-[#191c1d] transition-colors hover:bg-gray-200">Xóa lọc</a>
    </form>

    @if (Model.Bookings.Any())
    {
        <div class="mb-5 overflow-x-auto rounded-xl border border-[#e8eaed] bg-white">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-gray-900">
                        <th class="@thCls">Mã đặt vé</th>
                        <th class="@thCls">Phim / Suất</th>
                        <th class="@thCls">Khách hàng</th>
                        <th class="@thCls">Nhân viên</th>
                        <th class="@thCls">Ghế</th>
                        <th class="@thCls">Thành tiền</th>
                        <th class="@thCls">Loại</th>
                        <th class="@thCls">Trạng thái</th>
                        <th class="@thCls">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bookings)
                    {
                        var type = TypeBadge(b.BookingType);
                        var status = StatusBadge(b.PaymentStatus);
                        <tr class="hover:bg-gray-50">
                            <td class="@tdCls">
                                <span class="font-mono font-bold text-[#191c1d]">@(string.IsNullOrEmpty(b.BookingCode) ? "—" : b.BookingCode)</span>
                            </td>
                            <td class="@tdCls">
                                <div class="font-medium text-[#191c1d]">@b.MovieTitle</div>
                                <div class="text-xs text-gray-500">@b.RoomName · @b.ShowStartTime.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td class="@tdCls">@b.CustomerName</td>
                            <td class="@tdCls">@(string.IsNullOrEmpty(b.StaffName) ? "—" : b.StaffName)</td>
                            <td class="@tdCls">@b.SeatCount</td>
                            <td class="@tdCls whitespace-nowrap font-bold">@b.FinalAmount.ToString("#,##0") đ</td>
                            <td class="@tdCls">
                                <span class="inline-flex items-center whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold @type.cls">@type.text</span>
                            </td>
                            <td class="@tdCls">
                                <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold @status.cls">
                                    <span class="h-[7px] w-[7px] shrink-0 rounded-full @status.dot"></span> @status.text
                                </span>
                            </td>
                            <td class="@tdCls">
                                <a href="@Url.Action("Details", "StaffBooking", new { id = b.Id })"
                                   class="inline-flex items-center gap-1 whitespace-nowrap text-sm font-semibold text-secondary transition-colors hover:text-primary">
                                    <span class="material-symbols-outlined" style="font-size:18px">visibility</span> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", new PaginationViewModel
        {
            CurrentPage = Model.CurrentPage,
            TotalPages = Model.TotalPages,
            PageSize = Model.PageSize,
            TotalCount = Model.TotalCount,
            Action = "Index",
            Controller = "StaffBooking",
            ItemLabel = "đơn",
            RouteValues = new Dictionary<string, string?>
            {
                ["search"] = Model.Search,
                ["bookingType"] = Model.BookingType,
                ["paymentStatus"] = Model.PaymentStatus
            }
        })
    }
    else
    {
        <div class="rounded-xl border border-[#e8eaed] bg-white px-8 py-16 text-center text-sm text-gray-400">
            <span class="material-symbols-outlined mb-2 block" style="font-size:48px">receipt_long</span>
            Không tìm thấy đơn hàng nào phù hợp.
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
    <script>
        var bkQr = null;      // instance Html5Qrcode
        var bkScanning = false;
        var bkHandled = false; // chặn callback bắn nhiều lần cho cùng 1 lần quét

        function bkShowMsg(html) {
            $('#bk-qr-msg').html(html
                ? '<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">' + html + '</div>'
                : '');
        }

        function bkStartCamera() {
            if (typeof Html5Qrcode === 'undefined') {
                bkShowMsg('Không tải được thư viện quét mã (kiểm tra kết nối mạng).');
                return;
            }
            bkHandled = false;
            bkShowMsg('');
            $('#bk-qr-reader').show();
            $('#bk-btnCamera').text('Đóng camera').prop('disabled', true);

            bkQr = new Html5Qrcode('bk-qr-reader');
            bkQr.start(
                { facingMode: 'environment' },
                { fps: 10, qrbox: 250 },
                function (decodedText) {
                    if (bkHandled) return;
                    bkHandled = true;
                    bkStopCamera();
                    window.location.href = '/Staff/Booking/LookupByQr?qr=' + encodeURIComponent(decodedText);
                },
                function () { /* không tìm thấy QR ở frame hiện tại — bỏ qua, không phải lỗi */ }
            ).then(function () {
                bkScanning = true;
                $('#bk-btnCamera').prop('disabled', false);
            }).catch(function (err) {
                $('#bk-qr-reader').hide();
                $('#bk-btnCamera').text('Quét mã QR').prop('disabled', false);
                bkShowMsg('Không thể mở camera (chưa cấp quyền hoặc thiết bị không có camera).');
            });
        }

        function bkStopCamera() {
            $('#bk-btnCamera').text('Quét mã QR');
            if (bkQr && bkScanning) {
                bkScanning = false;
                bkQr.stop().then(function () { bkQr.clear(); }).catch(function () { });
            }
            $('#bk-qr-reader').hide();
        }

        $('#bk-btnCamera').on('click', function () {
            if (bkScanning) bkStopCamera(); else bkStartCamera();
        });
    </script>
}
