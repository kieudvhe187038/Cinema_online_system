@* Nút bật/tắt dark mode. Đặt trong header của layout. Xử lý click nằm ở partial _DarkMode. *@
<button type="button" data-theme-toggle title="Đổi giao diện Sáng / Tối" aria-label="Đổi giao diện Sáng / Tối"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 transition hover:text-primary hover:border-primary/40">
    <span class="material-symbols-outlined text-[20px]" data-theme-icon="moon">dark_mode</span>
    <span class="material-symbols-outlined text-[20px]" data-theme-icon="sun">light_mode</span>
</button>
