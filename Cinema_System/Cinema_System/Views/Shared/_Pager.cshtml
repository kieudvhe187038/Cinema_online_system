@*
    Phân trang dùng chung (windowed) — không bị tràn viền khi có nhiều trang.
    Hiển thị: « Trước · 1 … (cửa sổ quanh trang hiện tại) … N · Sau »

    Cách dùng trong view:
        @await Html.PartialAsync("_Pager", new PagerModel {
            CurrentPage = Model.CurrentPage,
            TotalPages  = Model.TotalPages,
            Action      = "Index",
            Controller  = "StaffBooking",
            RouteValues = new Dictionary<string, string?> {
                ["search"] = Model.Search,
                ["bookingType"] = Model.BookingType,
                ["paymentStatus"] = Model.PaymentStatus
            }
        })

    Tham số lọc hiện tại được giữ lại qua RouteValues; tham số "page" do partial tự thêm.
*@
@model Cinema_System.Application.ViewModels.PagerModel

@{
    if (Model.TotalPages <= 1)
    {
        return; // 0/1 trang thì không cần thanh phân trang
    }

    var current = Math.Clamp(Model.CurrentPage, 1, Model.TotalPages);
    var window = Math.Max(1, Model.WindowSize);

    // Cửa sổ trang quanh trang hiện tại
    var start = Math.Max(1, current - window);
    var end = Math.Min(Model.TotalPages, current + window);

    // Tạo link giữ nguyên các tham số lọc + gán page
    Func<int, string> pageUrl = p =>
    {
        var rv = new Dictionary<string, object?>();
        if (Model.RouteValues != null)
        {
            foreach (var kv in Model.RouteValues)
            {
                if (!string.IsNullOrEmpty(kv.Value))
                {
                    rv[kv.Key] = kv.Value;
                }
            }
        }
        rv["page"] = p;
        return Url.Action(Model.Action, Model.Controller, rv) ?? "#";
    };
}

<nav class="pager" aria-label="Phân trang">
    @* Nút Trước *@
    @if (current > 1)
    {
        <a class="pager-nav" href="@pageUrl(current - 1)" rel="prev" aria-label="Trang trước">‹</a>
    }
    else
    {
        <span class="pager-nav disabled" aria-hidden="true">‹</span>
    }

    @* Trang đầu + dấu … *@
    @if (start > 1)
    {
        <a class="pager-link" href="@pageUrl(1)">1</a>
        if (start > 2)
        {
            <span class="pager-gap">…</span>
        }
    }

    @* Cửa sổ trang quanh trang hiện tại *@
    @for (int p = start; p <= end; p++)
    {
        if (p == current)
        {
            <span class="pager-link active" aria-current="page">@p</span>
        }
        else
        {
            <a class="pager-link" href="@pageUrl(p)">@p</a>
        }
    }

    @* Dấu … + trang cuối *@
    @if (end < Model.TotalPages)
    {
        if (end < Model.TotalPages - 1)
        {
            <span class="pager-gap">…</span>
        }
        <a class="pager-link" href="@pageUrl(Model.TotalPages)">@Model.TotalPages</a>
    }

    @* Nút Sau *@
    @if (current < Model.TotalPages)
    {
        <a class="pager-nav" href="@pageUrl(current + 1)" rel="next" aria-label="Trang sau">›</a>
    }
    else
    {
        <span class="pager-nav disabled" aria-hidden="true">›</span>
    }
</nav>
