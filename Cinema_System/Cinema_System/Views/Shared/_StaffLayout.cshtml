@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var staffName = User.Identity?.Name ?? "Nhân viên";
    var parts = staffName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? (parts[parts.Length - 2].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper()
        : (parts.Length == 1 ? parts[0].Substring(0, 1).ToUpper() : "NV");

    const string navBase = "flex items-center gap-3 px-4 py-2.5 mx-3 my-0.5 rounded-lg text-sm font-medium transition-colors";
    const string navIdle = "text-gray-700 hover:bg-[#fff7f0] hover:text-primary";
    const string navActive = "bg-primary text-white";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineStar Staff</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&family=Be+Vietnam+Pro:wght@@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: {
                colors: { primary: '#f37021', 'primary-dark': '#c95a10', secondary: '#004b8d', 'secondary-dark': '#001c3a' },
                fontFamily: { head: ['"Plus Jakarta Sans"', 'sans-serif'], body: ['"Be Vietnam Pro"', 'sans-serif'] },
            } },
        };
    </script>
    <style>
        body { font-family: 'Be Vietnam Pro', sans-serif; }
        .material-symbols-outlined { font-size: 20px; line-height: 1; }
    </style>
    <partial name="_DarkMode" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-[#f4f6f8] text-[#191c1d]">

<!-- Sidebar (chỉ 2 chức năng quản lý phòng) -->
<aside class="fixed inset-y-0 left-0 flex w-60 flex-col border-r border-[#e8eaed] bg-white z-[100]">
    <a asp-controller="Home" asp-action="Index" title="Về trang chủ"
       class="group flex items-center justify-between gap-2 shrink-0 border-b border-[#f0f0f0] px-6 pt-5 pb-4 hover:bg-[#fff7f0] transition-colors">
        <div>
            <div class="font-head text-2xl font-extrabold tracking-tight text-primary leading-none">CineStar</div>
            <div class="mt-0.5 text-[.7rem] font-medium uppercase tracking-wide text-[#8a94a6]">Nhân viên</div>
        </div>
        <span class="material-symbols-outlined text-[#c0c6d0] group-hover:text-primary transition-colors">home</span>
    </a>

    <nav class="flex-1 overflow-y-auto py-3">
        <a class="@navBase @(ctrl == "StaffCounter" && action != "Member" ? navActive : navIdle)" asp-controller="StaffCounter" asp-action="Index">
            <span class="material-symbols-outlined">point_of_sale</span>
            <span>Đặt vé tại quầy</span>
        </a>
        <a class="@navBase @(ctrl == "StaffBooking" ? navActive : navIdle)" asp-controller="StaffBooking" asp-action="Index">
            <span class="material-symbols-outlined">receipt_long</span>
            <span>Đơn hàng</span>
        </a>
        <a class="@navBase @(ctrl == "StaffCheckin" ? navActive : navIdle)" asp-controller="StaffCheckin" asp-action="Index">
            <span class="material-symbols-outlined">qr_code_scanner</span>
            <span>Check-in vé</span>
        </a>
        <a class="@navBase @(ctrl == "StaffCounter" && action == "Member" ? navActive : navIdle)" asp-controller="StaffCounter" asp-action="Member">
            <span class="material-symbols-outlined">badge</span>
            <span>Tra cứu thành viên</span>
        </a>
    </nav>

    <!-- Người dùng + đăng xuất -->
    <div class="border-t border-[#f0f0f0] p-4">
        <div class="mb-3 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary font-bold text-white">@initials</div>
            <div class="min-w-0">
                <p class="truncate text-sm font-semibold">@staffName</p>
                <p class="text-xs text-gray-400">Nhân viên</p>
            </div>
        </div>
        <a asp-controller="Home" asp-action="Index" class="mb-1 flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-[#f4f6f8]">
            <span class="material-symbols-outlined">home</span> Về trang chủ
        </a>
        <form asp-controller="Login" asp-action="Logout" method="post">
            <button type="submit" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50">
                <span class="material-symbols-outlined">logout</span> Đăng xuất
            </button>
        </form>
    </div>
</aside>

<!-- Topbar -->
<header class="fixed top-0 left-60 right-0 z-[90] flex h-[60px] items-center justify-between border-b border-[#e8eaed] bg-white px-7">
    <span class="font-head text-[1.05rem] font-bold tracking-wide text-secondary-dark">@(ViewData["Title"] ?? "Quản lý")</span>
    <partial name="_DarkModeToggle" />
</header>

<div class="ml-60 min-h-screen pt-[60px]">
    <main class="p-7">
        @RenderBody()
    </main>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
