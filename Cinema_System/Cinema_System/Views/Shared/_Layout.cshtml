<!DOCTYPE html>
<html lang="vi" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> 
    <title>@ViewData["Title"] - CineStar</title>

    <!-- Google Fonts -->
    <link href="~/fonts/text.css" rel="stylesheet" asp-append-version="true" />
    <!-- Material Symbols -->
    <link href="~/fonts/icons.css" rel="stylesheet" asp-append-version="true" />

    <script src="~/lib/tailwind/tailwind.min.js" asp-append-version="true"></script>
    <script>
        tailwind.config = {
            important: true,
            theme: {
                extend: {
                    colors: {
                        primary: '#f37021',
                        'primary-dark': '#c95a10',
                        secondary: '#004b8d',
                        tertiary: '#001c3a',
                        light: '#f8f9fa',
                    },
                    // Bộ phông dùng chung toàn hệ thống — giữ GIỐNG NHAU ở mọi layout.
                    // sans: mặc định cho mọi thẻ (không cần gắn class vẫn đúng phông).
                    // head/heading: cùng trỏ phông tiêu đề để view dùng tên nào cũng chạy.
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'sans-serif'],
                        body: ['"Be Vietnam Pro"', 'sans-serif'],
                        head: ['"Plus Jakarta Sans"', 'sans-serif'],
                        heading: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <partial name="_DarkMode" />
    @await RenderSectionAsync("Styles", required: false)
    @* Bỏ dấu tiếng Việt phía client — nạp ở head vì nhiều view đặt script trong body. *@
    <script src="~/js/vietnamese-text.js" asp-append-version="true"></script>
</head>
<body class="bg-slate-50 text-slate-900 font-body antialiased">

    <!-- TopNavBar -->
    <header id="main-header" class="fixed top-0 w-full z-50 border-b border-slate-200 bg-white/95 backdrop-blur-xl shadow-sm">
        <div class="px-4 py-4 lg:px-8">
            <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
                <div class="flex items-center gap-5">
                    <a class="font-heading text-2xl font-black uppercase tracking-tight text-primary shrink-0" asp-area="" asp-controller="Home" asp-action="Index">CineStar</a>
                    <nav class="hidden items-center gap-5 lg:flex lg:flex-nowrap whitespace-nowrap">
                        <a class="text-sm font-semibold transition hover:text-primary @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-primary border-b-2 border-primary pb-1" : "text-slate-700")" asp-area="" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        <a class="text-sm font-semibold transition hover:text-primary @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movies" ? "text-primary border-b-2 border-primary pb-1" : "text-slate-700")" asp-area="" asp-controller="Movies" asp-action="Index">Phim</a>
                        <a class="text-sm font-semibold transition hover:text-primary @(ViewContext.RouteData.Values["controller"]?.ToString() == "Showtime" ? "text-primary border-b-2 border-primary pb-1" : "text-slate-700")" asp-area="" asp-controller="Showtime" asp-action="Index">Lịch Chiếu</a>
                        <a class="text-sm font-semibold transition hover:text-primary @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Info" ? "text-primary border-b-2 border-primary pb-1" : "text-slate-700")" asp-area="" asp-controller="Home" asp-action="Info">Thông tin rạp</a>
                    </nav>
                </div>
                <div class="flex shrink-0 items-center gap-3 whitespace-nowrap">
                    <form asp-controller="Movies" asp-action="Search" method="get" class="hidden relative xl:block">
                        <input type="hidden" name="tab" value="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Movies" ? (Context.Request.Query["tab"].ToString() ?? "now") : "now")" />
                        <input id="movie-search-input" type="text" name="find" maxlength="100" pattern="^[\p{L}\p{N}\s]+$" title="Từ khóa tìm kiếm tối đa 100 ký tự, không chứa ký tự đặc biệt." value="@(ViewData["SearchKeyword"] ?? string.Empty)" placeholder="Tìm kiếm phim" class="w-72 rounded-full border border-slate-200 bg-slate-100 py-2 pl-4 pr-11 text-sm text-slate-800 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
                        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-500" aria-label="Tìm kiếm">
                            <span class="material-symbols-outlined">search</span>
                        </button>
                        @* Gợi ý tên phim khi đang gõ — nội dung do JS dựng, xem cuối file. *@
                        <div id="movie-search-suggestions" role="listbox"
                             class="absolute left-0 right-0 top-full z-50 mt-2 hidden max-h-96 overflow-y-auto rounded-2xl border border-slate-200 bg-white py-1.5 shadow-xl dark:border-slate-700 dark:bg-slate-800"></div>
                    </form>
                    <partial name="_DarkModeToggle" />
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        // Tên + email + avatar đọc từ Claims (đặt khi đăng nhập) -> không truy vấn DB ở header.
                        var avatarUrl = User.FindFirst(Cinema_System.Controllers.Auth.AuthControllerBase.AvatarUrlClaimType)?.Value;
                        var displayName = User.Identity!.Name ?? "Tài khoản";
                        var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                        // 2 chữ cái đầu của tên làm avatar dự phòng khi chưa có ảnh (vd "Nguyễn Anh Linh" -> "AL")
                        var nameParts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        var initials = nameParts.Length >= 2
                            ? (nameParts[^2].Substring(0, 1) + nameParts[^1].Substring(0, 1)).ToUpper()
                            : nameParts.Length == 1 ? nameParts[0].Substring(0, 1).ToUpper() : "U";

                        <div class="relative" data-user-menu>
                            <button type="button" data-user-menu-toggle aria-haspopup="true" aria-expanded="false"
                                    class="flex items-center gap-2 rounded-full border border-slate-200 bg-white py-1 pl-1 pr-2 shadow-sm transition hover:border-primary/40 hover:shadow">
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img src="@avatarUrl" alt="Ảnh đại diện" class="h-9 w-9 rounded-full object-cover" />
                                }
                                else
                                {
                                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">@initials</span>
                                }
                                <span class="hidden max-w-[8rem] truncate text-sm font-semibold text-slate-700 sm:block">@displayName</span>
                                <span class="material-symbols-outlined text-[20px] text-slate-400">expand_more</span>
                            </button>

                            <!-- Dropdown: ẩn mặc định (class hidden), JS bật/tắt khi bấm avatar -->
                            <div data-user-menu-panel
                                 class="absolute right-0 mt-2 hidden w-60 overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-xl ring-1 ring-black/5">
                                <div class="flex items-center gap-3 border-b border-slate-100 px-4 py-3">
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="Ảnh đại diện" class="h-10 w-10 rounded-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">@initials</span>
                                    }
                                    <div class="min-w-0">
                                        <p class="truncate text-sm font-semibold text-slate-800">@displayName</p>
                                        @if (!string.IsNullOrEmpty(userEmail))
                                        {
                                            <p class="truncate text-xs text-slate-400">@userEmail</p>
                                        }
                                    </div>
                                </div>
                                <nav class="py-1 text-sm">
                                    @if (User.IsInRole("MANAGER"))
                                    {
                                        <a asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 border-b border-slate-100 px-4 py-2.5 font-semibold text-primary transition hover:bg-primary/5">
                                            <span class="material-symbols-outlined text-[20px]">dashboard</span> Khu quản lý
                                        </a>
                                    }
                                    @if (User.IsInRole("ADMIN"))
                                    {
                                        <a asp-controller="AdminDashboard" asp-action="Index" class="flex items-center gap-3 border-b border-slate-100 px-4 py-2.5 font-semibold text-primary transition hover:bg-primary/5">
                                            <span class="material-symbols-outlined text-[20px]">dashboard</span> Khu quản trị
                                        </a>
                                    }
                                    @if (User.IsInRole("STAFF"))
                                    {
                                        <a asp-controller="StaffCounter" asp-action="Index" class="flex items-center gap-3 border-b border-slate-100 px-4 py-2.5 font-semibold text-primary transition hover:bg-primary/5">
                                            <span class="material-symbols-outlined text-[20px]">dashboard</span> Khu quản lý
                                        </a>
                                    }
                                    <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 px-4 py-2.5 text-slate-700 transition hover:bg-slate-50 hover:text-primary">
                                        <span class="material-symbols-outlined text-[20px]">person</span> Hồ sơ cá nhân
                                    </a>
                                    <a asp-controller="Profile" asp-action="PointHistory" class="flex items-center gap-3 px-4 py-2.5 text-slate-700 transition hover:bg-slate-50 hover:text-primary">
                                        <span class="material-symbols-outlined text-[20px]">stars</span> Lịch sử điểm
                                    </a>
                                    <a asp-controller="Profile" asp-action="ChangePassword" class="flex items-center gap-3 px-4 py-2.5 text-slate-700 transition hover:bg-slate-50 hover:text-primary">
                                        <span class="material-symbols-outlined text-[20px]">lock</span> Đổi mật khẩu
                                    </a>
                                </nav>
                                <form asp-controller="Login" asp-action="Logout" method="post" class="border-t border-slate-100">
                                    <button type="submit" class="flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm font-semibold text-red-600 transition hover:bg-red-50">
                                        <span class="material-symbols-outlined text-[20px]">logout</span> Đăng xuất
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2">
                            <a asp-controller="Login" asp-action="Login" class="text-sm font-semibold text-primary transition hover:text-primary-dark">Đăng Nhập</a>
                            <a asp-controller="Register" asp-action="Register" class="rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-dark">Đăng Ký</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <main class="pt-24">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-slate-100 text-slate-700">
        <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 lg:grid-cols-[1.6fr_1fr_1fr] lg:px-8">
            <div class="space-y-5">
                <a class="inline-block font-heading text-2xl font-black uppercase tracking-tight text-primary" href="#">CineStar</a>
                <p>Hệ thống rạp chiếu phim hiện đại với công nghệ âm thanh hình ảnh hàng đầu Việt Nam.</p>
                <div class="flex items-center gap-2">
                    <a href="#" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-slate-700 shadow-sm transition hover:bg-primary hover:text-white"><span class="material-symbols-outlined">face_nod</span></a>
                    <a href="#" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-slate-700 shadow-sm transition hover:bg-primary hover:text-white"><span class="material-symbols-outlined">play_circle</span></a>
                    <a href="#" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-slate-700 shadow-sm transition hover:bg-primary hover:text-white"><span class="material-symbols-outlined">camera</span></a>
                </div>
            </div>
            <div>
                <h4 class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-slate-900">Về Chúng Tôi</h4>
                <ul class="space-y-3 text-sm text-slate-600">
                    <li><a class="transition hover:text-primary" asp-area="" asp-controller="Home" asp-action="Info">Giới thiệu CineStar</a></li>
                    <li><a class="transition hover:text-primary" href="#">Tuyển dụng</a></li>
                    <li><a class="transition hover:text-primary" href="#">Chính sách bảo mật</a></li>
                    <li><a class="transition hover:text-primary" href="#">Điều khoản sử dụng</a></li>
                </ul>
            </div>
            <div>
                <h4 class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-slate-900">Hỗ Trợ Khách Hàng</h4>
                <ul class="space-y-3 text-sm text-slate-600">
                    <li><a class="transition hover:text-primary" href="#">Quy định xem phim</a></li>
                    <li><a class="transition hover:text-primary" href="#">Liên hệ quảng cáo</a></li>
                    <li><a class="transition hover:text-primary" href="#">Giải quyết khiếu nại</a></li>
                </ul>
            </div>
        </div>
        <div class="border-t border-slate-200 bg-slate-100/80 px-4 py-5 text-sm text-slate-500 lg:px-8">
            <div class="mx-auto flex max-w-7xl flex-col gap-3 text-center lg:flex-row lg:items-center lg:justify-between">
                <p>© 2024 CineStar. Toàn bộ bản quyền được bảo lưu.</p>
                <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-slate-500 lg:justify-end">
                    <span>Công ty Cổ phần Giải trí CineStar</span>
                    <span class="text-slate-300">|</span>
                    <span>MST: 0123456789</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Popup "đặt vé nhanh" dùng chung (mở khi bấm nút có data-book-movie) -->
    <partial name="_BookingModal" />

    <script>
        // Dropdown tài khoản: mở/đóng khi bấm avatar, đóng khi bấm ra ngoài hoặc nhấn Esc.
        (function () {
            const menu = document.querySelector('[data-user-menu]');
            if (!menu) return;
            const toggle = menu.querySelector('[data-user-menu-toggle]');
            const panel = menu.querySelector('[data-user-menu-panel]');

            function closeMenu() {
                panel.classList.add('hidden');
                toggle.setAttribute('aria-expanded', 'false');
            }
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                const isHidden = panel.classList.toggle('hidden');
                toggle.setAttribute('aria-expanded', String(!isHidden));
            });
            document.addEventListener('click', function (e) {
                if (!menu.contains(e.target)) closeMenu();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeMenu();
            });
        })();

        (function () {
            const searchInput = document.getElementById('movie-search-input');
            if (!searchInput) return;

            searchInput.addEventListener('input', function () {
                let value = this.value;
                if (value.length > 30) {
                    value = value.slice(0, 30);
                }
                const cleaned = value.replace(/[^\p{L}\p{N}\s]+/gu, '');
                if (cleaned !== value) {
                    value = cleaned;
                }
                this.value = value;
            });

            // ── Gợi ý tên phim khi đang gõ ────────────────────────────────────
            const panel = document.getElementById('movie-search-suggestions');
            const form = searchInput.closest('form');
            if (!panel || !form) return;

            const DEBOUNCE_MS = 200;
            const STATUS_LABELS = {
                'Now Showing': 'Đang chiếu',
                'Coming Soon': 'Sắp chiếu',
                'Special': 'Chiếu sớm'
            };

            let debounceTimer = null;
            let inFlight = null;
            let options = [];
            let activeIndex = -1;
            let lastQuery = '';

            function closePanel() {
                panel.classList.add('hidden');
                panel.replaceChildren();
                options = [];
                activeIndex = -1;
            }

            function setActive(index) {
                if (activeIndex >= 0 && options[activeIndex]) {
                    options[activeIndex].classList.remove('bg-slate-100', 'dark:bg-slate-700');
                    options[activeIndex].setAttribute('aria-selected', 'false');
                }
                activeIndex = index;
                if (activeIndex >= 0 && options[activeIndex]) {
                    options[activeIndex].classList.add('bg-slate-100', 'dark:bg-slate-700');
                    options[activeIndex].setAttribute('aria-selected', 'true');
                    options[activeIndex].scrollIntoView({ block: 'nearest' });
                }
            }

            // Dựng phần tên phim, tô đậm đoạn trùng từ khóa. Dùng textContent nên an toàn với HTML.
            function buildTitle(title, key) {
                const holder = document.createElement('span');
                holder.className = 'block truncate text-sm font-semibold text-slate-800 dark:text-slate-100';

                // Bỏ dấu để tô đậm đúng đoạn khớp — server đã khớp không dấu rồi.
                const folded = VietnameseText.fold(title);
                const at = folded.aligned ? folded.key.indexOf(key) : -1;
                if (at < 0) {
                    holder.textContent = title;
                    return holder;
                }

                const before = folded.chars.slice(0, at).join('');
                const hit = folded.chars.slice(at, at + key.length).join('');
                const after = folded.chars.slice(at + key.length).join('');

                if (before) holder.appendChild(document.createTextNode(before));
                const mark = document.createElement('span');
                mark.className = 'text-primary';
                mark.textContent = hit;
                holder.appendChild(mark);
                if (after) holder.appendChild(document.createTextNode(after));
                return holder;
            }

            function buildRow(movie, key) {
                const row = document.createElement('a');
                row.href = '/Movies/Details/' + encodeURIComponent(movie.slug);
                row.setAttribute('role', 'option');
                row.setAttribute('aria-selected', 'false');
                row.className = 'flex items-center gap-3 px-3 py-2 transition hover:bg-slate-100 dark:hover:bg-slate-700';

                const poster = document.createElement('span');
                poster.className = 'block h-14 w-10 shrink-0 overflow-hidden rounded bg-slate-200 dark:bg-slate-700';
                if (movie.posterUrl) {
                    const img = document.createElement('img');
                    img.src = movie.posterUrl;
                    img.alt = '';
                    img.loading = 'lazy';
                    img.className = 'h-full w-full object-cover';
                    poster.appendChild(img);
                }
                row.appendChild(poster);

                const text = document.createElement('span');
                text.className = 'min-w-0 flex-1';
                text.appendChild(buildTitle(movie.title, key));

                const parts = [];
                if (movie.status && STATUS_LABELS[movie.status]) parts.push(STATUS_LABELS[movie.status]);
                if (movie.releaseYear) parts.push(String(movie.releaseYear));
                const meta = document.createElement('span');
                meta.className = 'block truncate text-xs text-slate-500 dark:text-slate-400';
                meta.textContent = parts.join(' • ');
                text.appendChild(meta);

                row.appendChild(text);
                return row;
            }

            function render(movies, key) {
                panel.replaceChildren();
                options = [];
                activeIndex = -1;

                if (!movies.length) {
                    const empty = document.createElement('p');
                    empty.className = 'px-4 py-3 text-sm text-slate-500 dark:text-slate-400';
                    empty.textContent = 'Không tìm thấy phim phù hợp.';
                    panel.appendChild(empty);
                    panel.classList.remove('hidden');
                    return;
                }

                movies.forEach(function (movie) {
                    const row = buildRow(movie, key);
                    options.push(row);
                    panel.appendChild(row);
                });

                // Dòng cuối: mở trang kết quả đầy đủ (submit chính form này).
                const seeAll = document.createElement('button');
                seeAll.type = 'submit';
                seeAll.className = 'mt-1 block w-full border-t border-slate-200 px-4 py-2.5 text-left text-sm font-semibold text-primary transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-700';
                seeAll.textContent = 'Xem tất cả kết quả cho "' + searchInput.value.trim() + '"';
                panel.appendChild(seeAll);

                panel.classList.remove('hidden');
            }

            function requestSuggestions(query) {
                if (inFlight) inFlight.abort();
                inFlight = new AbortController();

                fetch('/Movies/Suggest?find=' + encodeURIComponent(query), {
                    signal: inFlight.signal,
                    headers: { 'Accept': 'application/json' }
                })
                    .then(function (response) { return response.ok ? response.json() : []; })
                    .then(function (movies) {
                        // Người dùng đã gõ tiếp trong lúc chờ -> bỏ qua kết quả cũ.
                        if (query !== lastQuery || document.activeElement !== searchInput) return;
                        render(movies, VietnameseText.searchKey(query));
                    })
                    .catch(function () { /* huỷ request hoặc lỗi mạng -> giữ nguyên dropdown */ });
            }

            function scheduleSuggestions() {
                const query = searchInput.value.trim();
                lastQuery = query;
                clearTimeout(debounceTimer);

                if (query.length < 1) {
                    closePanel();
                    return;
                }
                debounceTimer = setTimeout(function () { requestSuggestions(query); }, DEBOUNCE_MS);
            }

            searchInput.addEventListener('input', scheduleSuggestions);
            searchInput.addEventListener('focus', function () {
                if (searchInput.value.trim().length >= 1 && !options.length) scheduleSuggestions();
            });

            searchInput.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') { closePanel(); return; }
                if (!options.length) return;

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActive(activeIndex + 1 >= options.length ? 0 : activeIndex + 1);
                } else if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActive(activeIndex - 1 < 0 ? options.length - 1 : activeIndex - 1);
                } else if (event.key === 'Enter' && activeIndex >= 0) {
                    // Đang chọn một gợi ý -> vào thẳng phim đó thay vì mở trang kết quả.
                    event.preventDefault();
                    window.location.href = options[activeIndex].href;
                }
            });

            document.addEventListener('click', function (event) {
                if (!form.contains(event.target)) closePanel();
            });
        })();
    </script>

    @* Modal xác nhận/thông báo dùng chung — thay cho confirm()/alert() của trình duyệt. *@
    <partial name="_ConfirmModal" />

    @* Chặn nhập chữ vào các ô chỉ nhận số (xem wwwroot/js/numeric-input.js). *@
    <script src="~/js/numeric-input.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
