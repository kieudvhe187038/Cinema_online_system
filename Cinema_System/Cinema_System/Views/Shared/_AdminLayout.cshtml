<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineStar Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: { extend: {
        colors: { primary: '#f37021', 'primary-dark': '#c95a10', secondary: '#004b8d', 'secondary-dark': '#001c3a' },
        // Bộ phông dùng chung toàn hệ thống — giữ GIỐNG NHAU ở mọi layout.
        fontFamily: {
        sans: ['"Be Vietnam Pro"', 'sans-serif'],
        body: ['"Be Vietnam Pro"', 'sans-serif'],
        head: ['"Plus Jakarta Sans"', 'sans-serif'],
        heading: ['"Plus Jakarta Sans"', 'sans-serif']
        }
        } }
        };
    </script>
    <style>
        body {
        font-family: 'Be Vietnam Pro', sans-serif;
        }

        .material-symbols-outlined {
        font-size: 20px;
        line-height: 1;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-[#f4f6f8] overflow-x-hidden text-[#191c1d]">
    @{
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        const string navBase = "flex items-center gap-3 px-4 py-2.5 mx-3 my-0.5 rounded-lg text-sm font-medium transition-colors";
        const string navIdle = "text-gray-700 hover:bg-[#fff7f0] hover:text-primary";
        const string navActive = "bg-primary text-white";
    }

    <aside class="fixed inset-y-0 left-0 w-60 bg-white border-r border-[#e8eaed] flex flex-col z-[100]">
        <a asp-controller="Home" asp-action="Index" title="Về trang chủ"
           class="group flex items-center justify-between gap-2 px-6 pt-5 pb-4 border-b border-[#f0f0f0] shrink-0 hover:bg-[#fff7f0] transition-colors">
            <div>
                <div class="font-head text-2xl font-extrabold text-primary tracking-tight leading-none">CineStar</div>
                <div class="text-[.7rem] text-[#8a94a6] mt-0.5 font-medium uppercase tracking-wide">Quản Trị Hệ Thống</div>
            </div>
            <span class="material-symbols-outlined text-[#c0c6d0] group-hover:text-primary transition-colors">home</span>
        </a>
        <nav class="flex-1 py-3 overflow-y-auto">
            <a class="@navBase @(ctrl == "AdminDashboard" ? navActive : navIdle)" asp-controller="AdminDashboard" asp-action="Index">
                <span class="material-symbols-outlined">dashboard</span><span>Dashboard</span>
            </a>
            <a class="@navBase @(ctrl == "AdminUser" ? navActive : navIdle)" asp-controller="AdminUser" asp-action="Index">
                <span class="material-symbols-outlined">group</span><span>Người Dùng</span>
            </a>
            <a class="@navBase @(ctrl == "AuditLog" ? navActive : navIdle)" asp-controller="AuditLog" asp-action="Index">
                <span class="material-symbols-outlined">history</span><span>Nhật Ký Chỉnh Sửa</span>
            </a>
            <hr class="my-2 mx-6 border-t border-[#f0f0f0]" />
            <a class="@navBase @navIdle" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined">home</span><span>Về Trang Chủ</span>
            </a>
        </nav>
    </aside>

    <header class="fixed top-0 left-60 right-0 h-[60px] bg-white border-b border-[#e8eaed] flex items-center px-7 z-[90]">
        <span class="font-head text-[1.05rem] font-bold text-secondary-dark tracking-wide">@(ViewData["Title"] ?? "Quản Trị")</span>
    </header>

    <div class="ml-60 pt-[60px] min-h-screen">
        <main class="p-7">@RenderBody()</main>
    </div>

    @* Modal xác nhận/thông báo dùng chung — thay cho confirm()/alert() của trình duyệt. *@
    <partial name="_ConfirmModal" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
