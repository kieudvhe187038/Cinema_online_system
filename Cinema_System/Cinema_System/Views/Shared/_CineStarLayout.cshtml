@{
    // Layout riêng cho khu vực tài khoản (CineStar). Trang nào muốn dùng thì đặt: Layout = "_CineStarLayout".
    // Thông tin người dùng cho sidebar/topbar được trang con truyền vào qua ViewData.
    var userName = ViewData["UserName"] as string ?? "";
    var userRole = ViewData["UserRole"] as string ?? "";
    var userAvatar = ViewData["UserAvatar"] as string; // ảnh avatar đã upload (null/rỗng = chưa có)
    var heading = ViewData["Heading"] as string ?? "Cài đặt tài khoản";

    // Lấy 2 chữ cái cuối của tên cho avatar (vd "Nguyễn Anh Linh" -> "AL")
    var nameParts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    string initials;
    if (nameParts.Length >= 2)
        initials = (nameParts[nameParts.Length - 2].Substring(0, 1) + nameParts[nameParts.Length - 1].Substring(0, 1)).ToUpper();
    else if (nameParts.Length == 1)
        initials = nameParts[0].Substring(0, 1).ToUpper();
    else
        initials = "U";

    // Xác định mục menu đang mở để tô màu (active) đúng trang
    var curController = ViewContext.RouteData.Values["controller"]?.ToString();
    var curAction = ViewContext.RouteData.Values["action"]?.ToString();
    // Trả về class cho 1 mục menu: active = nền cam; thường = chữ xám + hover
    string NavClass(string controller, string action)
        => (curController == controller && curAction == action)
            ? "flex items-center gap-3 rounded-lg bg-primary px-3 py-2.5 font-semibold text-white"
            : "flex items-center gap-3 rounded-lg px-3 py-2.5 text-gray-600 hover:bg-light";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&family=Be+Vietnam+Pro:wght@@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Material Symbols (icon cho nút đổi giao diện + các icon khác) -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet">
    <!-- Khai báo màu brand + font. KHÔNG cần important:true vì layout này không nạp Bootstrap. -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#F37021',
                        'primary-dark': '#d85f15',
                        secondary: '#00488D',
                        tertiary: '#002F59',
                        light: '#F8F9FA',
                    },
                    // Bộ phông dùng chung toàn hệ thống — giữ GIỐNG NHAU ở mọi layout.
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'sans-serif'],
                        body: ['"Be Vietnam Pro"', 'sans-serif'],
                        head: ['"Plus Jakarta Sans"', 'sans-serif'],
                        heading: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <partial name="_DarkMode" />
    @* Bỏ dấu tiếng Việt phía client — nạp ở head vì nhiều view đặt script trong body. *@
    <script src="~/js/vietnamese-text.js" asp-append-version="true"></script>
</head>
<body class="bg-light font-body text-tertiary">
<!-- Bố cục = 2 phần đặt cạnh nhau (flex): SIDEBAR trái + KHU NỘI DUNG phải -->
<div class="flex min-h-screen">

    <!-- ===== SIDEBAR ===== (hidden md:block = ẩn trên màn nhỏ, hiện từ tablet trở lên) -->
    <aside class="hidden w-64 shrink-0 flex-col border-r border-gray-200 bg-white p-5 md:flex">
        <a asp-controller="Home" asp-action="Index" class="mb-8 block text-xl font-extrabold font-heading text-primary">
            CineStar
        </a>

        <!-- Thẻ người dùng: có ảnh thì hiện ảnh, chưa có thì hiện chữ viết tắt -->
        <div class="mb-8 flex items-center gap-3">
            @if (!string.IsNullOrEmpty(userAvatar))
            {
                <img src="@userAvatar" alt="avatar" class="h-11 w-11 rounded-full object-cover" />
            }
            else
            {
                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary font-bold text-white">@initials</div>
            }
            <div>
                <p class="font-semibold leading-tight">@userName</p>
                <p class="text-xs font-semibold uppercase tracking-wide text-primary">@userRole</p>
            </div>
        </div>

        <!-- Menu (icon line SVG, active đổi màu theo trang) -->
        <nav class="space-y-1 text-sm font-medium">
            <a asp-controller="Profile" asp-action="Index" class="@NavClass("Profile", "Index")">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                Hồ sơ cá nhân
            </a>
            <a asp-controller="Profile" asp-action="PointHistory" class="@NavClass("Profile", "PointHistory")">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
                Lịch sử điểm
            </a>
            <a asp-controller="Booking" asp-action="History" class="@NavClass("Booking", "History")">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>
                Lịch sử đặt vé
            </a>
            <a asp-controller="Profile" asp-action="ChangePassword" class="@NavClass("Profile", "ChangePassword")">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
                Đổi mật khẩu
            </a>
        </nav>

        <!-- Nút đặt vé nổi bật -->
        <a asp-controller="Home" asp-action="Index"
           class="mt-6 flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-3 font-semibold text-white shadow hover:bg-primary-dark transition">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>
            Đặt vé ngay
        </a>

        <!-- Đăng xuất: POST tới LoginController.Logout -->
        <form asp-controller="Login" asp-action="Logout" method="post" class="mt-auto border-t border-gray-100 pt-4">
            <button type="submit" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 hover:bg-light">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
                Đăng xuất
            </button>
        </form>
    </aside>

    <!-- ===== KHU NỘI DUNG ===== -->
    <div class="flex-1">

        <!-- Thanh trên (chỉ tiêu đề; user đã hiển thị ở sidebar trái) -->
        <header class="flex items-center justify-between border-b border-gray-200 bg-white px-6 py-4">
            <h1 class="text-xl font-bold font-heading text-tertiary">@heading</h1>
            <partial name="_DarkModeToggle" />
        </header>

        <!-- Nội dung của trang con sẽ đổ vào đây -->
        <main class="p-6">
            @RenderBody()
        </main>
    </div>
</div>
@* Modal xác nhận/thông báo dùng chung — thay cho confirm()/alert() của trình duyệt. *@
<partial name="_ConfirmModal" />
@* Chặn nhập chữ vào các ô chỉ nhận số (xem wwwroot/js/numeric-input.js). *@
<script src="~/js/numeric-input.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
