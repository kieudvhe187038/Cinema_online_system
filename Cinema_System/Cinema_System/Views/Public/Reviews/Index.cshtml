@using Cinema_System.Application.Common
@model PagedResult<ReviewDTO>

@{
    var movieIdObj = ViewData["MovieId"];
    Guid? movieId = movieIdObj is Guid g ? g : null;
    var movieTitle = ViewData["MovieTitle"] as string ?? "Đánh giá";
    var reviewCount = Model.TotalCount;
    var pageSubtitle = movieId.HasValue ? "Đánh giá cho phim này" : "Đánh giá từ khán giả trên CineStar";
    ViewData["Title"] = movieId.HasValue ? $"Đánh giá - {movieTitle}" : movieTitle;
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-slate-100 px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
        <div class="overflow-hidden rounded-[2.5rem] bg-white p-8 shadow-[0_40px_120px_-40px_rgba(15,23,42,0.35)]">
            <div class="grid gap-6 lg:grid-cols-[1.3fr_auto] lg:items-end">
                <div>
                    <p class="text-sm uppercase tracking-[0.24em] font-semibold text-primary">Đánh giá phim</p>
                    <h1 class="mt-4 text-5xl font-heading font-black bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">@movieTitle</h1>
                    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">@pageSubtitle @if (reviewCount > 0) { <span class="font-semibold text-slate-900">- @reviewCount đánh giá</span> }</p>
                </div>
                <div class="flex flex-wrap items-center justify-end gap-3">
                    @if (movieId.HasValue)
                    {
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movieId" class="inline-flex items-center rounded-full border-2 border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary">Xem phim</a>
                    }
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a href="@Url.Action("Create", "Reviews", new { movieId = movieId })" class="inline-flex items-center rounded-full bg-gradient-to-r from-primary to-primary-dark px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:shadow-lg hover:shadow-primary/40 transform hover:scale-105">Viết đánh giá</a>
                    }
                </div>
            </div>

            <div class="mt-12 space-y-6">
                @if (Model.Items.Any())
                {
                    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                        @foreach (var review in Model.Items)
                        {
                            <div class="group relative overflow-hidden rounded-[1.75rem] border border-slate-200/60 bg-gradient-to-br from-white to-slate-50/50 p-6 shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_25px_50px_-25px_rgba(15,23,42,0.35)]">
                                <div class="absolute inset-0 bg-gradient-to-r from-primary/0 via-primary/5 to-primary/0 opacity-0 transition group-hover:opacity-100"></div>
                                <div class="relative z-10 flex items-start justify-between gap-4">
                                    <div>
                                        <h2 class="text-lg font-bold text-slate-900">@review.UserName</h2>
                                        <p class="mt-1 text-sm text-slate-500">@review.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>
                                    <div class="flex items-center gap-0.5 text-yellow-400">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="text-xl @(i <= review.Rating ? "text-yellow-400 drop-shadow-md" : "text-slate-300")">★</span>
                                        }
                                    </div>
                                </div>
                                <p class="relative z-10 mt-5 min-h-[5rem] leading-relaxed text-slate-700">@(!string.IsNullOrEmpty(review.Comment) ? review.Comment : "<em>Người dùng chưa để lại nhận xét.</em>")</p>
                                <div class="relative z-10 mt-6 flex items-center justify-between gap-3 border-t border-slate-100 pt-4">
                                    <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">@review.UserName</span>
                                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@(review.MovieSlug ?? review.MovieId.ToString())" class="text-sm font-semibold text-primary transition hover:underline">Xem phim →</a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-[1.75rem] border-2 border-dashed border-slate-300 bg-gradient-to-br from-slate-50 to-blue-50 p-12 text-center">
                        <p class="text-2xl font-bold text-slate-900">Chưa có đánh giá nào.</p>
                        <p class="mt-3 text-base text-slate-600">Hãy là người đầu tiên chia sẻ cảm nhận ngay khi đã xem phim.</p>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="mt-12 flex flex-wrap items-center justify-center gap-2">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", "Reviews", new { movieId, page = Model.CurrentPage - 1 })" class="inline-flex items-center rounded-full border-2 border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary">← Trang trước</a>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        @if (i == Model.CurrentPage)
                        {
                            <span class="inline-flex items-center rounded-full bg-gradient-to-r from-primary to-primary-dark px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25">@i</span>
                        }
                        else if (i <= Model.CurrentPage + 2 && i >= Model.CurrentPage - 2)
                        {
                            <a href="@Url.Action("Index", "Reviews", new { movieId, page = i })" class="inline-flex items-center rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary">@i</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", "Reviews", new { movieId, page = Model.CurrentPage + 1 })" class="inline-flex items-center rounded-full border-2 border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary">Trang sau →</a>
                    }
                </div>
            }
        </div>
    </div>
</div>
