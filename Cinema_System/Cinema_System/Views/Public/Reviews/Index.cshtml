@using Cinema_System.Application.Common
@model PagedResult<ReviewDTO>

@{
    var movieIdObj = ViewData["MovieId"];
    Guid? movieId = movieIdObj is Guid g ? g : null;
    var movieTitle = ViewData["MovieTitle"] as string ?? "Đánh giá";
    var reviewCount = Model.TotalCount;
    var pageSubtitle = movieId.HasValue ? "Đánh giá cho phim này" : "Đánh giá từ khán giả trên CineStar";
    ViewData["Title"] = movieId.HasValue ? $"Đánh giá - {movieTitle}" : movieTitle;
}

<div class="min-h-screen bg-slate-50 px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
        <div class="rounded-[2rem] bg-white p-8 shadow-[0_30px_80px_-30px_rgba(15,23,42,0.25)]">
            <div class="grid gap-6 lg:grid-cols-[1.3fr_auto] lg:items-end">
                <div>
                    <p class="text-sm uppercase tracking-[0.24em] text-primary">Đánh giá phim</p>
                    <h1 class="mt-3 text-4xl font-heading font-black text-slate-900">@movieTitle</h1>
                    <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">@pageSubtitle @if (reviewCount > 0) { <span class="font-semibold text-slate-900">- @reviewCount đánh giá</span> }</p>
                </div>
                <div class="flex flex-wrap items-center justify-end gap-3">
                    @if (movieId.HasValue)
                    {
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movieId" class="inline-flex items-center rounded-full border border-slate-300 bg-slate-50 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-primary hover:text-primary">Xem phim</a>
                    }
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a href="@Url.Action("Create", "Reviews", new { movieId = movieId })" class="inline-flex items-center rounded-full bg-primary px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/15 transition hover:bg-primary-dark">Viết đánh giá</a>
                    }
                    else
                    {
                        <a asp-controller="Login" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Reviews", new { movieId })" class="inline-flex items-center rounded-full border border-primary bg-white px-5 py-3 text-sm font-semibold text-primary transition hover:bg-primary/5">Đăng nhập</a>
                    }
                </div>
            </div>

            <div class="mt-10 space-y-6">
                @if (Model.Items.Any())
                {
                    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                        @foreach (var review in Model.Items)
                        {
                            <div class="group overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-[0_25px_40px_-25px_rgba(15,23,42,0.25)]">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <h2 class="text-lg font-semibold text-slate-900">@review.UserName</h2>
                                        <p class="mt-1 text-sm text-slate-500">@review.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>
                                    <div class="flex items-center gap-1 text-yellow-400">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="text-lg @(i <= review.Rating ? "text-yellow-400" : "text-slate-300")">★</span>
                                        }
                                    </div>
                                </div>
                                <p class="mt-5 min-h-[5rem] text-slate-700">@(!string.IsNullOrEmpty(review.Comment) ? review.Comment : "Người dùng chưa để lại nhận xét.")</p>
                                <div class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-500">
                                    <span class="rounded-full bg-white px-3 py-1 text-slate-700">@review.UserName</span>
                                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@(review.MovieSlug ?? review.MovieId.ToString())" class="font-semibold text-primary transition group-hover:underline">Xem phim</a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-[1.75rem] border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-600">
                        <p class="text-xl font-semibold text-slate-900">Chưa có đánh giá nào.</p>
                        <p class="mt-3">Hãy là người đầu tiên chia sẻ cảm nhận ngay khi đã xem phim.</p>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", "Reviews", new { movieId, page = Model.CurrentPage - 1 })" class="inline-flex items-center rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Trang trước</a>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        @if (i == Model.CurrentPage)
                        {
                            <span class="inline-flex items-center rounded-full bg-primary px-4 py-2 text-sm font-medium text-white">@i</span>
                        }
                        else if (i <= Model.CurrentPage + 2 && i >= Model.CurrentPage - 2)
                        {
                            <a href="@Url.Action("Index", "Reviews", new { movieId, page = i })" class="inline-flex items-center rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">@i</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", "Reviews", new { movieId, page = Model.CurrentPage + 1 })" class="inline-flex items-center rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Trang sau</a>
                    }
                </div>
            }
        </div>
    </div>
</div>
