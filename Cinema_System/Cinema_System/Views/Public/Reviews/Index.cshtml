@using Cinema_System.Application.Common
@model PagedResult<ReviewDTO>

@{
    var movieIdObj = ViewData["MovieId"];
    Guid? movieId = movieIdObj is Guid g ? g : null;
    var movieTitle = ViewData["MovieTitle"] as string ?? "Đánh giá";
    var reviewCount = Model.TotalCount;
    var pageSubtitle = movieId.HasValue ? "Đánh giá cho phim này" : "Đánh giá từ khán giả trên CineStar";
    ViewData["Title"] = movieId.HasValue ? $"Đánh giá - {movieTitle}" : movieTitle;
}

<div class="min-h-screen bg-gradient-to-br from-slate-100 via-slate-50 to-blue-50 px-4 pt-28 pb-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl space-y-10">

        <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white/95 p-8 shadow-[0_30px_90px_-40px_rgba(15,23,42,0.25)] backdrop-blur-sm">
            <div class="grid gap-8 lg:grid-cols-[1.5fr_auto] lg:items-center">
                <div>
                    <span class="inline-flex items-center rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold uppercase tracking-[0.3em] text-primary">Đánh giá phim</span>
                    <h1 class="mt-5 max-w-3xl text-5xl font-heading font-black tracking-tight text-slate-900">@movieTitle</h1>
                    <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600">@pageSubtitle @if (reviewCount > 0) { <span class="font-semibold text-slate-900">- @reviewCount đánh giá</span> }</p>
                    <div class="mt-6 flex flex-wrap items-center gap-3">
                        <span class="inline-flex items-center gap-2 rounded-2xl bg-slate-100 px-4 py-2 text-sm text-slate-700 shadow-sm">
                            <span class="material-symbols-outlined text-[18px] text-primary">reviews</span>
                            Tổng số đánh giá: <strong>@reviewCount</strong>
                        </span>
                        @if (movieId.HasValue)
                        {
                            <span class="inline-flex items-center gap-2 rounded-2xl bg-slate-100 px-4 py-2 text-sm text-slate-700 shadow-sm">
                                <span class="material-symbols-outlined text-[18px] text-primary">local_movies</span>
                                Phim hiện tại: <strong>@movieTitle</strong>
                            </span>
                        }
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-end gap-3">
                    @if (movieId.HasValue)
                    {
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movieId" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary">
                            <span class="material-symbols-outlined">arrow_back_ios</span>
                            Xem phim
                        </a>
                    }
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a href="@Url.Action("Create", "Reviews", new { movieId = movieId })" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-primary to-primary-dark px-6 py-3 text-sm font-semibold text-white shadow-xl shadow-primary/20 transition hover:shadow-2xl hover:scale-[1.02]">
                            <span class="material-symbols-outlined">edit</span>
                            Viết đánh giá
                        </a>
                    }
                </div>
            </div>
        </section>

        <section class="">
            <div class="space-y-6 max-w-6xl mx-auto">
                @if (Model.Items.Any())
                {
                    <div class="grid gap-6 md:grid-cols-2">
                        @foreach (var review in Model.Items)
                        {
                            <article class="group rounded-[2rem] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-42px_rgba(15,23,42,0.2)] transition hover:-translate-y-1 hover:shadow-[0_25px_80px_-40px_rgba(15,23,42,0.25)]">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <p class="text-sm uppercase tracking-[0.25em] text-primary">Đánh giá</p>
                                        <h3 class="mt-3 text-xl font-semibold text-slate-900">@review.UserName</h3>
                                        <p class="mt-2 text-sm text-slate-500">@review.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>
                                    <div class="inline-flex items-center gap-1 rounded-full bg-yellow-100 px-3 py-2 text-sm font-semibold text-yellow-900">
                                        <span class="material-symbols-outlined">star</span>
                                        @review.Rating
                                    </div> 
                                </div>

                                <div class="mt-5 rounded-[1.5rem] bg-slate-50 p-4 text-slate-700 leading-7">
                                    <p>@(!string.IsNullOrEmpty(review.Comment) ? review.Comment : "Người dùng chưa để lại nhận xét.")</p>
                                </div>

                                <div class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-500">
                                    <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-2 text-slate-700">
                                        <span class="material-symbols-outlined text-[18px]">person</span>
                                        @review.UserName
                                    </span>
                                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@(review.MovieSlug ?? review.MovieId.ToString())" class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-2 font-semibold text-primary transition hover:bg-primary/10">
                                        <span class="material-symbols-outlined">movie</span>
                                        @review.MovieTitle
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-[2rem] border border-dashed border-slate-300 bg-gradient-to-br from-slate-50 to-slate-100 p-12 text-center shadow-sm">
                        <p class="text-2xl font-semibold text-slate-900">Chưa có đánh giá nào.</p>
                        <p class="mt-3 text-base text-slate-600">Hãy là người đầu tiên chia sẻ cảm nhận của bạn về bộ phim này.</p>
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <div class="flex flex-wrap items-center justify-center gap-3 rounded-full bg-white/80 px-4 py-3 shadow-[0_20px_60px_-42px_rgba(15,23,42,0.10)]">
                        @if (Model.CurrentPage > 1)
                        {
                            <a href="@Url.Action("Index", "Reviews", new { movieId, page = Model.CurrentPage - 1 })" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-primary/5 hover:text-primary">
                                <span class="material-symbols-outlined">chevron_left</span>
                                Trước
                            </a>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <span class="inline-flex h-10 min-w-[42px] items-center justify-center rounded-full bg-primary text-sm font-semibold text-white">@i</span>
                            }
                            else if (i <= Model.CurrentPage + 2 && i >= Model.CurrentPage - 2)
                            {
                                <a href="@Url.Action("Index", "Reviews", new { movieId, page = i })" class="inline-flex h-10 min-w-[42px] items-center justify-center rounded-full border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-primary/5 hover:text-primary">@i</a>
                            }
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a href="@Url.Action("Index", "Reviews", new { movieId, page = Model.CurrentPage + 1 })" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-primary/5 hover:text-primary">
                                Sau
                                <span class="material-symbols-outlined">chevron_right</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>
