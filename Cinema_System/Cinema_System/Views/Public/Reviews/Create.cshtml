@model CreateReviewDTO

@{
    ViewData["Title"] = "Đánh giá phim";
    var movieId = Model.MovieId != Guid.Empty ? Model.MovieId : (ViewData["MovieId"] as Guid? ?? Guid.Empty);
    var movieTitle = ViewData["MovieTitle"] as string ?? "Phim";
    var movieSlug = ViewData["MovieSlug"] as string;
}

<div class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">
        <!-- Form -->
        <div class="rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
            <form method="post" asp-action="Create" asp-controller="Reviews" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MovieId" value="@movieId" />

                @if (TempData["Error"] != null)
                {
                    <div class="mb-6 rounded-3xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700">
                        @TempData["Error"]
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="mb-6 rounded-3xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-700">
                        @TempData["Success"]
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600"></div>

                <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
                    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                        <div>
                            <p class="text-sm uppercase tracking-[0.25em] text-primary">Đánh giá phim</p>
                            <h2 class="mt-2 text-2xl font-bold text-slate-900">@movieTitle</h2>
                        </div>
                        <a href="@Url.Action("Details", "Movies", new { id = movieSlug ?? movieId.ToString() })" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary">
                            <span class="material-symbols-outlined">arrow_back_ios</span>
                            Quay lại
                        </a>
                    </div>
                </div>

                <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-semibold text-slate-900">Đánh giá của bạn <span class="text-red-500">*</span></label>
                            <div class="mt-4 flex items-center gap-3">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <label class="relative cursor-pointer">
                                        <input type="radio" asp-for="Rating" name="Rating" value="@i" class="peer sr-only" />
                                        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-slate-100 text-2xl text-slate-400 transition peer-checked:border-primary peer-checked:bg-primary peer-checked:text-white">
                                            ★
                                        </span>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="Rating" class="mt-2 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="Comment" class="block text-sm font-semibold text-slate-900">Bình luận <span class="text-slate-500">(Tùy chọn)</span></label>
                            <textarea id="comment" asp-for="Comment" maxlength="100" rows="5" placeholder="Chia sẻ trải nghiệm xem phim của bạn..." class="mt-3 w-full rounded-3xl border border-slate-200 bg-slate-50 px-4 py-4 text-slate-900 placeholder-slate-400 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10"></textarea>
                            <div class="mt-2 flex items-center justify-between text-sm text-slate-500">
                                <span>Bạn có thể nhập tối đa 100 ký tự.</span>
                                <span id="char-count">@((Model?.Comment?.Length ?? 0))/100 ký tự</span>
                            </div>
                            <span asp-validation-for="Comment" class="mt-2 block text-sm text-red-600"></span>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">
                            <button type="submit" class="inline-flex justify-center rounded-3xl bg-primary px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/20 transition hover:bg-primary-dark">
                                Gửi đánh giá
                            </button>
                            <a href="@Url.Action("Details", "Movies", new { id = movieSlug ?? movieId.ToString() })" class="inline-flex justify-center rounded-3xl border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-primary hover:text-primary">
                                Hủy
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
                const commentField = document.getElementById('comment');
                const charCount = document.getElementById('char-count');
                if (commentField && charCount) {
                    const updateCount = () => {
                        const value = commentField.value || '';
                        charCount.textContent = `${value.length}/100 ký tự`;
                    };
                    commentField.addEventListener('input', updateCount);
                    updateCount();
                }

                const form = document.querySelector('form');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        const rating = document.querySelector('input[name="Rating"]:checked');
                        if (!rating) {
                            e.preventDefault();
                            alert('Vui lòng chọn số sao để đánh giá phim.');
                        }
                    });
                }
            </script>
