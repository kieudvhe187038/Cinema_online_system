@model CreateReviewDTO

@{
    ViewData["Title"] = "Đánh giá phim";
    var movieId = ViewData["MovieId"] as Guid? ?? Guid.Empty;
    var movieTitle = ViewData["MovieTitle"] as string ?? "Phim";
    var movieSlug = ViewData["MovieSlug"] as string;
}

<div class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">
        <!-- Header -->
        <div class="mb-8">
            <a href="@Url.Action("Details", "Movies", new { id = movieSlug ?? movieId.ToString() })" 
               class="mb-4 inline-flex items-center text-slate-600 hover:text-slate-900">
                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Quay lại
            </a>
            <h1 class="mb-2 text-3xl font-bold text-slate-900">Đánh giá phim</h1> 
            <p class="text-slate-600">@movieTitle</p>
        </div>

        <!-- Form -->
        <div class="rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
            <form method="post" asp-action="Create" asp-controller="Reviews">
                <input type="hidden" asp-for="MovieId" value="@movieId" />

                <!-- Rating Selection -->
                <div class="mb-8">
                    <fieldset>
                        <legend class="block text-sm font-semibold text-slate-900">
                            Đánh giá của bạn <span class="text-red-500">*</span>
                        </legend>
                        <div class="mt-4 flex space-x-4">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <label class="flex cursor-pointer items-center">
                                    <input type="radio" name="rating" value="@i" asp-for="Rating" 
                                           class="peer sr-only" required />
                                    <svg class="h-8 w-8 text-slate-300 hover:text-yellow-400 peer-checked:text-yellow-400 transition-colors" 
                                         fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                    </svg>
                                </label>
                            }
                        </div>
                    </fieldset>
                    @{ var ratingState = ViewData.ModelState["Rating"]; }
                    @if (ratingState?.Errors.Any() ?? false)
                    {
                        <p class="mt-2 text-sm text-red-600">@ratingState.Errors.FirstOrDefault()?.ErrorMessage</p>
                    }
                </div>

                <!-- Comment -->
                <div class="mb-8">
                    <label for="comment" class="block text-sm font-semibold text-slate-900">
                        Bình luận <span class="text-slate-500">(Tùy chọn)</span>
                    </label>
                    <textarea id="comment" asp-for="Comment" maxlength="500" rows="5"
                              placeholder="Chia sẻ trải nghiệm xem phim của bạn..."
                              class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 placeholder-slate-500 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20">
                    </textarea>
                    <p class="mt-2 text-sm text-slate-500">
                        <span id="char-count">0</span>/500 ký tự
                    </p>
                </div>

                <!-- Buttons -->
                <div class="flex space-x-4">
                    <button type="submit" class="flex-1 rounded-lg bg-orange-500 px-6 py-3 font-semibold text-white hover:bg-orange-600 transition-colors">
                        Gửi đánh giá
                    </button>
                    <a href="@Url.Action("Details", "Movies", new { id = movieSlug ?? movieId.ToString() })"
                       class="flex-1 rounded-lg border border-slate-300 px-6 py-3 text-center font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Character counter
    const commentField = document.getElementById('comment');
    const charCount = document.getElementById('char-count');

    if (commentField && charCount) {
        commentField.addEventListener('input', function() {
            charCount.textContent = this.value.length;
        });
    }

    // Rating validation
    const form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const rating = document.querySelector('input[name="rating"]:checked');
            if (!rating) {
                e.preventDefault();
                alert('Vui lòng chọn số sao để đánh giá phim.');
            }
        });
    }
</script>
