@* Trang Lịch Chiếu công khai: chọn ngày + lọc theo phim/thể loại/độ tuổi/loại phòng, suất chiếu nhóm theo phim. *@
@model Cinema_System.Application.ViewModels.ShowtimePageViewModel
@{
    ViewData["Title"] = "Lịch Chiếu";

    // Tạo URL giữ nguyên bộ lọc khi đổi ngày trên thanh ngày.
    string DateUrl(DateOnly d) => Url.Action("Index", "Showtime",
        new { movieId = Model.MovieId, genreId = Model.GenreId, ageRating = Model.AgeRating, roomTypeId = Model.RoomTypeId, date = d.ToString("yyyy-MM-dd") })!;

    // Nhãn thứ trong tuần cho thanh chọn ngày.
    string[] weekdays = { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
    string Weekday(DateOnly d) => weekdays[(int)d.DayOfWeek];

    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="mx-auto max-w-7xl space-y-8 px-4 py-10 sm:px-6 lg:px-8">

    @if (TempData["Error"] is string errorMsg && !string.IsNullOrEmpty(errorMsg))
    {
        <div class="flex items-start gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
            <span class="material-symbols-outlined text-[20px]">error</span>
            <span>@errorMsg</span>
        </div>
    }

    <div>
        <h1 class="font-heading text-3xl font-black uppercase tracking-tight text-tertiary">Lịch Chiếu Phim</h1>
        <p class="mt-1 text-sm text-slate-500">Xem suất chiếu theo phim, thể loại, độ tuổi và loại phòng.</p>
    </div>

    <!-- Thanh chọn ngày -->
    <div class="flex gap-2 overflow-x-auto pb-2">
        @foreach (var d in Model.AvailableDates)
        {
            var isSel = d == Model.SelectedDate;
            <a href="@DateUrl(d)"
               class="flex min-w-[64px] flex-col items-center rounded-xl border px-3 py-2 transition @(isSel ? "border-primary bg-primary text-white shadow" : "border-slate-200 bg-white text-slate-700 hover:border-primary/50")">
                <span class="text-xs font-semibold">@(d == today ? "Hôm nay" : Weekday(d))</span>
                <span class="text-lg font-bold leading-tight">@d.Day</span>
                <span class="text-[.7rem] opacity-80">Th@(d.Month)</span>
            </a>
        }
    </div>

    <!-- Bộ lọc phim / thể loại / độ tuổi / loại phòng -->
    <form method="get" action="@Url.Action("Index", "Showtime")"
          class="grid grid-cols-1 gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2 lg:grid-cols-5">
        @* Giữ nguyên ngày đang chọn ở thanh ngày khi áp dụng bộ lọc. *@
        <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold uppercase tracking-wide text-slate-500">Phim</label>
            @* Combobox gõ để tìm phim: ô text hiển thị + input hidden giữ movieId thật để submit bộ lọc. *@
            <div class="relative" data-combobox="movie">
                <input type="text" data-combobox-input autocomplete="off" placeholder="Tất cả phim"
                       value="@(Model.Movies.FirstOrDefault(m => m.Id == Model.MovieId)?.Name)"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
                <input type="hidden" name="movieId" data-combobox-value value="@Model.MovieId" />
                <div class="absolute z-20 mt-1 hidden max-h-60 w-full overflow-y-auto rounded-lg border border-slate-200 bg-white shadow-lg" data-combobox-list>
                    <div class="cursor-pointer px-3 py-2 text-sm text-slate-500 hover:bg-primary/10" data-combobox-option data-id="" data-name="">Tất cả phim</div>
                    @foreach (var m in Model.Movies)
                    {
                        <div class="cursor-pointer px-3 py-2 text-sm hover:bg-primary/10" data-combobox-option data-id="@m.Id" data-name="@m.Name">@m.Name</div>
                    }
                </div>
            </div>
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold uppercase tracking-wide text-slate-500">Thể loại</label>
            <select name="genreId" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                <option value="">Tất cả thể loại</option>
                @foreach (var g in Model.Genres)
                {
                    if (g.Id == Model.GenreId) { <option value="@g.Id" selected>@g.Name</option> }
                    else { <option value="@g.Id">@g.Name</option> }
                }
            </select>
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold uppercase tracking-wide text-slate-500">Độ tuổi</label>
            <select name="ageRating" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                <option value="">Tất cả độ tuổi</option>
                @foreach (var a in Model.AgeRatings)
                {
                    if (a == Model.AgeRating) { <option value="@a" selected>@a</option> }
                    else { <option value="@a">@a</option> }
                }
            </select>
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold uppercase tracking-wide text-slate-500">Loại phòng</label>
            <select name="roomTypeId" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                <option value="">Tất cả loại phòng</option>
                @foreach (var rt in Model.RoomTypes)
                {
                    if (rt.Id == Model.RoomTypeId) { <option value="@rt.Id" selected>@rt.Name</option> }
                    else { <option value="@rt.Id">@rt.Name</option> }
                }
            </select>
        </div>
        <div class="flex items-end gap-2">
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-dark">
                <span class="material-symbols-outlined text-[18px]">filter_list</span> Lọc
            </button>
            @if (Model.MovieId != null || Model.GenreId != null || !string.IsNullOrEmpty(Model.AgeRating) || Model.RoomTypeId != null)
            {
                <a href="@Url.Action("Index", "Showtime", new { date = Model.SelectedDate.ToString("yyyy-MM-dd") })"
                   class="rounded-lg px-3 py-2 text-sm font-medium text-slate-500 transition hover:text-primary">Xóa lọc</a>
            }
        </div>
    </form>

    <!-- Kết quả: nhóm theo phim -->
    <div class="space-y-6">
        @foreach (var group in Model.Showtimes.GroupBy(s => new { s.MovieId, s.MovieTitle, s.MoviePosterUrl, s.DurationMinutes, s.AgeRating }))
        {
                <div data-movie-group class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="hidden h-40 w-28 shrink-0 overflow-hidden rounded-xl bg-slate-100 sm:block">
                        @if (!string.IsNullOrEmpty(group.Key.MoviePosterUrl))
                        {
                            <img src="@MediaUrl.Poster(group.Key.MoviePosterUrl)" alt="@group.Key.MovieTitle" class="h-full w-full object-cover"
                                 onerror="this.style.display='none'" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="font-heading text-xl font-bold text-tertiary">@group.Key.MovieTitle</h2>
                            @if (!string.IsNullOrEmpty(group.Key.AgeRating))
                            {
                                <span class="rounded bg-primary/10 px-2 py-0.5 text-xs font-bold text-primary">@group.Key.AgeRating</span>
                            }
                            @if (group.Key.DurationMinutes.HasValue)
                            {
                                <span class="text-xs text-slate-500">@group.Key.DurationMinutes phút</span>
                            }
                        </div>

                        <div class="mt-4 flex flex-wrap gap-3">
                            @foreach (var st in group.OrderBy(s => s.StartTime).ThenBy(s => s.RoomName))
                            {
                                @* data-showtime-start: để JS tự ẩn suất khi tới giờ chiếu nếu trang mở lâu. *@
                                <a href="@Url.Action("SelectSeats", "Showtime", new { id = st.Id })"
                                   data-showtime-start="@st.StartTime.ToString("yyyy-MM-ddTHH:mm:ss")"
                                   class="block rounded-xl border border-slate-200 px-4 py-2.5 transition hover:border-primary hover:bg-primary/5 hover:shadow-sm">
                                    <div class="text-base font-bold text-slate-900">
                                        @st.StartTime.ToString("HH:mm") <span class="text-slate-400">–</span> @st.EndTime.ToString("HH:mm")
                                    </div>
                                    <div class="mt-0.5 text-xs text-slate-500">
                                        <span class="material-symbols-outlined align-middle text-[14px]">meeting_room</span>
                                        @st.RoomName@(string.IsNullOrEmpty(st.RoomTypeName) ? "" : $" · {st.RoomTypeName}")
                                    </div>
                                    @if (!string.IsNullOrEmpty(st.CinemaName))
                                    {
                                        <div class="text-[.7rem] text-slate-400">@st.CinemaName</div>
                                    }
                                </a>
                            }
                        </div>
                    </div>
                </div>
        }
    </div>

    @* Luôn dựng sẵn (ẩn đi khi còn suất) để JS bật lên nếu mọi suất trong ngày đều đã tới giờ chiếu. *@
    <div data-empty-state class="@(Model.Showtimes.Any() ? "hidden " : "")rounded-2xl border border-dashed border-slate-300 bg-white py-16 text-center">
        <span class="material-symbols-outlined text-5xl text-slate-300">event_busy</span>
        <p class="mt-3 text-sm text-slate-500">Không có suất chiếu nào cho lựa chọn này.</p>
    </div>
</div>

<script>
    // Tự ẩn suất chiếu đã tới giờ chiếu: server chỉ trả suất chưa bắt đầu tại thời điểm tải trang,
    // nên nếu khách để trang mở qua giờ chiếu thì suất đó phải tự biến mất (bấm vào cũng bị chặn).
    (function () {
        function sweepStartedShowtimes() {
            var now = Date.now();

            document.querySelectorAll('[data-showtime-start]').forEach(function (item) {
                var start = new Date(item.dataset.showtimeStart).getTime();
                if (!isNaN(start) && start <= now) item.remove();
            });

            // Phim không còn suất nào trong ngày -> bỏ luôn khối phim đó.
            document.querySelectorAll('[data-movie-group]').forEach(function (group) {
                if (!group.querySelector('[data-showtime-start]')) group.remove();
            });

            var emptyState = document.querySelector('[data-empty-state]');
            if (emptyState && !document.querySelector('[data-showtime-start]')) {
                emptyState.classList.remove('hidden');
            }
        }

        sweepStartedShowtimes();
        setInterval(sweepStartedShowtimes, 30000);
    })();

    // Combobox tìm phim: ô text để gõ + danh sách thả xuống; input hidden giữ movieId thật để submit bộ lọc.
    document.querySelectorAll('[data-combobox]').forEach(function (box) {
        var input = box.querySelector('[data-combobox-input]');
        var hidden = box.querySelector('[data-combobox-value]');
        var list = box.querySelector('[data-combobox-list]');
        var options = Array.prototype.slice.call(box.querySelectorAll('[data-combobox-option]'));

        // Khớp KHÔNG DẤU: gõ "bi" vẫn thấy "Bí Mật Phố Cổ" (xem wwwroot/js/vietnamese-text.js).
        function filter() {
            var keyword = VietnameseText.searchKey(input.value);
            options.forEach(function (opt) {
                // Luôn giữ hiển thị mục "Tất cả phim" (data-id rỗng) để người dùng bỏ lọc được.
                var keep = opt.dataset.id === '' || VietnameseText.contains(opt.dataset.name, keyword);
                opt.classList.toggle('hidden', !keep);
            });
        }

        function open() { filter(); list.classList.remove('hidden'); }

        function close() {
            list.classList.add('hidden');
            // Rời ô mà không chọn lại: khôi phục tên phim theo giá trị hidden hiện có (rỗng -> hiện placeholder).
            var selected = options.find(function (opt) { return opt.dataset.id === hidden.value; });
            input.value = selected ? selected.dataset.name : '';
        }

        input.addEventListener('focus', open);
        input.addEventListener('input', open);
        options.forEach(function (opt) {
            opt.addEventListener('mousedown', function (e) {
                e.preventDefault(); // giữ focus để 'blur' không chạy trước khi gán giá trị
                hidden.value = opt.dataset.id;
                input.value = opt.dataset.name;
                close();
            });
        });
        input.addEventListener('blur', close);
    });
</script>
