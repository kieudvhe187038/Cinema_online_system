@model Cinema_System.Application.ViewModels.MovieDetailsViewModel

@{
    // Thiết lập tiêu đề trang theo tên phim
    ViewData["Title"] = Model.Movie.Title;
    var rawTrailer = Model.Movie.TrailerUrl?.Trim() ?? "";

    // Hàm helper: Phân tích cú pháp YouTube URL để trích xuất Video ID
    string? youtubeId = null;
    if (!string.IsNullOrEmpty(rawTrailer))
    {
        // Trường hợp 1: Định dạng chuẩn https://www.youtube.com/watch?v=VIDEO_ID
        var watchMatch = System.Text.RegularExpressions.Regex.Match(rawTrailer,
            @"[?&]v=([A-Za-z0-9_\-]{11})");
        if (watchMatch.Success)
        {
            youtubeId = watchMatch.Groups[1].Value;
        }
        else
        {
            // Trường hợp 2: Định dạng rút gọn https://youtu.be/VIDEO_ID
            var shortMatch = System.Text.RegularExpressions.Regex.Match(rawTrailer,
                @"youtu\.be/([A-Za-z0-9_\-]{11})");
            if (shortMatch.Success)
            {
                youtubeId = shortMatch.Groups[1].Value;
            }
            else
            {
                // Trường hợp 3: Định dạng nhúng https://www.youtube.com/embed/VIDEO_ID
                var embedMatch = System.Text.RegularExpressions.Regex.Match(rawTrailer,
                    @"youtube\.com/embed/([A-Za-z0-9_\-]{11})");
                if (embedMatch.Success)
                {
                    youtubeId = embedMatch.Groups[1].Value;
                }
                else if (rawTrailer.Length == 11 && System.Text.RegularExpressions.Regex.IsMatch(rawTrailer, @"^[A-Za-z0-9_\-]{11}$"))
                {
                    // Trường hợp 4: Người dùng nhập trực tiếp ID gồm 11 ký tự của YouTube
                    youtubeId = rawTrailer;
                }
            }
        }
    }

    // Tạo đường dẫn nhúng YouTube có cấu hình tự động phát (autoplay)
    var embedUrl = youtubeId != null
        ? $"https://www.youtube.com/embed/{youtubeId}?autoplay=1&rel=0&modestbranding=1"
        : "";
    // Lấy ảnh thumbnail chất lượng cao từ YouTube để làm ảnh nền trailer
    var thumbUrl = youtubeId != null
        ? $"https://img.youtube.com/vi/{youtubeId}/maxresdefault.jpg"
        : "";

    // Gom danh sách các thể loại phim, ngăn cách nhau bằng dấu chấm giữa
    var genres = Model.Movie.GenreNames.Any() ? string.Join(" • ", Model.Movie.GenreNames) : "Chưa rõ thể loại";
    var durationText = Model.Movie.DurationMinutes.HasValue ? $"{Model.Movie.DurationMinutes.Value} phút" : "Chưa rõ";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-slate-100 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
        <!-- Back Button -->
        @* Nút quay lại trang danh sách phim ở chế độ công khai *@
        <div class="mb-8">
            <a asp-controller="Movies" asp-action="Index" class="inline-flex items-center gap-2 rounded-full border-2 border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary shadow-md hover:shadow-lg">
                <span class="material-symbols-outlined">arrow_back</span>
                Quay lại trang
            </a>
        </div>

        <!-- TempData Messages -->
        @* Hiển thị thông báo lỗi từ TempData nếu có *@
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 rounded-2xl bg-red-50 border-l-4 border-red-500 p-4 shadow-sm">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-red-500 text-[24px] flex-shrink-0">error</span>
                    <div>
                        <p class="text-sm font-semibold text-red-900">Thông báo</p>
                        <p class="text-sm text-red-700 mt-1">@TempData["Error"]</p>
                    </div>
                </div>
            </div>
        }

        @* Hiển thị thông báo thành công từ TempData nếu có *@
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 rounded-2xl bg-green-50 border-l-4 border-green-500 p-4 shadow-sm">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-green-500 text-[24px] flex-shrink-0">check_circle</span>
                    <div>
                        <p class="text-sm font-semibold text-green-900">Thành công</p>
                        <p class="text-sm text-green-700 mt-1">@TempData["Success"]</p>
                    </div>
                </div>
            </div>
        }

        @* Khung chứa chi tiết phim dạng lưới (Cột trái: Trailer/Hình ảnh, Cột phải: Thông số phim) *@
        <div class="overflow-hidden rounded-[2.5rem] bg-white shadow-[0_40px_120px_-40px_rgba(15,23,42,0.35)]">
            <div class="grid grid-cols-1 lg:grid-cols-[2.2fr_1fr] items-stretch">

                <!-- ═══ CỘT TRÁI: TRAILER PHIM ═══ -->
                <div class="relative bg-slate-950 overflow-hidden" style="min-height:420px;">
                    @if (youtubeId != null)
                    {
                        @* Hộp chứa trailer: Hiển thị ảnh bìa từ YouTube và có thể click để mở modal xem video *@
                        <div id="trailerBox" data-embed="@embedUrl"
                             class="group absolute inset-0 cursor-pointer">
                            <!-- Ảnh bìa Thumbnail lấy từ YouTube -->
                            <img id="trailerThumb"
                                 src="@thumbUrl"
                                 alt="Trailer @Model.Movie.Title"
                                 class="absolute inset-0 h-full w-full object-cover"
                                 onerror="this.src='https://img.youtube.com/vi/@youtubeId/hqdefault.jpg'" />
                            <!-- Lớp phủ tối gradient phong cách điện ảnh ở dưới -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                            <!-- Hiệu ứng làm mờ khi di chuột qua -->
                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300"></div>

                            <!-- Nút Play trung tâm -->
                            <div class="absolute inset-0 flex flex-col items-center justify-center gap-4">
                                <div class="play-circle flex h-24 w-24 items-center justify-center rounded-full
                                             bg-red-600 shadow-2xl shadow-red-700/60
                                             ring-4 ring-white/25
                                             transition-all duration-300
                                             group-hover:scale-110 group-hover:bg-red-500 group-hover:ring-white/40">
                                    <svg class="ml-2 h-10 w-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M8 5v14l11-7z"/>
                                    </svg>
                                </div>
                                <span class="text-white text-sm font-semibold tracking-widest uppercase drop-shadow-lg opacity-90 group-hover:opacity-100 transition">
                                    Xem Trailer
                                </span>
                            </div>

                            <!-- Nhãn logo YouTube ở góc dưới trái -->
                            <div class="absolute bottom-5 left-5 flex items-center gap-2 rounded-full bg-black/60 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-sm">
                                <svg class="h-4 w-4 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M21.8 8s-.2-1.4-.8-2c-.8-.8-1.6-.8-2-.9C16.8 5 12 5 12 5s-4.8 0-7 .1c-.4.1-1.2.1-2 .9-.6.6-.8 2-.8 2S2 9.6 2 11.2v1.5c0 1.6.2 3.2.2 3.2s.2 1.4.8 2c.8.8 1.8.8 2.3.8C6.8 19 12 19 12 19s4.8 0 7-.2c.4-.1 1.2-.1 2-.8.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.5C22 9.6 21.8 8 21.8 8zM9.7 14.5V9l5.5 2.8-5.5 2.7z"/>
                                </svg>
                                YouTube
                            </div>

                            <!-- Nhãn tên phim ở góc dưới phải -->
                            <div class="absolute bottom-5 right-5 text-right">
                                <p class="text-white/80 text-xs font-medium tracking-wide drop-shadow">Official Trailer</p>
                                <p class="text-white font-bold text-sm drop-shadow">@Model.Movie.Title</p>
                            </div>
                        </div>

                        @* Hộp thoại Modal phát Trailer bằng iframe của YouTube *@
                        <div id="trailerModal"
                             class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/90 backdrop-blur-md p-4 hidden">
                            <div class="relative w-full max-w-5xl">
                                <!-- Nút đóng modal trailer -->
                                <button onclick="closeTrailer()"
                                        class="absolute -top-12 right-0 flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-white/80 hover:bg-white/20 hover:text-white transition text-sm font-medium backdrop-blur-sm">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                    Đóng
                                </button>
                                <!-- Vùng hiển thị video YouTube -->
                                <div class="aspect-[16/9] w-full overflow-hidden rounded-2xl shadow-2xl ring-1 ring-white/10">
                                    <iframe id="trailerIframe"
                                            src=""
                                            title="Trailer @Model.Movie.Title"
                                            frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            allowfullscreen
                                            class="h-full w-full">
                                    </iframe>
                                </div>
                                <p class="mt-3 text-center text-white/50 text-sm">@Model.Movie.Title — Official Trailer</p>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.Movie.PosterUrl))
                    {
                        @* Nếu không có video trailer thì hiển thị ảnh poster lớn thay thế *@
                        <img src="@Model.Movie.PosterUrl" alt="@Model.Movie.Title"
                             class="absolute inset-0 h-full w-full object-cover transition duration-500 hover:scale-105" />
                    }
                    else
                    {
                        @* Giao diện mặc định khi không tìm thấy trailer hoặc poster *@
                        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-gradient-to-br from-slate-900 to-slate-800">
                            <svg class="h-16 w-16 text-slate-600" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.069A1 1 0 0121 8.88v6.24a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2-2v8a2 2 0 002 2z"/>
                            </svg>
                            <p class="text-slate-400 text-sm font-medium">Chưa có trailer</p>
                        </div>
                    }
                </div>

                <!-- ═══ CỘT PHẢI: THÔNG TIN PHIM ═══ -->
                <aside class="flex flex-col gap-5 border-l border-slate-200/70 bg-gradient-to-br from-slate-50 to-blue-50/60 p-7 lg:p-9">
                    @* Khối hiển thị thông số chi tiết của phim *@
                    <div class="flex-1 rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100 hover:shadow-md transition">
                        <h1 class="text-2xl font-heading font-black leading-snug bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">
                            @Model.Movie.Title
                        </h1>
                        <p class="mt-3 text-xs uppercase tracking-[0.22em] font-bold text-primary">@genres</p>

                        <div class="mt-5 space-y-3 text-sm text-slate-600">
                            <div class="flex items-start gap-3">
                                <span class="w-[88px] flex-shrink-0 font-semibold text-slate-800">Thời lượng</span>
                                <span class="text-slate-600">@durationText</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-[88px] flex-shrink-0 font-semibold text-slate-800">Ngôn ngữ</span>
                                <span>@(string.IsNullOrEmpty(Model.Movie.Language) ? "Chưa rõ" : Model.Movie.Language)</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-[88px] flex-shrink-0 font-semibold text-slate-800">Độ tuổi</span>
                                <span class="rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-bold text-orange-700">
                                    @(string.IsNullOrEmpty(Model.Movie.AgeRating) ? "—" : Model.Movie.AgeRating)
                                </span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-[88px] flex-shrink-0 font-semibold text-slate-800">Đạo diễn</span>
                                <span>@(string.IsNullOrEmpty(Model.Movie.Director) ? "Chưa rõ" : Model.Movie.Director)</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-[88px] flex-shrink-0 font-semibold text-slate-800">Khởi chiếu</span>
                                <span>@(Model.Movie.ReleaseDate.HasValue ? Model.Movie.ReleaseDate.Value.ToString("dd/MM/yyyy") : "Chưa rõ")</span>
                            </div>
                        </div>

                        <div class="mt-5 flex flex-wrap gap-2 pt-4 border-t border-slate-100">
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1.5 text-xs font-semibold text-primary border border-primary/20">
                                <span class="material-symbols-outlined text-sm">star</span>
                                Được đánh giá
                            </span>
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs text-slate-600 border border-slate-200">
                                <span class="material-symbols-outlined text-sm">schedule</span>
                                @durationText
                            </span>
                        </div>
                    </div>

                    @* Khối hiển thị trạng thái phát hành *@
                    <div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-100 hover:shadow-md transition">
                        <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-slate-500">
                            <span class="material-symbols-outlined text-primary text-[18px]">info</span>
                            Trạng thái
                        </p>
                        <p class="mt-2 text-slate-800 font-semibold text-sm">
                            @(string.IsNullOrEmpty(Model.Movie.Status) ? "Đang cập nhật" : Model.Movie.Status)
                        </p>
                    </div>
                </aside>
            </div>

            <div class="space-y-10 bg-gradient-to-br from-slate-50 to-blue-50 p-8 lg:p-10">
                @* Phần mô tả chi tiết nội dung phim *@
                <section class="rounded-[2.5rem] bg-white p-8 shadow-md hover:shadow-lg transition">
                    <h2 class="flex items-center gap-3 text-3xl font-heading font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent"><span class="material-symbols-outlined">movie</span> Mô tả phim</h2>
                    <div class="mt-6 space-y-4 text-slate-700 leading-relaxed text-base">
                        @Html.Raw(Model.Movie.Description ?? "<p class='text-slate-500'>Chưa có mô tả.</p>")
                    </div>
                </section>

                @* Phần danh sách các đánh giá của khán giả đối với bộ phim *@
                <section id="reviews" class="rounded-[2.5rem] bg-white p-8 shadow-md hover:shadow-lg transition">
                    <div class="flex flex-wrap items-center justify-between gap-4 pb-8 border-b border-slate-100">
                        <div>
                            <h2 class="flex items-center gap-3 text-3xl font-heading font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">
                                <span class="material-symbols-outlined">star</span>
                                Đánh giá khán giả
                            </h2>
                            <p class="mt-3 text-sm text-slate-500">Xem cảm nhận từ những khán giả đã từng xem phim.</p>
                        </div>
                        @* Nếu đã đăng nhập thì hiện nút Viết đánh giá, ngược lại hiện nút Đăng nhập *@
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a asp-controller="Reviews" asp-action="Create" asp-route-movieId="@Model.Movie.Id" class="inline-flex items-center rounded-full bg-gradient-to-r from-primary to-primary-dark px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:shadow-lg hover:shadow-primary/40 transform hover:scale-105">Viết đánh giá</a>
                        }
                        else
                        {
                            <a href="~/login?returnUrl=@Url.Action("Details", "Movies", new { id = Model.Movie.Slug })" class="inline-flex items-center rounded-full border-2 border-primary bg-white px-6 py-3 text-sm font-semibold text-primary transition hover:bg-primary/5 shadow-md hover:shadow-lg">Đăng nhập để đánh giá</a>
                        }
                    </div>

                    @* Vùng chứa danh sách review tải động qua Ajax *@
                    <div id="reviews-container">
                        <partial name="_ReviewList" model="Model.Reviews" />
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

@if (youtubeId != null)
{
    @* CSS hỗ trợ hiệu ứng cho nút Play và Modal phát Trailer phim *@
    <style>
        .trailer-wrapper { transition: transform 0.2s ease; }
        .trailer-wrapper:hover { transform: scale(1.005); }
        .play-circle { animation: pulse-ring 2s ease-in-out infinite; }
        @@keyframes pulse-ring {
            0%, 100% { box-shadow: 0 0 0 0 rgba(220,38,38,0.5), 0 25px 60px -15px rgba(220,38,38,0.5); }
            50%       { box-shadow: 0 0 0 12px rgba(220,38,38,0),  0 25px 60px -15px rgba(220,38,38,0.7); }
        }
        #trailerModal { animation: fadeInModal 0.25s ease; }
        #trailerModal.hidden { display: none !important; }
        @@keyframes fadeInModal {
            from { opacity: 0; transform: scale(0.97); }
            to   { opacity: 1; transform: scale(1); }
        }
    </style>
    @* Script xử lý mở/đóng Modal phát trailer video từ YouTube *@
    <script>
        (function () {
            var box = document.getElementById('trailerBox');
            var modal = document.getElementById('trailerModal');
            var iframe = document.getElementById('trailerIframe');
            var embedSrc = box ? box.dataset.embed : '';

            if (box) {
                // Nhấp vào khung ảnh bìa để tải nguồn video và hiển thị Modal
                box.addEventListener('click', function () {
                    if (iframe) iframe.src = embedSrc;
                    if (modal) modal.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                });
            }

            // Đóng khi click vào nền modal bên ngoài khung video
            if (modal) {
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) closeTrailer();
                });
            }

            // Đóng bằng phím ESC
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeTrailer();
            });
        })();

        // Hàm ẩn modal và reset nguồn iframe để dừng âm thanh video đang phát
        function closeTrailer() {
            var modal = document.getElementById('trailerModal');
            var iframe = document.getElementById('trailerIframe');
            if (iframe) iframe.src = '';
            if (modal) modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    </script>
}

@* Script AJAX tải danh sách review phân trang mượt mà không load lại trang *@
<script>
    function loadReviews(page) {
        var container = document.getElementById('reviews-container');
        var movieId = '@Model.Movie.Id';
        
        // Thêm hiệu ứng mờ nhẹ trong lúc chờ load dữ liệu mới từ Server
        container.style.opacity = '0.5';
        container.style.pointerEvents = 'none';

        fetch(`/Movies/LoadReviewsPartial?id=${movieId}&page=${page}`)
            .then(response => response.text())
            .then(html => {
                container.innerHTML = html;
                container.style.opacity = '1';
                container.style.pointerEvents = 'auto';
                
                // Cuộn mượt mà lên phần reviews để khán giả dễ theo dõi
                document.getElementById('reviews').scrollIntoView({ behavior: 'smooth', block: 'start' });
            })
            .catch(err => {
                console.error("Lỗi khi load reviews: ", err);
                container.style.opacity = '1';
                container.style.pointerEvents = 'auto';
            });
    }
</script>
