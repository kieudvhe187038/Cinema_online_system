@model Cinema_System.Application.ViewModels.MovieDetailsViewModel

@{
    ViewData["Title"] = Model.Movie.Title;
    var trailer = Model.Movie.TrailerUrl;
    if (!string.IsNullOrEmpty(trailer) && trailer.Contains("watch?v="))
    {
        trailer = trailer.Replace("watch?v=", "embed/");
    }
    var genres = Model.Movie.GenreNames.Any() ? string.Join(" • ", Model.Movie.GenreNames) : "Chưa rõ thể loại";
    var durationText = Model.Movie.DurationMinutes.HasValue ? $"{Model.Movie.DurationMinutes.Value} phút" : "Chưa rõ";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-slate-100 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
        <!-- Back Button -->
        <div class="mb-8">
            <a asp-controller="Movies" asp-action="Index" class="inline-flex items-center gap-2 rounded-full border-2 border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary shadow-md hover:shadow-lg">
                <span class="material-symbols-outlined">arrow_back</span>
                Quay lại trang
            </a>
        </div>

        <!-- TempData Messages -->
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 rounded-2xl bg-red-50 border-l-4 border-red-500 p-4 shadow-sm">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-red-500 text-[24px] flex-shrink-0">error</span>
                    <div>
                        <p class="text-sm font-semibold text-red-900">Thông báo</p>
                        <p class="text-sm text-red-700 mt-1">@TempData["Error"]</p>
                    </div>
                </div>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="mb-6 rounded-2xl bg-green-50 border-l-4 border-green-500 p-4 shadow-sm">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-green-500 text-[24px] flex-shrink-0">check_circle</span>
                    <div>
                        <p class="text-sm font-semibold text-green-900">Thành công</p>
                        <p class="text-sm text-green-700 mt-1">@TempData["Success"]</p>
                    </div>
                </div>
            </div>
        }

        <div class="overflow-hidden rounded-[2.5rem] bg-white shadow-[0_40px_120px_-40px_rgba(15,23,42,0.35)]">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-[2.3fr_1fr]">
                <div class="relative overflow-hidden bg-gradient-to-br from-slate-950 to-slate-900">
                    @if (!string.IsNullOrEmpty(trailer))
                    {
                        <div class="aspect-[16/9] w-full bg-black relative group">
                            <iframe class="h-full w-full" src="@trailer" title="Trailer @Model.Movie.Title" frameborder="0" allowfullscreen></iframe>
                            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition"></div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.Movie.PosterUrl)) 
                    {
                        <img src="@Model.Movie.PosterUrl" alt="@Model.Movie.Title" class="h-full w-full object-cover transition hover:scale-105" />
                    }
                    else
                    {
                        <div class="aspect-[16/9] flex items-center justify-center bg-slate-900 text-slate-400">Chưa có trailer</div>
                    }
                </div>

                <aside class="space-y-6 border-l border-slate-200/70 bg-gradient-to-br from-slate-50 to-blue-50 p-8 lg:p-10">
                    <div class="rounded-3xl bg-white p-6 shadow-md hover:shadow-lg transition">
                        <h1 class="text-3xl font-heading font-black bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">@Model.Movie.Title</h1>
                        <p class="mt-4 text-sm uppercase tracking-[0.24em] font-semibold text-primary">@genres</p>
                        <div class="mt-6 space-y-4 text-slate-600">
                            <div class="flex items-center gap-3">
                                <span class="w-24 font-semibold text-slate-900">Thời lượng:</span>
                                <span>@durationText</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="w-24 font-semibold text-slate-900">Ngôn ngữ:</span>
                                <span>@(string.IsNullOrEmpty(Model.Movie.Language) ? "Chưa rõ" : Model.Movie.Language)</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="w-24 font-semibold text-slate-900">Độ tuổi:</span>
                                <span>@(string.IsNullOrEmpty(Model.Movie.AgeRating) ? "Chưa rõ" : Model.Movie.AgeRating)</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="w-24 font-semibold text-slate-900">Đạo diễn:</span>
                                <span>@(string.IsNullOrEmpty(Model.Movie.Director) ? "Chưa rõ" : Model.Movie.Director)</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="w-24 font-semibold text-slate-900">Khởi chiếu:</span>
                                <span>@(Model.Movie.ReleaseDate.HasValue ? Model.Movie.ReleaseDate.Value.ToString("dd/MM/yyyy") : "Chưa rõ")</span>
                            </div>
                        </div>
                        <div class="mt-6 flex flex-wrap gap-3">
                            <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-primary border border-primary/20">
                                <span class="material-symbols-outlined text-base">star</span>
                                Được đánh giá
                            </span>
                            <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-sm text-slate-700 border border-slate-200">
                                <span class="material-symbols-outlined text-base">schedule</span>
                                @durationText
                            </span>
                        </div>
                    </div>

                    <div class="rounded-3xl bg-white p-6 shadow-md hover:shadow-lg transition">
                        <p class="flex items-center gap-2 text-sm font-semibold text-slate-900"><span class="material-symbols-outlined text-primary text-[20px]">info</span> Trạng thái</p>
                        <p class="mt-3 text-slate-600 font-medium">@(string.IsNullOrEmpty(Model.Movie.Status) ? "Đang cập nhật" : Model.Movie.Status)</p>
                    </div>
                </aside>
            </div>

            <div class="space-y-10 bg-gradient-to-br from-slate-50 to-blue-50 p-8 lg:p-10">
                <section class="rounded-[2.5rem] bg-white p-8 shadow-md hover:shadow-lg transition">
                    <h2 class="flex items-center gap-3 text-3xl font-heading font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent"><span class="material-symbols-outlined">movie</span> Mô tả phim</h2>
                    <div class="mt-6 space-y-4 text-slate-700 leading-relaxed text-base">
                        @Html.Raw(Model.Movie.Description ?? "<p class='text-slate-500'>Chưa có mô tả.</p>")
                    </div>
                </section>

                <section class="rounded-[2.5rem] bg-white p-8 shadow-md hover:shadow-lg transition">
                    <div class="flex flex-wrap items-center justify-between gap-4 pb-8 border-b border-slate-100">
                        <div>
                            <h2 class="flex items-center gap-3 text-3xl font-heading font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">
                                <span class="material-symbols-outlined">star</span>
                                Đánh giá khán giả
                            </h2>
                            <p class="mt-3 text-sm text-slate-500">Xem cảm nhận từ những khán giả đã từng xem phim.</p>
                        </div>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a asp-controller="Reviews" asp-action="Create" asp-route-movieId="@Model.Movie.Id" class="inline-flex items-center rounded-full bg-gradient-to-r from-primary to-primary-dark px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:shadow-lg hover:shadow-primary/40 transform hover:scale-105">Viết đánh giá</a>
                        }
                        else
                        {
                            <a href="~/login?returnUrl=@Url.Action("Details", "Movies", new { id = Model.Movie.Slug })" class="inline-flex items-center rounded-full border-2 border-primary bg-white px-6 py-3 text-sm font-semibold text-primary transition hover:bg-primary/5 shadow-md hover:shadow-lg">Đăng nhập để đánh giá</a>
                        }
                    </div>

                    <div class="mt-8 space-y-4">
                        @if (Model.Reviews.Items.Any())
                        {
                            @foreach (var r in Model.Reviews.Items)
                            {
                                <div class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-gradient-to-br from-white to-slate-50 p-6 shadow-sm transition-all duration-300 hover:shadow-md hover:border-primary/30">
                                    <div class="absolute inset-0 bg-gradient-to-r from-primary/0 via-primary/5 to-primary/0 opacity-0 group-hover:opacity-100 transition"></div>
                                    <div class="relative z-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                                        <div>
                                            <p class="text-lg font-bold text-slate-900">@r.UserName</p>
                                            @{
                                                var createdAt = r.CreatedAt;
                                                var createdAtText = createdAt.HasValue
                                                    ? (createdAt.Value.TimeOfDay == TimeSpan.Zero
                                                        ? createdAt.Value.ToString("dd/MM/yyyy")
                                                        : createdAt.Value.ToString("dd/MM/yyyy HH:mm"))
                                                    : "—";
                                            }
                                            <p class="text-sm text-slate-500">@createdAtText</p>
                                        </div>
                                        <div class="flex items-center gap-0.5 text-yellow-400">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="text-xl @(i <= r.Rating ? "text-yellow-400 drop-shadow-md" : "text-slate-300")">★</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.Comment))
                                    {
                                        <p class="relative z-10 mt-4 text-slate-700 leading-relaxed">@r.Comment</p>
                                    }
                                    else
                                    {
                                        <p class="relative z-10 mt-4 text-slate-500 italic">Người dùng chưa để lại nhận xét.</p>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="rounded-2xl border-2 border-dashed border-slate-300 bg-gradient-to-br from-slate-50 to-blue-50 p-10 text-center">
                                <p class="text-xl font-bold text-slate-900">Chưa có đánh giá nào</p>
                                <p class="mt-2 text-slate-600">Hãy là người đầu tiên chia sẻ cảm nhận.</p>
                            </div>
                        }
                    </div>

                    @if (Model.Reviews.TotalPages > 1)
                    {
                        <div class="mt-8 text-center">
                            <a asp-controller="Reviews" asp-action="Index" asp-route-movieId="@Model.Movie.Id" class="inline-flex items-center gap-2 rounded-full border-2 border-primary bg-white px-6 py-3 text-sm font-semibold text-primary transition hover:bg-primary/5 shadow-md hover:shadow-lg">
                                Xem tất cả đánh giá (Trang 1/@Model.Reviews.TotalPages)
                                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
                            </a>
                        </div>
                    }
                </section>
            </div>
        </div>
    </div>
</div>
