@model Cinema_System.Application.ViewModels.MoviesPageViewModel

@{
    ViewData["Title"] = "Phim";
    string searchKeyword = Model.SearchKeyword ?? string.Empty;
    bool isSearch = !string.IsNullOrEmpty(searchKeyword);

    string AgeRatingLabel(string rating) => rating switch
    {
        "P" => "P - Phù hợp mọi lứa tuổi",
        "C13" => "C13 - Trên 13 tuổi",
        "C16" => "C16 - Trên 16 tuổi",
        "C18" => "C18 - Trên 18 tuổi",
        _ => rating
    };
}

<div class="space-y-8 bg-slate-50 px-4 py-10 text-slate-900 font-body sm:px-6 lg:px-8">
    @if (TempData["SearchError"] is string searchError)
    {
        <div class="mx-auto max-w-7xl rounded-[2rem] border border-orange-200 bg-orange-50 px-6 py-4 text-orange-900 shadow-sm">
            <p class="text-sm font-medium">@searchError</p>
        </div>
    }

    <!-- Bộ chọn danh sách (căn giữa) -->
    <div class="flex justify-center">
        <div class="flex flex-wrap items-center justify-center gap-3 rounded-full border border-slate-200 bg-white p-2 shadow-sm">
            @if (isSearch)
            {
                <a class="rounded-full px-5 py-2 text-sm font-semibold transition hover:bg-primary hover:text-white @(Model.SelectedTab == "coming" ? "bg-primary text-white" : "text-slate-700")" asp-controller="Movies" asp-action="Search" asp-route-tab="coming" asp-route-find="@searchKeyword" asp-route-page="1">PHIM SẮP CHIẾU</a>
                <a class="rounded-full px-5 py-2 text-sm font-semibold transition hover:bg-primary hover:text-white @(Model.SelectedTab == "now" ? "bg-primary text-white" : "text-slate-700")" asp-controller="Movies" asp-action="Search" asp-route-tab="now" asp-route-find="@searchKeyword" asp-route-page="1">PHIM ĐANG CHIẾU</a>
                <a class="rounded-full px-5 py-2 text-sm font-semibold transition hover:bg-primary hover:text-white @(Model.SelectedTab == "special" ? "bg-primary text-white" : "text-slate-700")" asp-controller="Movies" asp-action="Search" asp-route-tab="special" asp-route-find="@searchKeyword" asp-route-page="1">SUẤT CHIẾU ĐẶC BIỆT</a>
            }
            else
            {
                <a class="rounded-full px-5 py-2 text-sm font-semibold transition hover:bg-primary hover:text-white @(Model.SelectedTab == "coming" ? "bg-primary text-white" : "text-slate-700")" asp-controller="Movies" asp-action="Index" asp-route-tab="coming" asp-route-page="1">PHIM SẮP CHIẾU</a>
                <a class="rounded-full px-5 py-2 text-sm font-semibold transition hover:bg-primary hover:text-white @(Model.SelectedTab == "now" ? "bg-primary text-white" : "text-slate-700")" asp-controller="Movies" asp-action="Index" asp-route-tab="now" asp-route-page="1">PHIM ĐANG CHIẾU</a>
                <a class="rounded-full px-5 py-2 text-sm font-semibold transition hover:bg-primary hover:text-white @(Model.SelectedTab == "special" ? "bg-primary text-white" : "text-slate-700")" asp-controller="Movies" asp-action="Index" asp-route-tab="special" asp-route-page="1">SUẤT CHIẾU ĐẶC BIỆT</a>
            }
        </div>
    </div>

    <section class="mx-auto max-w-7xl rounded-[2rem] bg-white p-6 shadow-[0_24px_80px_-40px_rgba(15,23,42,0.2)]">
        @{ bool hasFilter = !string.IsNullOrWhiteSpace(Model.SelectedGenre) || !string.IsNullOrWhiteSpace(Model.SelectedAgeRating); }
        <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <p class="text-xs uppercase tracking-[0.28em] text-primary">@(isSearch ? "Kết quả tìm kiếm" : (Model.SelectedTab == "coming") ? "Phim sắp chiếu" : (Model.SelectedTab == "special") ? "Suất chiếu đặc biệt" : "Phim đang chiếu")</p>
                <h2 class="mt-3 text-3xl font-bold text-slate-900">
                    @(isSearch ? "Kết quả tìm kiếm" : (Model.SelectedTab == "coming") ? "PHIM SẮP CHIẾU" : (Model.SelectedTab == "special") ? "SUẤT CHIẾU ĐẶC BIỆT" : "PHIM ĐANG CHIẾU")
                </h2>
                @if (isSearch)
                {
                    <div class="mt-3 flex items-center gap-2">
                        <p class="text-sm text-slate-600">Tìm kiếm cho: <strong class="text-slate-900">@searchKeyword</strong></p>
                        <a asp-controller="Movies" asp-action="Index" asp-route-tab="@Model.SelectedTab" class="inline-flex items-center rounded-full bg-slate-100 p-1 text-slate-500 transition hover:bg-slate-200 hover:text-slate-700" title="Xóa tìm kiếm">
                            <span class="material-symbols-outlined text-sm">close</span>
                        </a>
                    </div>
                }
            </div>

            @if (!isSearch)
            {
                <!-- Bộ lọc gọn dạng pill, căn ngang với tiêu đề -->
                <form asp-controller="Movies" asp-action="Index" method="get" class="flex flex-wrap items-center gap-2">
                    <input type="hidden" name="tab" value="@Model.SelectedTab" />
                    <div class="relative">
                        <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-base text-slate-400">category</span>
                        <select name="genre" class="appearance-none rounded-full border border-slate-200 bg-white py-2.5 pl-10 pr-9 text-sm text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20">
                            <option value="">Tất cả thể loại</option>
                            @foreach (var genre in Model.AvailableGenres)
                            {
                                <option value="@genre" selected="@(Model.SelectedGenre == genre)">@genre</option>
                            }
                        </select>
                        <span class="material-symbols-outlined pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-base text-slate-400">expand_more</span>
                    </div>
                    <div class="relative">
                        <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-base text-slate-400">cake</span>
                        <select name="ageRating" class="appearance-none rounded-full border border-slate-200 bg-white py-2.5 pl-10 pr-9 text-sm text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20">
                            <option value="">Tất cả độ tuổi</option>
                            @foreach (var rating in Model.AvailableAgeRatings)
                            {
                                <option value="@rating" selected="@(Model.SelectedAgeRating == rating)">@AgeRatingLabel(rating)</option>
                            }
                        </select>
                        <span class="material-symbols-outlined pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-base text-slate-400">expand_more</span>
                    </div>
                    <button type="submit" class="inline-flex items-center gap-1 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-dark"><span class="material-symbols-outlined text-base">filter_alt</span> Lọc</button>
                    @if (hasFilter)
                    {
                        <a asp-controller="Movies" asp-action="Index" asp-route-tab="@Model.SelectedTab" class="inline-flex items-center rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" title="Xóa lọc"><span class="material-symbols-outlined text-base">close</span></a>
                    }
                </form>
            }
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @if (Model?.Movies != null && Model.Movies.Any())
            {
                var cardViewData = new ViewDataDictionary(ViewData);
                if (Model.SelectedTab == "coming") { cardViewData["HideBuyButton"] = true; }
                @foreach (var movie in Model.Movies)
                {
                    @await Html.PartialAsync("_MovieCard", movie, cardViewData)
                }
            }
            else
            {
                <div class="col-span-full rounded-[1.75rem] border border-slate-200 bg-slate-50 p-10 text-center text-slate-600">Không tìm thấy phim cho lựa chọn này.</div>
            }
        </div>

        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="mt-8 flex flex-wrap items-center justify-center gap-2 text-sm text-slate-700">
                @if (Model.CurrentPage > 1)
                {
                    if (isSearch)
                    {
                        <a class="rounded-full border border-slate-200 bg-white px-4 py-2 transition hover:bg-slate-100" asp-controller="Movies" asp-action="Search" asp-route-find="@searchKeyword" asp-route-tab="@Model.SelectedTab" asp-route-page="@(Model.CurrentPage - 1)">&laquo; Trước</a>
                    }
                    else
                    {
                        <a class="rounded-full border border-slate-200 bg-white px-4 py-2 transition hover:bg-slate-100" asp-controller="Movies" asp-action="Index" asp-route-tab="@Model.SelectedTab" asp-route-genre="@Model.SelectedGenre" asp-route-ageRating="@Model.SelectedAgeRating" asp-route-page="@(Model.CurrentPage - 1)">&laquo; Trước</a>
                    }
                }
                else
                {
                    <span class="rounded-full border border-slate-200 bg-slate-100 px-4 py-2 text-slate-400">&laquo; Trước</span>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span class="rounded-full bg-primary px-4 py-2 text-white">@i</span>
                    }
                    else if (isSearch)
                    {
                        <a class="rounded-full border border-slate-200 bg-white px-4 py-2 transition hover:bg-primary hover:text-white" asp-controller="Movies" asp-action="Search" asp-route-find="@searchKeyword" asp-route-tab="@Model.SelectedTab" asp-route-page="@i">@i</a>
                    }
                    else
                    {
                        <a class="rounded-full border border-slate-200 bg-white px-4 py-2 transition hover:bg-primary hover:text-white" asp-controller="Movies" asp-action="Index" asp-route-tab="@Model.SelectedTab" asp-route-genre="@Model.SelectedGenre" asp-route-ageRating="@Model.SelectedAgeRating" asp-route-page="@i">@i</a>
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    if (isSearch)
                    {
                        <a class="rounded-full border border-slate-200 bg-white px-4 py-2 transition hover:bg-slate-100" asp-controller="Movies" asp-action="Search" asp-route-find="@searchKeyword" asp-route-tab="@Model.SelectedTab" asp-route-page="@(Model.CurrentPage + 1)">Tiếp &raquo;</a>
                    }
                    else
                    {
                        <a class="rounded-full border border-slate-200 bg-white px-4 py-2 transition hover:bg-slate-100" asp-controller="Movies" asp-action="Index" asp-route-tab="@Model.SelectedTab" asp-route-genre="@Model.SelectedGenre" asp-route-ageRating="@Model.SelectedAgeRating" asp-route-page="@(Model.CurrentPage + 1)">Tiếp &raquo;</a>
                    }
                }
                else
                {
                    <span class="rounded-full border border-slate-200 bg-slate-100 px-4 py-2 text-slate-400">Tiếp &raquo;</span>
                }
            </div>
        }
    </section>
</div>
