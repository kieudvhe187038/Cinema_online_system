@model Cinema_System.Application.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "Báo cáo & Thống kê";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    string vnd(decimal v) => v.ToString("N0") + " ₫";

    // Dữ liệu cho biểu đồ (đẩy xuống JS).
    var dayLabels = Model.DailyRevenue.Select(d => d.Date.ToString("dd/MM")).ToList();
    var dayData = Model.DailyRevenue.Select(d => d.Revenue).ToList();
    var payLabels = Model.PaymentMethods.Select(p => p.Method).ToList();
    var payData = Model.PaymentMethods.Select(p => p.Amount).ToList();
    var movieLabels = Model.TopMovies.Select(m => m.Title).ToList();
    var movieData = Model.TopMovies.Select(m => m.Revenue).ToList();

    var kpis = new (string Label, string Icon, string Value, string Bg, string Fg)[]
    {
        ("Tổng doanh thu",  "payments",            vnd(Model.TotalRevenue),                  "bg-emerald-100", "text-emerald-600"),
        ("Số đơn đặt vé",   "receipt_long",        Model.TotalBookings.ToString("N0"),       "bg-primary/10",  "text-primary"),
        ("Số vé bán",       "confirmation_number", Model.TotalTickets.ToString("N0"),        "bg-sky-100",     "text-sky-600"),
        ("TB mỗi đơn",      "trending_up",         vnd(Model.AvgOrderValue),                 "bg-violet-100",  "text-violet-600"),
    };
}

<div class="max-w-[1200px] mx-auto">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
            <h1 class="font-head text-2xl font-extrabold text-[#191c1d]">Báo cáo & Thống kê</h1>
            <p class="text-sm text-gray-500 mt-1">Doanh thu, vé bán và phân tích kinh doanh theo khoảng thời gian.</p>
        </div>
        <!-- Bộ lọc khoảng ngày -->
        <form method="get" action="@Url.Action("Index", "Report")" class="flex flex-wrap items-end gap-2">
            <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-gray-500">Từ ngày</label>
                <input type="date" name="from" value="@Model.DateFrom.ToString("yyyy-MM-dd")"
                       class="rounded-lg border border-[#e0c0b2] bg-white px-3 py-2 text-sm focus:border-primary focus:outline-none" />
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-gray-500">Đến ngày</label>
                <input type="date" name="to" value="@Model.DateTo.ToString("yyyy-MM-dd")"
                       class="rounded-lg border border-[#e0c0b2] bg-white px-3 py-2 text-sm focus:border-primary focus:outline-none" />
            </div>
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-dark">
                <span class="material-symbols-outlined" style="font-size:18px">filter_list</span> Xem
            </button>
        </form>
    </div>

    <!-- KPI -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        @foreach (var k in kpis)
        {
            <div class="bg-white rounded-xl shadow-sm p-5 flex items-center gap-4">
                <span class="w-12 h-12 rounded-xl @k.Bg @k.Fg flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined" style="font-size:24px">@k.Icon</span>
                </span>
                <div class="min-w-0">
                    <div class="text-xl font-extrabold text-[#191c1d] truncate">@k.Value</div>
                    <div class="text-sm text-gray-500">@k.Label</div>
                </div>
            </div>
        }
    </div>

    <!-- Biểu đồ doanh thu theo ngày -->
    <div class="bg-white rounded-xl shadow-sm p-5 mb-6">
        <h2 class="font-head text-base font-bold text-[#191c1d] mb-4">Doanh thu theo ngày</h2>
        <div class="relative h-72">
            <canvas id="chartRevenue"></canvas>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <!-- Phương thức thanh toán -->
        <div class="bg-white rounded-xl shadow-sm p-5">
            <h2 class="font-head text-base font-bold text-[#191c1d] mb-4">Phương thức thanh toán</h2>
            @if (Model.PaymentMethods.Any())
            {
                <div class="relative h-64">
                    <canvas id="chartPayment"></canvas>
                </div>
            }
            else
            {
                <div class="py-16 text-center text-sm text-gray-500">Chưa có dữ liệu.</div>
            }
        </div>

        <!-- Top phim -->
        <div class="bg-white rounded-xl shadow-sm p-5">
            <h2 class="font-head text-base font-bold text-[#191c1d] mb-4">Top phim theo doanh thu vé</h2>
            @if (Model.TopMovies.Any())
            {
                <div class="relative h-64">
                    <canvas id="chartMovies"></canvas>
                </div>
            }
            else
            {
                <div class="py-16 text-center text-sm text-gray-500">Chưa có dữ liệu.</div>
            }
        </div>
    </div>

    <!-- Bảng top phim chi tiết -->
    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-[#f0f0f0]">
            <h2 class="font-head text-base font-bold text-[#191c1d]">Chi tiết top phim</h2>
        </div>
        @if (Model.TopMovies.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wide text-gray-500 bg-[#fafbfc]">
                            <th class="px-5 py-3 font-semibold">#</th>
                            <th class="px-5 py-3 font-semibold">Phim</th>
                            <th class="px-5 py-3 font-semibold text-right">Vé bán</th>
                            <th class="px-5 py-3 font-semibold text-right">Doanh thu vé</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rank = 0; }
                        @foreach (var m in Model.TopMovies)
                        {
                            rank++;
                            <tr class="border-t border-[#f4f5f6]">
                                <td class="px-5 py-3 text-gray-500">@rank</td>
                                <td class="px-5 py-3 font-semibold text-[#191c1d]">@m.Title</td>
                                <td class="px-5 py-3 text-right text-gray-700">@m.TicketsSold.ToString("N0")</td>
                                <td class="px-5 py-3 text-right font-semibold text-[#191c1d]">@vnd(m.Revenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="px-5 py-10 text-center text-sm text-gray-500">Không có dữ liệu trong khoảng đã chọn.</div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <script>
        const dayLabels = @Json.Serialize(dayLabels);
        const dayData = @Json.Serialize(dayData);
        const payLabels = @Json.Serialize(payLabels);
        const payData = @Json.Serialize(payData);
        const movieLabels = @Json.Serialize(movieLabels);
        const movieData = @Json.Serialize(movieData);

        const vnd = v => (v ?? 0).toLocaleString('vi-VN') + ' ₫';
        const palette = ['#f37021', '#004b8d', '#10b981', '#8b5cf6', '#f59e0b', '#ef4444', '#0ea5e9'];

        // Doanh thu theo ngày (đường)
        new Chart(document.getElementById('chartRevenue'), {
            type: 'line',
            data: {
                labels: dayLabels,
                datasets: [{
                    label: 'Doanh thu',
                    data: dayData,
                    borderColor: '#f37021',
                    backgroundColor: 'rgba(243,112,33,.12)',
                    fill: true, tension: .3, pointRadius: 2
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => vnd(c.parsed.y) } } },
                scales: { y: { beginAtZero: true, ticks: { callback: v => v.toLocaleString('vi-VN') } } }
            }
        });

        // Phương thức thanh toán (doughnut) — hiện % trên từng phần + trong tooltip.
        const pctOf = (val, arr) => { const t = arr.reduce((a, b) => a + b, 0); return t ? val / t * 100 : 0; };
        const payEl = document.getElementById('chartPayment');
        if (payEl) new Chart(payEl, {
            type: 'doughnut',
            data: { labels: payLabels, datasets: [{ data: payData, backgroundColor: palette }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: { callbacks: { label: c => c.label + ': ' + vnd(c.parsed) + ' (' + pctOf(c.parsed, c.dataset.data).toFixed(1) + '%)' } },
                    datalabels: {
                        color: '#fff',
                        font: { weight: 'bold', size: 11 },
                        // Ẩn nhãn cho phần quá nhỏ (<5%) để khỏi chồng chữ.
                        formatter: (value, ctx) => {
                            const p = pctOf(value, ctx.dataset.data);
                            return p >= 5 ? Math.round(p) + '%' : '';
                        }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });

        // Top phim (cột ngang)
        const movieEl = document.getElementById('chartMovies');
        if (movieEl) new Chart(movieEl, {
            type: 'bar',
            data: { labels: movieLabels, datasets: [{ label: 'Doanh thu vé', data: movieData, backgroundColor: '#004b8d' }] },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => vnd(c.parsed.x) } } },
                scales: { x: { beginAtZero: true, ticks: { callback: v => v.toLocaleString('vi-VN') } } }
            }
        });
    </script>
}
