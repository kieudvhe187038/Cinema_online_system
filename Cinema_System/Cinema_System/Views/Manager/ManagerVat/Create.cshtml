@using Cinema_System.Application.Common
@model VatFormViewModel
@{
    ViewData["Title"] = "Thêm Cấu Hình VAT";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    const string fieldInput = "w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm box-border focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20";
    const string fieldLabel = "block font-semibold text-gray-700 mb-1.5 text-sm";
    const string fieldError = "block text-red-700 text-xs mt-1";
}

<div class="max-w-[560px] mx-auto mb-8">
    <div class="mb-6">
        <h1 class="font-head text-2xl font-extrabold text-[#191c1d] mb-0.5">Thêm Cấu Hình VAT</h1>
        <p class="text-sm text-gray-500">Thiết lập tỷ lệ thuế VAT áp dụng cho vé và bắp nước</p>
    </div>

    <div class="bg-white rounded-xl border border-[#e8eaed] p-7">
        <form method="post" action="@Url.Action("Create", "ManagerVat")">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-700 text-sm mb-4"></div>

            <div class="mb-4">
                <label asp-for="VatRate" class="@fieldLabel">Tỷ lệ VAT</label>
                <input asp-for="VatRate" type="number" min="0" max="1" step="0.01" placeholder="VD: 0.08 (tương đương 8%)" class="@fieldInput" />
                <span asp-validation-for="VatRate" class="@fieldError"></span>
                <p class="text-xs text-gray-500 mt-1">Nhập dạng phân số từ 0 đến 1. VD: 0.08 = 8%, 0.1 = 10%.</p>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="@fieldLabel">Mô tả</label>
                <input asp-for="Description" placeholder="VD: Thuế VAT 8% áp dụng từ 2026" class="@fieldInput" />
                <span asp-validation-for="Description" class="@fieldError"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="@fieldLabel">Trạng thái</label>
                <select asp-for="Status" class="@fieldInput">
                    <option value="@VatStatus.Active">Đang áp dụng</option>
                    <option value="@VatStatus.Inactive">Đã tắt</option>
                </select>
                <span asp-validation-for="Status" class="@fieldError"></span>
                <p class="text-xs text-gray-500 mt-1">Chỉ một cấu hình VAT được "Đang áp dụng" tại một thời điểm — chọn mục này sẽ tự động tắt các cấu hình đang bật khác.</p>
            </div>

            <div class="flex gap-3 mt-6">
                <button type="submit" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg text-sm font-semibold transition-colors">
                    <span class="material-symbols-outlined" style="font-size:18px">add</span>
                    Thêm mới
                </button>
                <a class="inline-flex items-center px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-[#191c1d] rounded-lg text-sm font-semibold transition-colors" href="@Url.Action("Index", "ManagerVat")">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
