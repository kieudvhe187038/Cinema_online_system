@model Cinema_System.Application.ViewModels.ShowtimeFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa suất chiếu";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@{
    const string fieldInput = "w-full px-3 py-2.5 border border-[#e0c0b2] rounded-lg bg-white text-sm box-border focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20";
    const string fieldLabel = "block font-semibold text-[#584237] mb-1.5 text-sm";
    const string fieldError = "block text-red-700 text-xs mt-1";
    const string card = "bg-white rounded-xl shadow-sm p-7 mb-5";
    const string sectionTitle = "font-bold text-base text-[#191c1d] mb-4 pb-2 border-b-2 border-[#edeeef]";
}

@* Tiêu đề của trang Sửa suất chiếu *@
<div class="max-w-[760px] mx-auto mb-8">
    <div class="flex items-center justify-between gap-4 mb-6">
        <h1 class="font-head text-2xl font-extrabold text-[#191c1d]">Chỉnh sửa suất chiếu</h1>
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-600 bg-gray-100 px-3 py-1.5 rounded-full whitespace-nowrap">
            <span class="material-symbols-outlined" style="font-size:16px">confirmation_number</span>
            @Model.SeatsSold/@Model.Capacity vé đã bán
        </span>
    </div>

    @* Form chỉnh sửa thông tin suất chiếu *@
    <form id="editShowtimeForm" method="post" action="@Url.Action("Edit", "ManagerShowtime", new { id = Model.Id })">
        @Html.AntiForgeryToken()
        
        @* Card chứa các trường thông tin chính (Phim, Phòng, Giờ, Trạng thái) *@
        <div class="@card"> 
            <p class="@sectionTitle">Thông tin suất chiếu</p>
            <div asp-validation-summary="ModelOnly" class="text-red-700 text-sm mb-4"></div>

            @if (Model.HasBookings)
            {
                <div class="mb-5 p-4 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-sm flex flex-col gap-1 col-span-2">
                    <span class="font-bold">⚠️ Cảnh báo: Suất chiếu đã có khách đặt chỗ hoặc mua vé!</span>
                    <span>Bạn không thể chỉnh sửa phim, phòng chiếu hoặc thời gian của suất chiếu này.</span>
                </div>
            }

            <div class="grid grid-cols-2 gap-x-5 gap-y-4">
                <div class="mb-3.5 col-span-2">
                    <label asp-for="MovieId" class="@fieldLabel"></label>
                    @if (Model.HasBookings)
                    {
                        <select class="@fieldInput" disabled>
                            <option value="">-- Chọn phim --</option>
                            @foreach (var movie in Model.AvailableMovies)
                            {
                                if (movie.Id == Model.MovieId)
                                {
                                    <option value="@movie.Id" selected>@movie.Name</option>
                                }
                                else
                                {
                                    <option value="@movie.Id">@movie.Name</option>
                                }
                            }
                        </select>
                        <input type="hidden" asp-for="MovieId" />
                    }
                    else
                    {
                        <div class="relative" data-combobox="movie">
                            <input type="text" class="@fieldInput" data-combobox-input placeholder="-- Chọn phim --" autocomplete="off"
                                   value="@(Model.AvailableMovies.FirstOrDefault(m => m.Id == Model.MovieId)?.Name)" />
                            <input type="hidden" asp-for="MovieId" data-combobox-value />
                            <div class="absolute z-10 w-full mt-1 max-h-60 overflow-y-auto bg-white border border-[#e0c0b2] rounded-lg shadow-lg hidden" data-combobox-list>
                                @foreach (var movie in Model.AvailableMovies)
                                {
                                    <div class="px-3 py-2 text-sm cursor-pointer hover:bg-primary/10" data-combobox-option data-id="@movie.Id" data-name="@movie.Name">@movie.Name</div>
                                }
                            </div>
                        </div>
                    }
                    <span asp-validation-for="MovieId" class="@fieldError"></span>
                </div>
                <div class="mb-3.5 col-span-2">
                    <label asp-for="RoomId" class="@fieldLabel"></label>
                    @if (Model.HasBookings)
                    {
                        <select class="@fieldInput" disabled>
                            <option value="">-- Chọn phòng --</option>
                            @foreach (var room in Model.AvailableRooms)
                            {
                                if (room.Id == Model.RoomId)
                                {
                                    <option value="@room.Id" selected>@room.Name</option>
                                }
                                else
                                {
                                    <option value="@room.Id">@room.Name</option>
                                }
                            }
                        </select>
                        <input type="hidden" asp-for="RoomId" />
                    }
                    else
                    {
                        <select asp-for="RoomId" class="@fieldInput">
                            <option value="">-- Chọn phòng --</option>
                            @foreach (var room in Model.AvailableRooms)
                            {
                                if (room.Id == Model.RoomId)
                                {
                                    <option value="@room.Id" selected>@room.Name</option>
                                }
                                else
                                {
                                    <option value="@room.Id">@room.Name</option>
                                }
                            }
                        </select>
                    }
                    <span asp-validation-for="RoomId" class="@fieldError"></span>
                </div>

                <div class="mb-3.5 grid grid-cols-2 gap-x-5 col-span-2">
                    <div>
                        <label class="@fieldLabel">Ngày bắt đầu</label>
                        @if (Model.HasBookings)
                        {
                            <input id="StartDate" type="date" value="@Model.StartTime.ToString("yyyy-MM-dd")" class="@fieldInput" disabled />
                        }
                        else
                        {
                            <input id="StartDate" name="StartDate" type="date" value="@Model.StartTime.ToString("yyyy-MM-dd")" class="@fieldInput" />
                        }
                    </div>
                    <div>
                        <label class="@fieldLabel">Giờ bắt đầu</label>
                        @if (Model.HasBookings)
                        {
                            <input id="StartTimeInput" type="time" step="60" value="@Model.StartTime.ToString("HH:mm")" class="@fieldInput" disabled />
                        }
                        else
                        {
                            <input id="StartTimeInput" name="StartTimeInput" type="time" step="60" value="@Model.StartTime.ToString("HH:mm")" class="@fieldInput" />
                        }
                    </div>
                </div>
                <input id="StartTime" name="StartTime" type="hidden" value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="StartTime" class="@fieldError"></span>
                
                <div class="mb-3.5 col-span-2">
                    <div class="text-sm text-gray-500 italic mt-2">
                        * Giờ kết thúc sẽ được hệ thống tự động tính toán dựa trên thời lượng phim.
                    </div>
                    <div class="text-sm text-gray-500 italic mt-1">
                        * Hệ thống sẽ tự động cộng thêm 20 phút dọn dẹp sau khi phim kết thúc.
                    </div>
                </div>
            </div>
    </form>

    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            @if (!Model.HasBookings)
            {
                <button id="showtimeSubmit" form="editShowtimeForm" type="submit" class="px-5 py-2.5 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition-colors">Lưu</button>
            }
            <a class="px-5 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50" href="@Url.Action("Calendar", "ManagerShowtime")">Quay lại</a>
        </div>

        @if (Model.HasBookings)
        {
            <form method="post" action="@Url.Action("Cancel", "ManagerShowtime", new { id = Model.Id })"
                  data-confirm="Bạn có chắc chắn muốn HỦY suất chiếu này không? Việc hủy suất chiếu sẽ hủy tất cả vé đã đặt."
                  data-confirm-title="Hủy suất chiếu" data-confirm-type="danger" data-confirm-ok="Hủy suất chiếu">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-5 py-2.5 bg-red-600 text-white rounded-lg text-sm font-semibold hover:bg-red-700 transition-colors">Hủy suất chiếu</button>
            </form>
        }
        else
        {
            <form method="post" action="@Url.Action("Delete", "ManagerShowtime", new { id = Model.Id })"
                  data-confirm="Bạn có chắc chắn muốn xóa suất chiếu này không?"
                  data-confirm-title="Xóa suất chiếu" data-confirm-type="danger" data-confirm-ok="Xóa">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-5 py-2.5 bg-red-600 text-white rounded-lg text-sm font-semibold hover:bg-red-700 transition-colors">Xóa suất chiếu</button>
            </form>
        }
    </div>
</div>
<script>
    // Tự động đồng bộ giá trị ngày và giờ riêng lẻ vào input hidden (StartTime) để gửi lên Controller
    (function () {
        var form = document.getElementById('editShowtimeForm');
        var startDate = document.getElementById('StartDate');
        var startTime = document.getElementById('StartTimeInput');
        var startHidden = document.getElementById('StartTime');

        function syncHidden() {
            if (startDate && startTime && startHidden) {
                startHidden.value = startDate.value + 'T' + startTime.value;
            }
        }

        // Lắng nghe sự kiện submit để ghép ngày và giờ trước khi nộp form
        if (form) {
            form.addEventListener('submit', syncHidden);
        }

        // Lắng nghe sự kiện thay đổi của các trường ngày giờ
        [startDate, startTime].forEach(function (el) {
            if (el) el.addEventListener('change', syncHidden);
        });
    })();

    // Combobox tìm kiếm phim: input hiển thị + danh sách thả xuống ngay bên dưới, input hidden giữ giá trị thật để submit/validate
    document.querySelectorAll('[data-combobox]').forEach(function (box) {
        var input = box.querySelector('[data-combobox-input]');
        var hidden = box.querySelector('[data-combobox-value]');
        var list = box.querySelector('[data-combobox-list]');
        var options = Array.prototype.slice.call(box.querySelectorAll('[data-combobox-option]'));

        // Khớp KHÔNG DẤU: gõ "bi" vẫn thấy "Bí Mật Phố Cổ" (xem wwwroot/js/vietnamese-text.js).
        function filter() {
            var keyword = VietnameseText.searchKey(input.value);
            options.forEach(function (opt) {
                opt.classList.toggle('hidden', !VietnameseText.contains(opt.dataset.name, keyword));
            });
        }

        function open() {
            filter();
            list.classList.remove('hidden');
        }

        function close() {
            list.classList.add('hidden');
            // Nếu rời khỏi ô mà không chọn lại, khôi phục tên phim theo giá trị hidden hiện có
            var selected = options.find(function (opt) { return opt.dataset.id === hidden.value; });
            input.value = selected ? selected.dataset.name : '';
        }

        input.addEventListener('focus', open);
        input.addEventListener('input', open);
        options.forEach(function (opt) {
            opt.addEventListener('mousedown', function (e) {
                e.preventDefault(); // giữ focus để 'blur' không chạy trước khi gán giá trị
                hidden.value = opt.dataset.id;
                input.value = opt.dataset.name;
                hidden.dispatchEvent(new Event('change', { bubbles: true }));
                close();
            });
        });
        input.addEventListener('blur', close);
    });
</script>
