@using Cinema_System.Application.Common
@model PriceConfigFormViewModel
@{
    const string fieldInput = "w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white text-sm box-border focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20";
    const string fieldLabel = "block font-semibold text-gray-700 mb-1.5 text-sm";
    const string fieldError = "block text-red-700 text-xs mt-1";
}

<input type="hidden" asp-for="Kind" />
<input type="hidden" asp-for="Id" />

<p class="font-bold text-base text-[#191c1d] mb-4 pb-2 border-b-2 border-gray-100">Thông tin @PriceKind.Label(Model.Kind).ToLower()</p>

@switch (Model.Kind)
{
    case PriceKind.Base:
        <div class="mb-4">
            <label asp-for="MovieId" class="@fieldLabel">Áp dụng cho phim</label>
            <select asp-for="MovieId" class="@fieldInput" asp-items="Model.MovieOptions">
                <option value="">— Áp dụng chung cho mọi phim —</option>
            </select>
            <span asp-validation-for="MovieId" class="@fieldError"></span>
        </div>
        <div class="mb-4">
            <label asp-for="BasePrice" class="@fieldLabel">Giá cơ bản (₫)</label>
            <input type="text" inputmode="numeric" autocomplete="off" placeholder="VD: 75.000"
                   data-money data-numeric-allow="." data-money-for="BasePrice" class="@fieldInput" />
            <input type="hidden" asp-for="BasePrice" asp-format="{0:0}" />
            <span asp-validation-for="BasePrice" class="@fieldError"></span>
        </div>
        break;

    case PriceKind.Room:
        <div class="mb-4">
            <label asp-for="RoomTypeId" class="@fieldLabel">Loại phòng</label>
            <select asp-for="RoomTypeId" class="@fieldInput" asp-items="Model.RoomTypeOptions">
                <option value="">— Chọn loại phòng —</option>
            </select>
            <span asp-validation-for="RoomTypeId" class="@fieldError"></span>
        </div>
        <div class="mb-4">
            <label asp-for="TypeSurcharge" class="@fieldLabel">Mức phụ thu (₫)</label>
            <input type="text" inputmode="numeric" autocomplete="off" placeholder="VD: 20.000"
                   data-money data-numeric-allow="." data-money-for="TypeSurcharge" class="@fieldInput" />
            <input type="hidden" asp-for="TypeSurcharge" asp-format="{0:0}" />
            <span asp-validation-for="TypeSurcharge" class="@fieldError"></span>
        </div>
        break;

    case PriceKind.Seat:
        <div class="mb-4">
            <label asp-for="SeatTypeId" class="@fieldLabel">Loại ghế</label>
            <select asp-for="SeatTypeId" class="@fieldInput" asp-items="Model.SeatTypeOptions">
                <option value="">— Chọn loại ghế —</option>
            </select>
            <span asp-validation-for="SeatTypeId" class="@fieldError"></span>
        </div>
        <div class="mb-4">
            <label asp-for="SeatSurcharge" class="@fieldLabel">Mức phụ thu (₫)</label>
            <input type="text" inputmode="numeric" autocomplete="off" placeholder="VD: 30.000"
                   data-money data-numeric-allow="." data-money-for="SeatSurcharge" class="@fieldInput" />
            <input type="hidden" asp-for="SeatSurcharge" asp-format="{0:0}" />
            <span asp-validation-for="SeatSurcharge" class="@fieldError"></span>
        </div>
        break;

    case PriceKind.Time:
        <div class="mb-4">
            <label asp-for="RuleGroup" class="@fieldLabel">Nhóm quy tắc</label>
            <select asp-for="RuleGroup" id="ruleGroup" class="@fieldInput">
                <option value="@PriceRuleGroup.Day">DAY — Theo loại ngày (thứ / ngày cụ thể)</option>
                <option value="@PriceRuleGroup.Time">TIME — Theo khung giờ trong ngày</option>
            </select>
            <span asp-validation-for="RuleGroup" class="@fieldError"></span>
        </div>

        <!-- Nhóm DAY -->
        <div data-rg="@PriceRuleGroup.Day">
            <div class="mb-4">
                <label asp-for="TimeCondition" class="@fieldLabel">Áp dụng theo</label>
                <select asp-for="TimeCondition" id="timeCondition" class="@fieldInput">
                    <option value="@PriceTimeCondition.DayOfWeek">Thứ trong tuần</option>
                    <option value="@PriceTimeCondition.SpecificDate">Ngày cụ thể (lễ, sự kiện)</option>
                </select>
                <span asp-validation-for="TimeCondition" class="@fieldError"></span>
            </div>

            <div class="mb-4" data-cond="@PriceTimeCondition.DayOfWeek">
                <label asp-for="DayOfWeek" class="@fieldLabel">Thứ trong tuần</label>
                <select asp-for="DayOfWeek" class="@fieldInput">
                    <option value="">— Chọn thứ —</option>
                    @for (int d = 1; d <= 7; d++)
                    {
                        <option value="@d">@PriceDayOfWeek.Label(d)</option>
                    }
                </select>
                <span asp-validation-for="DayOfWeek" class="@fieldError"></span>
            </div>

            <div class="mb-4" data-cond="@PriceTimeCondition.SpecificDate">
                <label asp-for="SpecificDate" class="@fieldLabel">Ngày cụ thể</label>
                <input asp-for="SpecificDate" type="date" asp-format="{0:yyyy-MM-dd}" class="@fieldInput" />
                <span asp-validation-for="SpecificDate" class="@fieldError"></span>
            </div>
        </div>

        <!-- Nhóm TIME (nhập khung giờ theo định dạng 24 giờ: HH:mm) -->
        <div data-rg="@PriceRuleGroup.Time">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="StartTime" class="@fieldLabel">Từ giờ (24h — HH:mm)</label>
                    <input asp-for="StartTime" type="text" asp-format="{0:HH:mm}" inputmode="numeric"
                           maxlength="5" placeholder="VD: 08:00" data-time24 data-numeric-allow=":"
                           pattern="([01][0-9]|2[0-3]):[0-5][0-9]" title="Nhập theo 24 giờ, ví dụ 18:30"
                           class="@fieldInput" />
                    <span asp-validation-for="StartTime" class="@fieldError"></span>
                </div>
                <div>
                    <label asp-for="EndTime" class="@fieldLabel">Đến giờ (24h — HH:mm)</label>
                    <input asp-for="EndTime" type="text" asp-format="{0:HH:mm}" inputmode="numeric"
                           maxlength="5" placeholder="VD: 22:00" data-time24 data-numeric-allow=":"
                           pattern="([01][0-9]|2[0-3]):[0-5][0-9]" title="Nhập theo 24 giờ, ví dụ 22:00"
                           class="@fieldInput" />
                    <span asp-validation-for="EndTime" class="@fieldError"></span>
                </div>
            </div>
            <p class="text-xs text-gray-500 -mt-2 mb-4">
                <strong>Qua đêm:</strong> nếu giờ kết thúc nhỏ hơn giờ bắt đầu (vd 22:00 → 02:00) thì hiểu là sang ngày hôm sau.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="TimeSurcharge" class="@fieldLabel">Mức phụ thu (₫)</label>
                <input type="text" inputmode="numeric" autocomplete="off" placeholder="VD: 15.000"
                       data-money data-numeric-allow="." data-money-for="TimeSurcharge" class="@fieldInput" />
                <input type="hidden" asp-for="TimeSurcharge" asp-format="{0:0}" />
                <span asp-validation-for="TimeSurcharge" class="@fieldError"></span>
            </div>
            <div>
                <label asp-for="Priority" class="@fieldLabel">Độ ưu tiên</label>
                <input asp-for="Priority" type="number" min="0" step="1" class="@fieldInput" />
                <span asp-validation-for="Priority" class="@fieldError"></span>
            </div>
        </div>
        break;
}

<p class="font-bold text-base text-[#191c1d] mb-4 mt-6 pb-2 border-b-2 border-gray-100">Thời điểm áp dụng</p>

<div class="mb-1">
    <label asp-for="EffectiveFrom" class="@fieldLabel">Áp dụng từ</label>
    @{ string? minDate = Model.Id == Guid.Empty ? DateTime.Today.ToString("yyyy-MM-dd") : null; }
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <input type="date" id="effFromDate" required min="@minDate" class="@fieldInput" />
        <input type="text" id="effFromTime" inputmode="numeric" maxlength="5" required
               placeholder="Giờ 24h — HH:mm" data-time24 data-numeric-allow=":"
               pattern="([01][0-9]|2[0-3]):[0-5][0-9]" title="Nhập giờ theo 24 giờ, ví dụ 14:30"
               class="@fieldInput" />
    </div>
    <!-- Field thật post lên server: ghép ngày + giờ 24h ở client. -->
    <input type="hidden" asp-for="EffectiveFrom" id="effFromHidden" asp-format="{0:yyyy-MM-ddTHH:mm}" />
    <p class="text-xs text-gray-500 mt-1">Có thể đặt ở tương lai để hẹn lịch đổi giá.</p>
    <span asp-validation-for="EffectiveFrom" class="@fieldError"></span>
</div>
