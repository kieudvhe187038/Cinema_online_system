@using Cinema_System.Application.Common
@model PriceManagementViewModel
@{
    ViewData["Title"] = "Quản Lý Giá Vé";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var tab = Model.ActiveTab;
    var tabs = new[]
    {
        (Kind: PriceKind.Base, Label: "Giá cơ bản",     Icon: "payments",      Count: Model.BaseCount),
        (Kind: PriceKind.Room, Label: "Phụ thu phòng",  Icon: "meeting_room",  Count: Model.RoomCount),
        (Kind: PriceKind.Seat, Label: "Phụ thu ghế",    Icon: "event_seat",    Count: Model.SeatCount),
        (Kind: PriceKind.Time, Label: "Phụ thu giờ",    Icon: "schedule",      Count: Model.TimeCount),
    };

    IReadOnlyList<Cinema_System.Application.DTOs.PriceConfigDTO> rows = tab switch
    {
        PriceKind.Room => Model.RoomConfigs,
        PriceKind.Seat => Model.SeatConfigs,
        PriceKind.Time => Model.TimeConfigs,
        _ => Model.BaseConfigs
    };

    bool isTime = tab == PriceKind.Time;
    string amountHeader = tab == PriceKind.Base ? "Giá cơ bản" : "Mức phụ thu";
    string targetHeader = tab switch
    {
        PriceKind.Base => "Áp dụng cho",
        PriceKind.Room => "Loại phòng",
        PriceKind.Seat => "Loại ghế",
        _ => "Điều kiện áp dụng"
    };

    (string Cls, string Dot, string Text) StatusBadge(string s) => s switch
    {
        PriceDisplayStatus.Scheduled => ("bg-blue-100 text-blue-700", "bg-blue-500", "Sắp áp dụng"),
        PriceDisplayStatus.Expired   => ("bg-gray-100 text-gray-600", "bg-gray-400", "Đã hết hạn"),
        PriceDisplayStatus.Cancelled => ("bg-rose-100 text-rose-700", "bg-rose-500", "Đã ngừng"),
        _                            => ("bg-green-100 text-green-700", "bg-green-600", "Đang áp dụng"),
    };
}

<div class="flex justify-between items-start mb-6 gap-4 flex-wrap">
    <div>
        <h1 class="font-head text-2xl font-extrabold text-[#191c1d] mb-0.5">Quản lý giá vé</h1>
        <p class="text-sm text-gray-500">Cấu hình giá cơ bản và các mức phụ thu (phòng, ghế, khung giờ). Giá vé = giá cơ bản + các phụ thu đang hiệu lực.</p>
    </div>
    <a class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg text-xs font-bold tracking-wide whitespace-nowrap transition-colors"
       href="@Url.Action("Create", "ManagerPrice", new { kind = tab })">
        <span class="material-symbols-outlined" style="font-size:18px">add_circle</span>
        THÊM @($"{PriceKind.Label(tab)}".ToUpperInvariant())
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="px-4 py-3 rounded-lg mb-4 text-sm bg-green-50 text-green-700 border border-green-200">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="px-4 py-3 rounded-lg mb-4 text-sm bg-red-50 text-red-700 border border-red-200">@TempData["Error"]</div>
}

<!-- Tabs -->
<div class="flex gap-1.5 mb-5 flex-wrap">
    @foreach (var t in tabs)
    {
        var active = t.Kind == tab;
        <a href="@Url.Action("Index", "ManagerPrice", new { tab = t.Kind })"
           class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold border transition-colors @(active ? "bg-secondary text-white border-secondary" : "bg-white text-gray-600 border-[#e8eaed] hover:border-secondary hover:text-secondary")">
            <span class="material-symbols-outlined" style="font-size:18px">@t.Icon</span>
            @t.Label
            <span class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full text-xs font-bold @(active ? "bg-white/25 text-white" : "bg-gray-100 text-gray-600")">@t.Count</span>
        </a>
    }
</div>

<div class="bg-white rounded-xl border border-[#e8eaed] overflow-x-auto mb-5">
    @if (rows.Any())
    {
        <table class="w-full border-collapse">
            <thead>
                <tr class="bg-gray-900">
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">@targetHeader</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">@amountHeader</th>
                    @if (isTime)
                    {
                        <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Ưu tiên</th>
                    }
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Áp dụng</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Trạng thái</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in rows)
                {
                    var badge = StatusBadge(item.DisplayStatus);
                    var canModify = PriceDisplayStatus.CanModify(item.DisplayStatus);
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <div class="font-semibold text-[#191c1d]">@item.TargetName</div>
                            @if (isTime)
                            {
                                <div class="text-xs text-gray-500">@PriceRuleGroup.Label(item.RuleGroup)</div>
                            }
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <span class="font-bold text-primary whitespace-nowrap">
                                @(tab == PriceKind.Base ? "" : "+ ")@item.Amount.ToString("N0") ₫
                            </span>
                        </td>
                        @if (isTime)
                        {
                            <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">@item.Priority</td>
                        }
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle whitespace-nowrap">
                            <div class="text-xs text-gray-600">Từ @item.EffectiveFrom.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="text-xs text-gray-400">@(item.EffectiveTo.HasValue ? "đến " + item.EffectiveTo.Value.ToString("dd/MM/yyyy HH:mm") : "không giới hạn")</div>
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap @badge.Cls">
                                <span class="w-[7px] h-[7px] rounded-full shrink-0 @badge.Dot"></span>
                                @badge.Text
                            </span>
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <div class="flex items-center gap-1.5">
                                @if (canModify)
                                {
                                    <a class="w-8 h-8 rounded-md flex items-center justify-center bg-gray-100 text-amber-500 hover:bg-amber-100 transition-colors"
                                       href="@Url.Action("Edit", "ManagerPrice", new { kind = item.Kind, id = item.Id })" title="Chỉnh sửa">
                                        <span class="material-symbols-outlined" style="font-size:18px">edit</span>
                                    </a>

                                    <form method="post"
                                          action="@Url.Action("Delete", "ManagerPrice", new { kind = item.Kind, id = item.Id })"
                                          class="inline"
                                          data-confirm="Ngừng áp dụng cấu hình giá '@item.TargetName'? Hệ thống sẽ đặt ngày kết thúc cho mức giá này (KHÔNG xóa khỏi dữ liệu) và mức giá liền trước sẽ tự kéo dài để lấp khoảng trống."
                                          data-confirm-title="Ngừng áp dụng giá" data-confirm-type="warning" data-confirm-ok="Ngừng áp dụng">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-8 h-8 rounded-md flex items-center justify-center bg-gray-100 text-rose-500 hover:bg-rose-100 transition-colors" title="Ngừng áp dụng">
                                            <span class="material-symbols-outlined" style="font-size:18px">event_busy</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400 italic">Chỉ xem</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-16 px-8 text-gray-400 text-sm">
            <span class="material-symbols-outlined block mb-3" style="font-size:48px">payments</span>
            Chưa có cấu hình @PriceKind.Label(tab).ToLower() nào. Bấm “Thêm” để tạo mới.
        </div>
    }
</div>

@{
    var pager = new Cinema_System.Application.ViewModels.PaginationViewModel
    {
        CurrentPage = Model.CurrentPage,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        Controller = "ManagerPrice",
        ItemLabel = "cấu hình giá",
        RouteValues = new Dictionary<string, string?> { ["tab"] = tab }
    };
}
<partial name="_Pagination" model="pager" />

