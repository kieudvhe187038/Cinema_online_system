@using Cinema_System.Application.Common
@model Cinema_System.Application.Common.PagedResult<Cinema_System.Application.DTOs.RoomDTO>
@{
    ViewData["Title"] = "Quản Lý Phòng Chiếu";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    (string cls, string dot, string text) StatusBadge(string? s) => s switch
    {
        RoomStatus.Active => ("bg-green-100 text-green-700", "bg-green-600", "Đang hoạt động"),
        RoomStatus.Maintenance => ("bg-amber-100 text-amber-700", "bg-amber-500", "Bảo trì"),
        RoomStatus.Inactive => ("bg-gray-100 text-gray-600", "bg-gray-400", "Ngừng dùng"),
        _ => ("bg-gray-100 text-gray-600", "bg-gray-400", s ?? "—")
    };
}

<div class="flex justify-between items-start mb-6 gap-4 flex-wrap">
    <div>
        <h1 class="font-head text-2xl font-extrabold text-[#191c1d] mb-0.5">Danh sách phòng chiếu</h1>
        <p class="text-sm text-gray-500">Quản lý phòng và bố trí sơ đồ ghế cho rạp</p>
    </div>
    <a class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg text-xs font-bold tracking-wide whitespace-nowrap transition-colors"
       href="@Url.Action("Create", "ManagerRoom")">
        <span class="material-symbols-outlined" style="font-size:18px">add_circle</span>
        THÊM PHÒNG MỚI
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="px-4 py-3 rounded-lg mb-4 text-sm bg-green-50 text-green-700 border border-green-200">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="px-4 py-3 rounded-lg mb-4 text-sm bg-red-50 text-red-700 border border-red-200">@TempData["Error"]</div>
}

<div class="bg-white rounded-xl border border-[#e8eaed] overflow-x-auto mb-5">
    @if (Model.Items.Any())
    {
        <table class="w-full border-collapse">
            <thead>
                <tr class="bg-gray-900">
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Tên Phòng</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Loại Phòng</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Kích Thước</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Số Ghế</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Trạng Thái</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase whitespace-nowrap">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var badge = StatusBadge(item.Status);
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <span class="font-bold text-[#191c1d]">@item.Name</span>
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <span class="inline-block bg-secondary/5 text-secondary border border-secondary/20 rounded-md px-2.5 py-1 text-xs font-semibold">@item.RoomTypeName</span>
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle whitespace-nowrap text-gray-600">
                            @item.TotalRow hàng × @item.TotalColumns cột
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle whitespace-nowrap">
                            @if (item.SeatCount > 0)
                            {
                                <span class="font-semibold text-[#191c1d]">@item.SeatCount ghế</span>
                            }
                            else
                            {
                                <span class="text-amber-600 text-xs font-semibold">Chưa bố trí</span>
                            }
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap @badge.cls">
                                <span class="w-[7px] h-[7px] rounded-full shrink-0 @badge.dot"></span>
                                @badge.text
                            </span>
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <div class="flex items-center gap-1.5">
                                <a class="w-8 h-8 rounded-md flex items-center justify-center bg-gray-100 text-amber-500 hover:bg-amber-100 transition-colors"
                                   href="@Url.Action("Edit", "ManagerRoom", new { id = item.Id })" title="Sửa phòng & bố trí ghế">
                                    <span class="material-symbols-outlined" style="font-size:18px">edit</span>
                                </a>
                                @if (!item.HasShowtimes && !item.HasBookedTickets)
                                {
                                    <form method="post"
                                          action="@Url.Action("Delete", "ManagerRoom", new { id = item.Id })"
                                          class="inline"
                                          data-confirm="Xóa phòng '@item.Name' và toàn bộ ghế của phòng? Hành động này KHÔNG thể hoàn tác."
                                          data-confirm-title="Xóa phòng" data-confirm-type="danger" data-confirm-ok="Xóa phòng">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-8 h-8 rounded-md flex items-center justify-center bg-gray-100 text-red-500 hover:bg-red-100 transition-colors" title="Xóa phòng">
                                            <span class="material-symbols-outlined" style="font-size:18px">delete</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="w-8 h-8 rounded-md flex items-center justify-center bg-gray-100 text-gray-300 cursor-not-allowed"
                                            title="Phòng đang có suất chiếu / vé đặt nên không thể xóa" disabled>
                                        <span class="material-symbols-outlined" style="font-size:18px">delete</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-16 px-8 text-gray-400 text-sm">
            <span class="material-symbols-outlined block mb-3" style="font-size:48px">meeting_room</span>
            Chưa có phòng chiếu nào. Bấm "Thêm phòng mới" để tạo.
        </div>
    }
</div>

@{
    var pager = new Cinema_System.Application.ViewModels.PaginationViewModel
    {
        CurrentPage = Model.CurrentPage,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        Controller = "ManagerRoom",
        ItemLabel = "phòng"
    };
}
<partial name="_Pagination" model="pager" />

<partial name="_ConfirmModal" />
