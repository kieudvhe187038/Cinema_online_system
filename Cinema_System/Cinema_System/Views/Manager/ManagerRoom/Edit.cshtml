@model Cinema_System.Application.ViewModels.RoomFormViewModel
@{
    ViewData["Title"] = "Sửa Phòng Chiếu";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div>
    <div class="flex items-center gap-2 mb-6">
        <a href="@Url.Action("Index", "ManagerRoom")" class="text-gray-400 hover:text-primary transition-colors">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h1 class="font-head text-2xl font-extrabold text-[#191c1d]">Sửa phòng chiếu</h1>
    </div>

    <form method="post" id="roomForm" action="@Url.Action("Edit", "ManagerRoom", new { id = Model.Id })">
        @Html.AntiForgeryToken()

        <div class="bg-white rounded-xl border border-[#e8eaed] p-6 mb-5">
            <partial name="_RoomFormFields" model="Model" />
        </div>

        <div class="bg-white rounded-xl border border-[#e8eaed] p-6 mb-5">
            <partial name="_SeatDesigner" model="Model" />
        </div>

        <div class="flex gap-3">
            <button type="submit" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg text-sm font-bold transition-colors">
                <span class="material-symbols-outlined" style="font-size:18px">save</span>
                Lưu thay đổi
            </button>
            <a href="@Url.Action("Index", "ManagerRoom")" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-[#191c1d] rounded-lg text-sm font-semibold transition-colors">Hủy</a>
        </div>
    </form>
</div>

<partial name="_ConfirmModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
