@using Cinema_System.Application.Common
@model PagedResult<Cinema_System.Application.ViewModels.GenreListItemViewModel>
@{
    ViewData["Title"] = "Quản Lý Thể Loại Phim";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    var search = ViewData["Search"] as string;
}

<div class="flex justify-between items-start mb-6 gap-4 flex-wrap">
    <div>
        <h1 class="font-head text-2xl font-extrabold text-[#191c1d] mb-0.5">Danh sách thể loại phim</h1>
        <p class="text-sm text-gray-500">Quản lý thể loại để phân loại phim</p>
    </div>
    <a class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg text-xs font-bold tracking-wide whitespace-nowrap transition-colors"
       href="@Url.Action("Create", "ManagerGenre")">
        <span class="material-symbols-outlined" style="font-size:18px">add_circle</span>
        THÊM THỂ LOẠI
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="px-4 py-3 rounded-lg mb-4 text-sm bg-green-50 text-green-700 border border-green-200">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="px-4 py-3 rounded-lg mb-4 text-sm bg-red-50 text-red-700 border border-red-200">@TempData["Error"]</div>
}

<!-- Tìm kiếm (giữ nguyên khi phân trang qua RouteValues) -->
<form method="get" action="@Url.Action("Index", "ManagerGenre")" class="flex items-center gap-2 mb-5 flex-wrap">
    <div class="relative flex-1 min-w-[220px] max-w-sm">
        <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400" style="font-size:20px">search</span>
        <input type="text" name="search" value="@search" placeholder="Tìm thể loại theo tên…"
               class="w-full pl-10 pr-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />
    </div>
    <button type="submit" class="px-5 py-2.5 bg-gray-900 hover:bg-gray-800 text-white rounded-lg text-xs font-bold tracking-wide transition-colors">TÌM KIẾM</button>
    @if (!string.IsNullOrEmpty(search))
    {
        <a href="@Url.Action("Index", "ManagerGenre")" class="text-sm text-gray-500 hover:text-primary">Xóa lọc</a>
    }
</form>

<div class="bg-white rounded-xl border border-[#e8eaed] overflow-x-auto mb-5">
    @if (Model.Items.Any())
    {
        <table class="w-full border-collapse">
            <thead>
                <tr class="bg-gray-900">
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase">Tên Thể Loại</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase">Số Phim</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase">Trạng Thái</th>
                    <th class="px-4 py-3.5 text-left text-gray-300 text-xs font-bold tracking-wide uppercase">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <span class="inline-flex items-center gap-2 font-bold text-[#191c1d]">
                                <span class="material-symbols-outlined text-primary" style="font-size:20px">local_movies</span>
                                @item.Name
                            </span>
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle text-gray-600">@item.MovieCount phim</td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            @if (item.InUse)
                            {
                                <span class="inline-block bg-[#fff2e8] text-primary-dark rounded-full px-3 py-1 text-xs font-semibold">Đang sử dụng</span>
                            }
                            else
                            {
                                <span class="inline-block bg-gray-100 text-gray-500 rounded-full px-3 py-1 text-xs font-semibold">Chưa dùng</span>
                            }
                        </td>
                        <td class="px-4 py-3.5 border-b border-gray-100 text-sm align-middle">
                            <div class="flex items-center gap-1.5">
                                <a class="w-8 h-8 rounded-md flex items-center justify-center bg-gray-100 text-amber-500 hover:bg-amber-100 transition-colors"
                                   href="@Url.Action("Edit", "ManagerGenre", new { id = item.Id })" title="Sửa thể loại">
                                    <span class="material-symbols-outlined" style="font-size:18px">edit</span>
                                </a>
                                @if (!item.InUse)
                                {
                                    <form method="post" action="@Url.Action("Delete", "ManagerGenre", new { id = item.Id })" class="inline"
                                          data-confirm="Xóa thể loại '@item.Name'? Hành động này không thể hoàn tác."
                                          data-confirm-title="Xóa thể loại" data-confirm-type="danger" data-confirm-ok="Xóa">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-8 h-8 rounded-md flex items-center justify-center bg-gray-100 text-red-500 hover:bg-red-100 transition-colors" title="Xóa thể loại">
                                            <span class="material-symbols-outlined" style="font-size:18px">delete</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="w-8 h-8 rounded-md flex items-center justify-center bg-gray-100 text-gray-300 cursor-not-allowed"
                                            title="Thể loại đang được gán cho phim nên không thể xóa" disabled>
                                        <span class="material-symbols-outlined" style="font-size:18px">delete</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-16 px-8 text-gray-400 text-sm">
            <span class="material-symbols-outlined block mb-3" style="font-size:48px">category</span>
            @(string.IsNullOrEmpty(search)
                ? "Chưa có thể loại nào. Bấm \"Thêm thể loại\" để tạo."
                : $"Không tìm thấy thể loại nào khớp với \"{search}\".")
        </div>
    }
</div>

@{
    var pager = new Cinema_System.Application.ViewModels.PaginationViewModel
    {
        CurrentPage = Model.CurrentPage,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        Controller = "ManagerGenre",
        ItemLabel = "thể loại",
        RouteValues = new Dictionary<string, string?> { ["search"] = search }
    };
}
<partial name="_Pagination" model="pager" />
