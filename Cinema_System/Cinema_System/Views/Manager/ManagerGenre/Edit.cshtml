@model Cinema_System.Application.ViewModels.GenreFormViewModel
@{
    ViewData["Title"] = "Sửa Thể Loại Phim";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="max-w-lg mx-auto mb-12">
    <h1 class="font-head text-2xl font-extrabold text-[#191c1d] mb-6">Sửa Thể Loại Phim</h1>

    <div class="bg-white rounded-xl border border-[#e8eaed] p-7">
        <form method="post" action="@Url.Action("Edit", "ManagerGenre", new { id = Model.Id })">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-4"></div>

            <div class="mb-3">
                <label asp-for="Name" class="block text-sm font-semibold text-gray-600 mb-1.5">Tên thể loại</label>
                <input asp-for="Name"
                       class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />
                <span asp-validation-for="Name" class="block text-xs text-red-600 mt-1"></span>
            </div>

            @if (Model.InUse)
            {
                <p class="text-xs text-amber-600 mb-4 flex items-center gap-1">
                    <span class="material-symbols-outlined" style="font-size:16px">info</span>
                    Thể loại đang được gán cho phim — đổi tên được, nhưng không xóa được.
                </p>
            }

            <div class="flex gap-3 mt-6">
                <button type="submit" class="px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg text-sm font-semibold transition-colors">Lưu thay đổi</button>
                <a href="@Url.Action("Index", "ManagerGenre")" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-semibold transition-colors">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
