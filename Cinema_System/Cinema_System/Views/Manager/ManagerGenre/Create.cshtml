@model GenreFormViewModel
@{
    ViewData["Title"] = "Thêm Thể Loại Phim";
    Layout = "_ManagerLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .gf-wrap { max-width: 520px; margin: 0 auto 3rem; padding: 0; }
        .gf-title { font-family: var(--font-head); font-size: 1.6rem; font-weight: 800; color: var(--on-surface); margin-bottom: 1.5rem; }
        .gf-card { background: var(--white); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); padding: 1.75rem; }
        .gf-field { margin-bottom: 1.1rem; }
        .gf-field label { display: block; font-weight: 600; color: var(--on-surface-variant); margin-bottom: .4rem; font-size: .9rem; }
        .gf-field input { width: 100%; padding: .6rem .8rem; border: 1px solid var(--outline-variant); border-radius: var(--radius); background: var(--white); font-family: var(--font-body); }
        .gf-field input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(243,112,33,.15); }
        .gf-hint { color: var(--on-surface-variant); font-size: .82rem; margin-top: .35rem; }
        .gf-error { color: #b91c1c; font-size: .82rem; margin-top: .3rem; display: block; }
        .gf-summary { color: #b91c1c; font-size: .9rem; margin-bottom: 1rem; }
        .gf-actions { display: flex; gap: .75rem; margin-top: 1.5rem; }
        .gf-btn { padding: .6rem 1.3rem; border: none; border-radius: var(--radius); font-weight: 600; cursor: pointer; font-family: var(--font-body); text-decoration: none; display: inline-flex; align-items: center; }
        .gf-btn-primary { background: var(--primary); color: var(--white); }
        .gf-btn-primary:hover { background: var(--primary-dark); }
        .gf-btn-ghost { background: var(--surface-container); color: var(--on-surface); }
    </style>
}

<div class="gf-wrap">
    <h1 class="gf-title">Thêm Thể Loại Phim</h1>

    <div class="gf-card">
        <form method="post" action="@Url.Action("Create", "ManagerGenre")">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="gf-summary"></div>

            <div class="gf-field">
                <label asp-for="Name"></label>
                <input asp-for="Name" placeholder="VD: Hành động, Tình cảm, Kinh dị, Hoạt hình" autocomplete="off" />
                <span asp-validation-for="Name" class="gf-error"></span>
                <p class="gf-hint">Tên thể loại từ 2 đến 100 ký tự, không được trùng thể loại đã có.</p>
            </div>

            <div class="gf-actions">
                <button type="submit" class="gf-btn gf-btn-primary">Thêm mới</button>
                <a class="gf-btn gf-btn-ghost" href="@Url.Action("Index", "ManagerGenre")">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
