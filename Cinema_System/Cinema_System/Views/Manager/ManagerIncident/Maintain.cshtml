@model Cinema_System.Application.ViewModels.MaintainRoomViewModel
@{
    ViewData["Title"] = "Bảo trì phòng theo lịch";
    Layout = "_ManagerLayout";
    var minNow = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<div class="mb-5">
    <a asp-action="Index" class="inline-flex items-center gap-1 text-sm font-semibold text-secondary hover:underline">
        <span class="material-symbols-outlined text-base">arrow_back</span> Về danh sách
    </a>
</div>

<div class="mx-auto max-w-2xl rounded-2xl bg-white p-7 shadow-sm">
    <h1 class="font-head text-xl font-bold text-secondary-dark">Bảo trì phòng theo lịch</h1>
    <p class="mb-6 text-sm text-gray-500">Hệ thống sẽ HỦY mọi suất chiếu của phòng trong khoảng thời gian đã chọn và hoàn điểm cho khách đã thanh toán.</p>

    <div asp-validation-summary="All" class="mb-4 text-sm text-red-600"></div>

    <form asp-action="Maintain" method="post" class="space-y-5">
        @Html.AntiForgeryToken()

        <div>
            <label class="mb-1 block text-sm font-semibold text-secondary-dark">Phòng <span class="text-red-500">*</span></label>
            <select asp-for="RoomId" asp-items="Model.RoomOptions"
                    class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none">
                <option value="">-- Chọn phòng --</option>
            </select>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
                <label class="mb-1 block text-sm font-semibold text-secondary-dark">Từ thời điểm <span class="text-red-500">*</span></label>
                <input asp-for="FromTime" type="datetime-local" min="@minNow" asp-format="{0:yyyy-MM-ddTHH:mm}"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-semibold text-secondary-dark">Đến thời điểm <span class="text-red-500">*</span></label>
                <input asp-for="ToTime" type="datetime-local" min="@minNow" asp-format="{0:yyyy-MM-ddTHH:mm}"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none" />
            </div>
        </div>

        <div>
            <label class="mb-1 block text-sm font-semibold text-secondary-dark">Lý do bảo trì <span class="text-red-500">*</span></label>
            <textarea asp-for="Description" rows="3" maxlength="500"
                      placeholder="VD: Bảo trì hệ thống âm thanh phòng..."
                      class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none"></textarea>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
                <label class="mb-1 block text-sm font-semibold text-secondary-dark">Hệ số hoàn điểm (0 – 5)</label>
                <input asp-for="RefundPointsRate" type="number" step="0.1" min="0" max="5"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-semibold text-secondary-dark">Voucher bồi thường (tùy chọn)</label>
                <select asp-for="CompensationPromoId" asp-items="Model.PromoOptions"
                        class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none">
                    <option value="">-- Không gán voucher --</option>
                </select>
            </div>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-white hover:bg-primary-dark transition">
                <span class="material-symbols-outlined">build</span> Xác nhận bảo trì
            </button>
            <a asp-action="Index" class="rounded-xl border border-gray-300 px-6 py-3 font-semibold text-gray-600 hover:bg-gray-50 transition">Hủy</a>
        </div>
    </form>
</div>
