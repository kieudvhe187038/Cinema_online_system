@model Cinema_System.Application.ViewModels.DeclareIncidentViewModel
@{
    ViewData["Title"] = "Khai báo sự cố";
    Layout = "_ManagerLayout";
}

<div class="mb-5">
    <a asp-action="Index" class="inline-flex items-center gap-1 text-sm font-semibold text-secondary hover:underline">
        <span class="material-symbols-outlined text-base">arrow_back</span> Về danh sách
    </a>
</div>

<div class="mx-auto max-w-2xl rounded-2xl bg-white p-7 shadow-sm">
    <h1 class="font-head text-xl font-bold text-secondary-dark">Khai báo sự cố suất chiếu</h1>
    <p class="mb-6 text-sm text-gray-500">Hệ thống sẽ hoàn điểm cho mọi khách đã thanh toán suất này theo hệ số bồi thường.</p>

    <div asp-validation-summary="All" class="mb-4 text-sm text-red-600"></div>

    <form asp-action="Declare" method="post" class="space-y-5">
        @Html.AntiForgeryToken()

        <div>
            <label class="mb-1 block text-sm font-semibold text-secondary-dark">Suất chiếu <span class="text-red-500">*</span></label>
            @* Combobox gõ để tìm suất chiếu (phim/phòng/giờ): ô text lọc + input hidden giữ ShowtimeId thật để submit. *@
            @{ var selectedShowtime = Model.ShowtimeOptions.FirstOrDefault(o => o.Value == Model.ShowtimeId?.ToString()); }
            <div class="relative" data-combobox="showtime">
                <input type="text" data-combobox-input autocomplete="off" placeholder="Gõ tên phim / phòng để tìm suất chiếu..."
                       value="@selectedShowtime?.Text"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none" />
                <input type="hidden" asp-for="ShowtimeId" data-combobox-value />
                <div class="absolute z-20 mt-1 hidden max-h-60 w-full overflow-y-auto rounded-lg border border-gray-200 bg-white shadow-lg" data-combobox-list>
                    @foreach (var opt in Model.ShowtimeOptions)
                    {
                        <div class="cursor-pointer px-3 py-2 text-sm hover:bg-primary/10" data-combobox-option data-id="@opt.Value" data-name="@opt.Text">@opt.Text</div>
                    }
                </div>
                @if (!Model.ShowtimeOptions.Any())
                {
                    <p class="mt-1 text-xs text-gray-400">Không có suất chiếu khả dụng để khai báo sự cố.</p>
                }
            </div>
        </div>

        <div>
            <label class="mb-1 block text-sm font-semibold text-secondary-dark">Mô tả sự cố <span class="text-red-500">*</span></label>
            <textarea asp-for="Description" rows="3" maxlength="500"
                      placeholder="VD: Mất điện 20 phút giữa suất chiếu..."
                      class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none"></textarea>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
                <label class="mb-1 block text-sm font-semibold text-secondary-dark">Hệ số hoàn điểm (0 – 5)</label>
                <input asp-for="RefundPointsRate" type="number" step="0.1" min="0" max="5"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none" />
                <p class="mt-1 text-xs text-gray-400">Điểm hoàn = tiền vé × tỉ lệ tích điểm × hệ số này.</p>
            </div>
            <div>
                <label class="mb-1 block text-sm font-semibold text-secondary-dark">Voucher bồi thường (tùy chọn)</label>
                <select asp-for="CompensationPromoId" asp-items="Model.PromoOptions"
                        class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-primary focus:outline-none">
                    <option value="">-- Không gán voucher --</option>
                </select>
            </div>
        </div>

        <div>
            <label class="flex items-center gap-2 text-sm text-gray-700">
                <input asp-for="CancelShowtime" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
                Hủy suất chiếu này (đổi trạng thái sang "Đã hủy")
            </label>
            <p class="mt-1 pl-6 text-xs text-gray-400">
                Khi hủy, hệ thống sẽ gửi email báo <strong>lý do</strong> (chính là phần "Mô tả sự cố" ở trên) tới toàn bộ khách đã thanh toán suất này.
            </p>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-white hover:bg-primary-dark transition">
                <span class="material-symbols-outlined">check</span> Xác nhận khai báo
            </button>
            <a asp-action="Index" class="rounded-xl border border-gray-300 px-6 py-3 font-semibold text-gray-600 hover:bg-gray-50 transition">Hủy</a>
        </div>
    </form>
</div>

<script>
    // Combobox tìm suất chiếu: ô text để gõ lọc + input hidden giữ ShowtimeId thật để submit/validate.
    document.querySelectorAll('[data-combobox]').forEach(function (box) {
        var input = box.querySelector('[data-combobox-input]');
        var hidden = box.querySelector('[data-combobox-value]');
        var list = box.querySelector('[data-combobox-list]');
        var options = Array.prototype.slice.call(box.querySelectorAll('[data-combobox-option]'));

        // Khớp KHÔNG DẤU: gõ "bi" vẫn thấy "Bí Mật Phố Cổ" (xem wwwroot/js/vietnamese-text.js).
        function filter() {
            var keyword = VietnameseText.searchKey(input.value);
            options.forEach(function (opt) {
                opt.classList.toggle('hidden', !VietnameseText.contains(opt.dataset.name, keyword));
            });
        }
        function open() { filter(); list.classList.remove('hidden'); }
        function close() {
            list.classList.add('hidden');
            // Rời ô mà không chọn lại: khôi phục tên theo giá trị hidden hiện có.
            var selected = options.find(function (opt) { return opt.dataset.id === hidden.value; });
            input.value = selected ? selected.dataset.name : '';
        }

        input.addEventListener('focus', open);
        input.addEventListener('input', open);
        options.forEach(function (opt) {
            opt.addEventListener('mousedown', function (e) {
                e.preventDefault(); // giữ focus để 'blur' không chạy trước khi gán giá trị
                hidden.value = opt.dataset.id;
                input.value = opt.dataset.name;
                close();
            });
        });
        input.addEventListener('blur', close);
    });
</script>