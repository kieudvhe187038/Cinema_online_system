@model Cinema_System.Application.ViewModels.PointHistoryPageViewModel
@{
    ViewData["Title"] = "Lịch sử điểm";
    ViewData["Heading"] = "Lịch sử điểm";
    ViewData["UserName"] = User.Identity?.Name;
    Layout = "_CineStarLayout";
}

<p class="-mt-2 mb-5 text-sm text-gray-500">Chào mừng trở lại, <span class="font-semibold text-tertiary">@User.Identity?.Name</span></p>

<!-- ===== Hàng trên: Tổng điểm (cam) + Đổi quà ===== -->
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- Tổng điểm -->
    <div class="lg:col-span-2 rounded-2xl bg-gradient-to-br from-primary to-primary-dark p-6 text-white shadow-lg">
        <p class="text-sm font-medium uppercase tracking-wide text-white/80">Tổng điểm hiện có</p>
        <p class="mt-1 font-heading text-5xl font-extrabold">
            @Model.CurrentPoints.ToString("#,##0") <span class="text-xl font-bold">C-POINTS</span>
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
            <div class="rounded-lg bg-white/15 px-4 py-2">
                <p class="text-[11px] uppercase tracking-wide text-white/70">Tổng giao dịch</p>
                <p class="font-bold">@Model.TotalItems</p>
            </div>
            @if (Model.PointValueVnd > 0)
            {
                <div class="rounded-lg bg-white/15 px-4 py-2">
                    <p class="text-[11px] uppercase tracking-wide text-white/70">Quy đổi được</p>
                    <p class="font-bold">@Model.CurrentPointsValueVnd.ToString("#,##0")đ</p>
                </div>
            }
        </div>
    </div>

    <!-- Chính sách điểm đang áp dụng (Manager cấu hình, dùng chung cho online & tại quầy) -->
    <div class="flex flex-col justify-center rounded-2xl bg-white p-6 shadow-md">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
        </div>
        <h3 class="mt-3 font-bold font-heading text-tertiary">Cách dùng điểm</h3>
        <ul class="mt-2 space-y-1.5 text-sm text-gray-600">
            @if (Model.VndPerPoint > 0)
            {
                <li>• Tích điểm: mỗi <strong>@Model.VndPerPoint.ToString("#,##0")đ</strong> chi tiêu được <strong>1 điểm</strong>.</li>
            }
            else
            {
                <li>• Hiện chưa áp dụng tích điểm.</li>
            }
            @if (Model.PointValueVnd > 0)
            {
                <li>• Dùng điểm: <strong>1 điểm = @Model.PointValueVnd.ToString("#,##0")đ</strong> khi thanh toán.</li>
            }
            <li>• Áp dụng cho cả đặt vé online và mua vé tại quầy.</li>
        </ul>
    </div>
</div>

<!-- ===== Bảng giao dịch ===== -->
<div class="mt-6 rounded-2xl bg-white p-6 shadow-md">
    <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-bold font-heading text-tertiary">Giao dịch gần đây</h3>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <p class="py-8 text-center text-gray-500">Chưa có giao dịch điểm nào.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b text-left text-xs uppercase tracking-wide text-gray-400">
                        <th class="py-3 font-semibold">Ngày giao dịch</th>
                        <th class="py-3 font-semibold">Nội dung</th>
                        <th class="py-3 text-right font-semibold">Số điểm</th>
                        <th class="py-3 text-center font-semibold">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="border-b border-gray-50">
                            <td class="py-4 align-top">
                                <p class="font-medium text-tertiary">@item.CreatedAt?.ToString("dd/MM/yyyy")</p>
                                <p class="text-xs text-gray-400">@item.CreatedAt?.ToString("HH:mm")</p>
                            </td>
                            <td class="py-4 align-top">
                                <p class="font-semibold text-tertiary">@item.ActionLabel</p>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="desc-text text-xs text-gray-400 line-clamp-2 cursor-pointer transition-all"
                                       onclick="this.classList.toggle('line-clamp-2')"
                                       title="Bấm để xem đầy đủ">
                                        @item.Description
                                    </p>
                                }
                                else
                                {
                                    <p class="text-xs text-gray-400">-</p>
                                }
                            </td>
                            <td class="py-4 text-right align-top font-bold @(item.IsPositive ? "text-green-600" : "text-primary")">
                                @item.PointsDisplay
                            </td>
                            <td class="py-4 text-center align-top">
                                <span class="rounded-full px-3 py-1 text-xs font-semibold @item.StatusClass">@item.StatusLabel</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Phân trang gọn dạng "…" (chỉ hiện trang 1, cuối, và quanh trang hiện tại) *@
        @if (Model.TotalPages > 1)
        {
            var total = Model.TotalPages;
            var cur = Model.CurrentPage;
            var show = new SortedSet<int> { 1, total };
            for (int p = cur - 1; p <= cur + 1; p++) { if (p >= 1 && p <= total) show.Add(p); }

            <div class="mt-6 flex items-center justify-center gap-1.5">
                @if (cur > 1)
                {
                    <a asp-action="PointHistory" asp-route-page="@(cur - 1)" class="rounded-lg border border-gray-300 px-2.5 py-1 text-sm text-gray-600 hover:bg-gray-100">‹</a>
                }
                else
                {
                    <span class="rounded-lg border border-gray-200 px-2.5 py-1 text-sm text-gray-300">‹</span>
                }

                @{ int prev = 0; }
                @foreach (var p in show)
                {
                    if (prev != 0 && p - prev > 1)
                    {
                        <span class="px-1 text-gray-400">…</span>
                    }
                    if (p == cur)
                    {
                        <span class="rounded-lg bg-primary px-3 py-1 text-sm font-semibold text-white">@p</span>
                    }
                    else
                    {
                        <a asp-action="PointHistory" asp-route-page="@p" class="rounded-lg border border-gray-300 px-3 py-1 text-sm text-gray-600 hover:bg-primary hover:text-white hover:border-primary">@p</a>
                    }
                    prev = p;
                }

                @if (cur < total)
                {
                    <a asp-action="PointHistory" asp-route-page="@(cur + 1)" class="rounded-lg border border-gray-300 px-2.5 py-1 text-sm text-gray-600 hover:bg-gray-100">›</a>
                }
                else
                {
                    <span class="rounded-lg border border-gray-200 px-2.5 py-1 text-sm text-gray-300">›</span>
                }
            </div>
        }
    }
</div>
