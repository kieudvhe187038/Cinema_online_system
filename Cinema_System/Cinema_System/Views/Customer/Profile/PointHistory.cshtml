@model Cinema_System.Application.ViewModels.PointHistoryPageViewModel
@{
    ViewData["Title"] = "Lịch sử điểm";
}

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script>
    tailwind.config = {
        important: true,
        theme: {
            extend: {
                colors: {
                    primary: '#F37021', 'primary-dark': '#d85f15',
                    secondary: '#00488D',
                    tertiary: '#002F59',
                    light: '#F8F9FA',
                },
                fontFamily: {
                    heading: ['"Plus Jakarta Sans"', 'sans-serif'],
                    body: ['"Be Vietnam Pro"', 'sans-serif'],
                }
            }
        }
    }
</script>

<div class="min-h-screen bg-light font-body py-10 px-4">
    <div class="max-w-2xl mx-auto">
        <div class="mb-6 flex items-center justify-between">
            <h1 class="text-xl font-bold font-heading text-tertiary">⭐ Lịch sử điểm</h1>
            <a asp-action="Index" class="text-sm font-semibold text-secondary hover:underline">← Về hồ sơ</a>
        </div>

        <div class="rounded-2xl bg-white p-6 shadow-md">
            @if (Model.Items == null || !Model.Items.Any())
            {
                <p class="text-center text-gray-500 py-6">Chưa có giao dịch điểm nào.</p>
            }
            else
            {
                <ul class="divide-y divide-gray-100">
                    @foreach (var item in Model.Items)
                    {
                        <li class="flex items-center justify-between py-4">
                            <div>
                                <p class="font-semibold text-gray-800">@item.ActionLabel</p>
                                <p class="text-sm text-gray-500">
                                    @(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)
                                </p>
                                <p class="text-xs text-gray-400">
                                    @item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                            <span class="text-lg font-bold @(item.IsPositive ? "text-green-600" : "text-red-600")">
                                @item.PointsDisplay
                            </span>
                        </li>
                    }
                </ul>

                @* ===== Thanh phân trang (chỉ hiện khi > 1 trang) ===== *@
                @if (Model.TotalPages > 1)
                {
                    <div class="mt-6 flex items-center justify-center gap-2">
                        @* Nút Trước *@
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="PointHistory" asp-route-page="@(Model.CurrentPage - 1)"
                               class="rounded-lg border border-gray-300 px-3 py-1 text-sm text-gray-600 hover:bg-gray-100">‹ Trước</a>
                        }
                        else
                        {
                            <span class="rounded-lg border border-gray-200 px-3 py-1 text-sm text-gray-300">‹ Trước</span>
                        }

                        @* Số trang *@
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <span class="rounded-lg bg-primary px-3 py-1 text-sm font-semibold text-white">@i</span>
                            }
                            else
                            {
                                <a asp-action="PointHistory" asp-route-page="@i"
                                   class="rounded-lg border border-gray-300 px-3 py-1 text-sm text-gray-600 hover:bg-primary hover:text-white hover:border-primary">@i</a>
                            }
                        }

                        @* Nút Sau *@
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="PointHistory" asp-route-page="@(Model.CurrentPage + 1)"
                               class="rounded-lg border border-gray-300 px-3 py-1 text-sm text-gray-600 hover:bg-gray-100">Sau ›</a>
                        }
                        else
                        {
                            <span class="rounded-lg border border-gray-200 px-3 py-1 text-sm text-gray-300">Sau ›</span>
                        }
                    </div>

                    <p class="mt-3 text-center text-xs text-gray-400">
                        Trang @Model.CurrentPage / @Model.TotalPages — tổng @Model.TotalItems giao dịch
                    </p>
                }
            }
        </div>
    </div>
</div>
