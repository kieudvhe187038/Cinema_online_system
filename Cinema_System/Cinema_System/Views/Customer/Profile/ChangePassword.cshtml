@model Cinema_System.Application.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    // Icon con mắt (SVG) dùng cho nút hiện/ẩn mật khẩu — trang này không nạp font Material Symbols
    var eyeIcon = "<svg class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>";
}

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script>
    tailwind.config = {
        important: true,
        theme: {
            extend: {
                colors: {
                    primary: '#F37021',
                    'primary-dark': '#d85f15',
                    secondary: '#00488D',
                    tertiary: '#002F59',
                    light: '#F8F9FA',
                },
                fontFamily: {
                    heading: ['"Plus Jakarta Sans"', 'sans-serif'],
                    body: ['"Be Vietnam Pro"', 'sans-serif'],
                }
            }
        }
    }
</script>

<div class="min-h-screen bg-light font-body py-10 px-4">
    <div class="max-w-md mx-auto rounded-2xl bg-white p-8 shadow-md">
        <h1 class="mb-6 text-xl font-bold font-heading text-tertiary">🔒 Đổi mật khẩu</h1>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="mb-3 text-sm text-red-600"></div>

            <div class="mb-4">
                <label asp-for="OldPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
                <div class="relative">
                    <input asp-for="OldPassword" autocomplete="current-password"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-11 focus:border-primary focus:ring-1 focus:ring-primary outline-none" />
                    <button type="button" class="toggle-pw absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary" aria-label="Hiện/ẩn mật khẩu">
                        @Html.Raw(eyeIcon)
                    </button>
                </div>
                <span asp-validation-for="OldPassword" class="text-sm text-red-600"></span>
            </div>

            <div class="mb-4">
                <label asp-for="NewPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
                <div class="relative">
                    <input asp-for="NewPassword" autocomplete="new-password"
                           placeholder="6–72 ký tự (chữ, số, ký tự đặc biệt)"
                           minlength="6" maxlength="72" pattern="[!-~]{6,72}"
                           title="Mật khẩu 6–72 ký tự, gồm chữ/số/ký tự đặc biệt, không dấu tiếng Việt hay khoảng trắng."
                           class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-11 focus:border-primary focus:ring-1 focus:ring-primary outline-none" />
                    <button type="button" class="toggle-pw absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary" aria-label="Hiện/ẩn mật khẩu">
                        @Html.Raw(eyeIcon)
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-sm text-red-600"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
                <div class="relative">
                    <input asp-for="ConfirmPassword" autocomplete="new-password"
                           minlength="6" maxlength="72"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-11 focus:border-primary focus:ring-1 focus:ring-primary outline-none" />
                    <button type="button" class="toggle-pw absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary" aria-label="Hiện/ẩn mật khẩu">
                        @Html.Raw(eyeIcon)
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-sm text-red-600"></span>
            </div>

            <div class="mt-6 flex gap-3">
                <button type="submit"
                        class="flex-1 rounded-xl bg-primary px-4 py-3 font-semibold text-white hover:bg-primary-dark transition">
                    Xác nhận đổi
                </button>
                <a asp-action="Index"
                   class="flex-1 rounded-xl border-2 border-secondary px-4 py-3 text-center font-semibold text-secondary hover:bg-secondary hover:text-white transition">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Hiện/ẩn mật khẩu cho các ô có nút toggle
        document.querySelectorAll('.toggle-pw').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = btn.parentElement.querySelector('input');
                input.type = input.type === 'password' ? 'text' : 'password';
            });
        });
    </script>
}
