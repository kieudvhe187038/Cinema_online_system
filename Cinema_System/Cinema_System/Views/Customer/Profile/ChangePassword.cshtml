@model Cinema_System.Application.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["Heading"] = "Đổi mật khẩu";
    ViewData["UserName"] = User.Identity?.Name;
    Layout = "_CineStarLayout";
    // Icon con mắt (SVG) cho nút hiện/ẩn mật khẩu
    var eyeIcon = "<svg class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>";
}

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- ===== Form (cột rộng) ===== -->
    <div class="lg:col-span-2 flex flex-col rounded-2xl bg-white p-8 shadow-md">
        <h2 class="text-2xl font-bold font-heading text-tertiary">Cài đặt mật khẩu</h2>
        <p class="mt-1 mb-6 text-sm text-gray-500">Vui lòng nhập mật khẩu hiện tại và mật khẩu mới để cập nhật bảo mật tài khoản.</p>

        <form asp-action="ChangePassword" method="post" class="flex flex-1 flex-col">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="mb-3 text-sm text-red-600"></div>

            <!-- Mật khẩu hiện tại -->
            <div class="mb-5">
                <label asp-for="OldPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
                <div class="relative">
                    <input asp-for="OldPassword" autocomplete="current-password"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 pr-11 focus:border-primary focus:ring-1 focus:ring-primary outline-none" />
                    <button type="button" class="toggle-pw absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary" aria-label="Hiện/ẩn mật khẩu">@Html.Raw(eyeIcon)</button>
                </div>
                <span asp-validation-for="OldPassword" class="text-sm text-red-600"></span>
            </div>

            <!-- Mật khẩu mới -->
            <div class="mb-5">
                <label asp-for="NewPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
                <div class="relative">
                    <input asp-for="NewPassword" autocomplete="new-password"
                           minlength="6" maxlength="72" pattern="[!-~]{6,72}"
                           title="Mật khẩu 6–72 ký tự, gồm chữ/số/ký tự đặc biệt, không dấu tiếng Việt hay khoảng trắng."
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 pr-11 focus:border-primary focus:ring-1 focus:ring-primary outline-none" />
                    <button type="button" class="toggle-pw absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary" aria-label="Hiện/ẩn mật khẩu">@Html.Raw(eyeIcon)</button>
                </div>
                <span asp-validation-for="NewPassword" class="text-sm text-red-600"></span>
            </div>

            <!-- Nhập lại mật khẩu mới (xuống dưới) -->
            <div class="mb-5">
                <label asp-for="ConfirmPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
                <div class="relative">
                    <input asp-for="ConfirmPassword" autocomplete="new-password"
                           minlength="6" maxlength="72"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 pr-11 focus:border-primary focus:ring-1 focus:ring-primary outline-none" />
                    <button type="button" class="toggle-pw absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary" aria-label="Hiện/ẩn mật khẩu">@Html.Raw(eyeIcon)</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-sm text-red-600"></span>
            </div>

            <div class="mt-auto flex items-center gap-4 pt-8">
                <button type="submit"
                        class="rounded-xl bg-primary px-6 py-3 font-semibold text-white hover:bg-primary-dark transition">
                    Cập nhật mật khẩu
                </button>
                <a asp-action="Index" class="font-semibold text-gray-500 hover:text-tertiary">Hủy bỏ</a>
            </div>
        </form>
    </div>

    <!-- ===== Cột phải: mẹo + hỗ trợ + quảng cáo ===== -->
    <div class="space-y-6">
        <!-- Mẹo mật khẩu an toàn -->
        <div class="rounded-2xl bg-primary/5 p-5">
            <h4 class="mb-3 flex items-center gap-2 font-bold text-tertiary">
                <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
                Mẹo mật khẩu an toàn
            </h4>
            <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex gap-2"><span class="text-primary">✓</span> Ít nhất 6 ký tự</li>
                <li class="flex gap-2"><span class="text-primary">✓</span> Bao gồm chữ hoa và chữ thường</li>
                <li class="flex gap-2"><span class="text-primary">✓</span> Chứa ít nhất một số hoặc ký tự đặc biệt</li>
            </ul>
        </div>

        <!-- Quảng cáo -->
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-tertiary to-secondary p-5 text-white">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0,rgba(243,112,33,0.45),transparent_60%)]"></div>
            <p class="relative mt-16 font-heading font-bold">Trải nghiệm điện ảnh đẳng cấp tại CineStar</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Hiện/ẩn mật khẩu cho các ô có nút toggle
        document.querySelectorAll('.toggle-pw').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = btn.parentElement.querySelector('input');
                input.type = input.type === 'password' ? 'text' : 'password';
            });
        });
    </script>
}
