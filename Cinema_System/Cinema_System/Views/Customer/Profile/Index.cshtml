@model Cinema_System.Application.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    ViewData["Heading"] = "Cài đặt tài khoản";
    // Truyền thông tin user cho sidebar/topbar của layout
    ViewData["UserName"] = Model.FullName;
    ViewData["UserRole"] = Model.RoleName;
    ViewData["UserAvatar"] = Model.AvatarUrl;   // có ảnh thì sidebar hiện ảnh thật
    Layout = "_CineStarLayout";
}

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-xl bg-green-100 border border-green-300 text-green-800 px-4 py-3">
        @TempData["Success"]
    </div>
}

<!-- ===== Hero banner ===== nền gradient xanh đậm + lớp phủ ánh cam tạo chiều sâu giống ảnh thật -->
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-tertiary via-secondary to-tertiary p-6 shadow-lg">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_-20%,rgba(243,112,33,0.35),transparent_55%)]"></div>

    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
            <!-- Avatar khung cam (bo góc, không tròn) -->
            <div class="rounded-xl border-2 border-primary p-1 shadow-md">
                <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://placehold.co/96x96?text=Avatar" : Model.AvatarUrl)"
                     alt="Ảnh đại diện"
                     class="h-20 w-20 rounded-lg object-cover bg-white" />
            </div>

            <div class="font-heading text-white">
                <h2 class="text-2xl font-bold">@Model.FullName</h2>
                <div class="mt-2 flex flex-wrap items-center gap-2">
                    <span class="rounded-full border border-primary/70 px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-primary">
                        @Model.RoleName
                    </span>
                    @if (Model.RoleName == "CUSTOMER")
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-primary px-3 py-0.5 text-xs font-semibold text-white">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.48 3.5a.562.562 0 011.04 0l2.125 5.11a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.562.562 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.884a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
                            @Model.RewardPoints điểm
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Nút chỉnh sửa hồ sơ -->
        <div>
            <a asp-action="Edit"
               class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 font-semibold text-white shadow hover:bg-primary-dark transition">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" /></svg>
                Chỉnh sửa hồ sơ
            </a>
        </div>
    </div>
</div>

<!-- ===== Thông tin cá nhân (full-width, lưới 3 cột cho đỡ trống) ===== -->
<div class="mt-6 rounded-2xl bg-white p-6 shadow-md">
    <h3 class="mb-5 flex items-center gap-2 text-lg font-bold font-heading text-tertiary">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" /></svg>
        Thông tin cá nhân
    </h3>

    <dl class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Họ và tên</dt>
            <dd class="mt-1 font-semibold text-tertiary">@Model.FullName</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Email</dt>
            <dd class="mt-1 font-semibold text-tertiary">@Model.Email</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Số điện thoại</dt>
            <dd class="mt-1 font-semibold text-tertiary">
                @(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)
            </dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Ngày sinh</dt>
            <dd class="mt-1 font-semibold text-tertiary">
                @if (Model.DateOfBirth == null)
                {
                    <span>Chưa cập nhật</span>
                }
                else
                {
                    @Model.DateOfBirth.Value.ToString("dd/MM/yyyy")
                    <span class="text-gray-500">(@Model.Age tuổi)</span>
                }
            </dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Vai trò</dt>
            <dd class="mt-1 font-semibold text-tertiary">@Model.RoleName</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Trạng thái</dt>
            <dd class="mt-1">
                <span class="inline-block rounded-full px-3 py-1 text-sm font-semibold text-white
                    @(Model.Status == "Active" ? "bg-green-500" : "bg-red-500")">
                    @Model.Status
                </span>
            </dd>
        </div>
    </dl>
</div>

<!-- ===== Tài khoản (full-width, 1 hàng ngang ở dưới) ===== -->
<div class="mt-6 rounded-2xl bg-white p-6 shadow-md">
    <h3 class="mb-5 flex items-center gap-2 text-lg font-bold font-heading text-tertiary">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
        Tài khoản
    </h3>

    <!-- Trái: ngày tạo | Phải: các nút. Màn nhỏ thì xếp dọc -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="sm:w-72">
            <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-400">Ngày tạo tài khoản</p>
            <div class="rounded-lg bg-light px-3 py-2 font-semibold text-tertiary">
                @Model.CreatedAt.ToString("dd/MM/yyyy")
            </div>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
            <a asp-action="ChangePassword"
               class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-primary px-5 py-2.5 text-center font-semibold text-primary hover:bg-primary hover:text-white transition">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
                Đổi mật khẩu
            </a>

            @if (Model.RoleName == "CUSTOMER")
            {
                <a asp-action="PointHistory"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-secondary px-5 py-2.5 text-center font-semibold text-secondary hover:bg-secondary hover:text-white transition">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
                    Lịch sử điểm
                </a>
            }
        </div>
    </div>
</div>
