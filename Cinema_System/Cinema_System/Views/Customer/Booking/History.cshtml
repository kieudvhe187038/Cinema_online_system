@model Cinema_System.Application.ViewModels.BookingHistoryPageViewModel
@{
    ViewData["Title"] = "Lịch sử đặt vé";
    ViewData["Heading"] = "Lịch sử đặt vé";
    ViewData["UserName"] = User.Identity?.Name;
    Layout = "_CineStarLayout";
}

@if (TempData["Error"] != null)
{
    <div class="mb-4 flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
        @TempData["Error"]
    </div>
}

<div class="rounded-2xl bg-white p-6 shadow-md">
    <h3 class="mb-5 flex items-center gap-2 text-lg font-bold font-heading text-tertiary">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>
        Lịch sử đặt vé
    </h3>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <p class="py-8 text-center text-gray-500">Bạn chưa có lượt đặt vé nào.</p>
    }
    else
    {
        <ul class="divide-y divide-gray-100">
            @foreach (var item in Model.Items)
            {
                <li class="flex items-center gap-4 py-4">
                    <img src="@(MediaUrl.Poster(item.PosterUrl) ?? "https://placehold.co/60x84?text=Phim")"
                         onerror="this.src='https://placehold.co/60x84?text=Phim'"
                         class="h-21 w-16 rounded-lg object-cover bg-gray-100" style="height:84px;width:60px" alt="poster" />

                    <div class="min-w-0 flex-1">
                        <p class="truncate font-semibold text-tertiary">@item.MovieTitle</p>
                        <p class="text-sm text-gray-500">
                            Suất: @item.StartTime.ToString("HH:mm dd/MM/yyyy") · @item.SeatCount ghế
                        </p>
                        <p class="text-xs text-gray-400">Đặt ngày @item.CreatedAt?.ToString("dd/MM/yyyy")</p>
                    </div>

                    <div class="text-right">
                        <p class="font-bold text-primary">@item.FinalAmountDisplay</p>
                        <span class="mt-1 inline-block rounded-full px-3 py-0.5 text-xs font-semibold text-white @item.PaymentStatusClass">
                            @item.PaymentStatusLabel
                        </span>
                    </div>

                    <a asp-action="Detail" asp-route-id="@item.Id"
                       class="rounded-lg border-2 border-secondary px-3 py-1.5 text-sm font-semibold text-secondary hover:bg-secondary hover:text-white transition">
                        Chi tiết
                    </a>
                </li>
            }
        </ul>

        @* Phân trang gọn dạng "…" (chỉ hiện trang 1, cuối, và quanh trang hiện tại) *@
        @if (Model.TotalPages > 1)
        {
            var total = Model.TotalPages;
            var cur = Model.CurrentPage;
            var show = new SortedSet<int> { 1, total };
            for (int p = cur - 1; p <= cur + 1; p++) { if (p >= 1 && p <= total) show.Add(p); }

            <div class="mt-6 flex items-center justify-center gap-1.5">
                @* Nút Trước *@
                @if (cur > 1)
                {
                    <a asp-action="History" asp-route-page="@(cur - 1)" class="rounded-lg border border-gray-300 px-2.5 py-1 text-sm text-gray-600 hover:bg-gray-100">‹</a>
                }
                else
                {
                    <span class="rounded-lg border border-gray-200 px-2.5 py-1 text-sm text-gray-300">‹</span>
                }

                @{ int prev = 0; }
                @foreach (var p in show)
                {
                    if (prev != 0 && p - prev > 1)
                    {
                        <span class="px-1 text-gray-400">…</span>
                    }
                    if (p == cur)
                    {
                        <span class="rounded-lg bg-primary px-3 py-1 text-sm font-semibold text-white">@p</span>
                    }
                    else
                    {
                        <a asp-action="History" asp-route-page="@p" class="rounded-lg border border-gray-300 px-3 py-1 text-sm text-gray-600 hover:bg-primary hover:text-white hover:border-primary">@p</a>
                    }
                    prev = p;
                }

                @* Nút Sau *@
                @if (cur < total)
                {
                    <a asp-action="History" asp-route-page="@(cur + 1)" class="rounded-lg border border-gray-300 px-2.5 py-1 text-sm text-gray-600 hover:bg-gray-100">›</a>
                }
                else
                {
                    <span class="rounded-lg border border-gray-200 px-2.5 py-1 text-sm text-gray-300">›</span>
                }
            </div>
            <p class="mt-3 text-center text-xs text-gray-400">Trang @cur / @total — tổng @Model.TotalItems lượt đặt</p>
        }
    }
</div>
