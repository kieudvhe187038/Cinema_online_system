@model Cinema_System.Application.ViewModels.BookingDetailViewModel
@{
    ViewData["Title"] = "Chi tiết đặt vé";
    ViewData["Heading"] = "Chi tiết đặt vé";
    ViewData["UserName"] = User.Identity?.Name;
    Layout = "_CineStarLayout";

    var qrContent = string.IsNullOrEmpty(Model.QrCode) ? Model.Id.ToString() : Model.QrCode;
    var seats = string.Join(", ", Model.Seats.Select(s => s.SeatLabel));
    var foodNames = Model.Foods.Any() ? string.Join(", ", Model.Foods.Select(f => $"{f.Name} x{f.Quantity}")) : "Không có";
}

<div class="mb-4">
    <a asp-action="History" class="inline-flex items-center gap-1 text-sm font-semibold text-secondary hover:underline">← Về lịch sử đặt vé</a>
</div>

<!-- Banner theo trạng thái thanh toán -->
@if (Model.IsPaid)
{
    <div class="mb-6 flex items-start gap-3 rounded-xl border border-green-200 bg-green-50 px-4 py-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <div>
            <p class="font-semibold text-green-800">Đặt vé thành công!</p>
            <p class="text-sm text-green-700">Vui lòng xuất trình mã QR tại quầy vé hoặc máy soát vé.</p>
        </div>
    </div>
}
else if (Model.PaymentStatus == "Pending")
{
    <div class="mb-6 flex items-start gap-3 rounded-xl border border-yellow-200 bg-yellow-50 px-4 py-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <div>
            <p class="font-semibold text-yellow-800">Đơn đang chờ thanh toán</p>
            <p class="text-sm text-yellow-700">Vé điện tử sẽ khả dụng sau khi thanh toán thành công.</p>
        </div>
    </div>
}
else
{
    <div class="mb-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
        <div>
            <p class="font-semibold text-red-800">Đơn @Model.PaymentStatusLabel.ToLower()</p>
            <p class="text-sm text-red-700">Đơn này không có vé điện tử hợp lệ.</p>
        </div>
    </div>
}

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- ===== Cột trái: thông tin đơn ===== -->
    <div class="lg:col-span-2 rounded-2xl bg-white p-6 shadow-md">
        <div class="flex flex-col gap-5 sm:flex-row">
            <img src="@(MediaUrl.Poster(Model.PosterUrl) ?? "https://placehold.co/130x180?text=Phim")"
                 onerror="this.src='https://placehold.co/130x180?text=Phim'"
                 class="h-48 w-32 shrink-0 rounded-xl object-cover bg-gray-100" alt="poster" />
            <div class="flex-1">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h2 class="text-xl font-bold font-heading text-tertiary">@Model.MovieTitle</h2>
                        <div class="mt-1 flex flex-wrap items-center gap-2 text-xs">
                            @if (!string.IsNullOrEmpty(Model.AgeRating))
                            {
                                <span class="rounded bg-red-100 px-2 py-0.5 font-semibold text-red-600">@Model.AgeRating</span>
                            }
                            <span class="text-gray-400">@(Model.DurationMinutes?.ToString() ?? "—") phút</span>
                        </div>
                    </div>
                    <span class="rounded-full px-3 py-1 text-xs font-semibold text-white @Model.PaymentStatusClass">@Model.PaymentStatusLabel</span>
                </div>

                <dl class="mt-4 grid grid-cols-1 gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
                    <div><dt class="text-xs uppercase tracking-wide text-gray-400">Mã đơn hàng</dt><dd class="font-semibold break-all text-tertiary">@qrContent</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-gray-400">Ngày đặt</dt><dd class="font-semibold text-tertiary">@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-gray-400">Ngày chiếu</dt><dd class="font-semibold text-tertiary">@Model.StartTime.ToString("dd/MM/yyyy")</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-gray-400">Suất chiếu</dt><dd class="font-semibold text-tertiary">@Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-gray-400">Rạp / Phòng</dt><dd class="font-semibold text-tertiary">@Model.RoomName</dd></div>
                    <div><dt class="text-xs uppercase tracking-wide text-gray-400">Số ghế</dt><dd class="font-semibold text-primary">@seats</dd></div>
                    <div class="sm:col-span-2"><dt class="text-xs uppercase tracking-wide text-gray-400">Bắp nước kèm theo</dt><dd class="font-semibold text-tertiary">@foodNames</dd></div>
                </dl>
            </div>
        </div>

        @if (Model.IsPaid)
        {
            <a asp-action="ETicket" asp-route-id="@Model.Id"
               class="mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-white shadow hover:bg-primary-dark transition">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>
                Xem vé điện tử
            </a>
        }
        else
        {
            <p class="mt-6 inline-flex items-center gap-2 rounded-xl bg-gray-100 px-6 py-3 font-semibold text-gray-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>
                Vé điện tử chưa khả dụng
            </p>
        }
    </div>

    <!-- ===== Cột phải: QR + thanh toán ===== -->
    <div class="rounded-2xl bg-white p-6 shadow-md">
        @if (Model.IsPaid)
        {
            <p class="mb-3 text-center text-xs font-semibold uppercase tracking-wide text-gray-400">Quét mã tại quầy</p>
            <div class="flex justify-center">
                <div id="qrcode" class="rounded-xl border border-gray-100 p-2"></div>
            </div>
        }
        else
        {
            <div class="rounded-xl bg-gray-50 px-4 py-6 text-center text-sm text-gray-400">
                Mã QR chỉ có khi đơn đã thanh toán.
            </div>
        }

        <h3 class="mb-3 mt-6 border-t pt-4 text-sm font-bold uppercase tracking-wide text-tertiary">Chi tiết thanh toán</h3>
        <dl class="space-y-2 text-sm">
            @* Gộp ghế theo loại: Ghế VIP (x2) ... *@
            @foreach (var g in Model.Seats.GroupBy(s => s.SeatTypeName))
            {
                <div class="flex justify-between">
                    <dt class="text-gray-500">Ghế @g.Key (x@(g.Count()))</dt>
                    <dd class="text-tertiary">@g.Sum(x => x.Price).ToString("#,##0")đ</dd>
                </div>
            }
            @foreach (var f in Model.Foods)
            {
                <div class="flex justify-between">
                    <dt class="text-gray-500">@f.Name (x@(f.Quantity))</dt>
                    <dd class="text-tertiary">@f.LineTotalDisplay</dd>
                </div>
            }
            @if ((Model.VatAmount ?? 0) > 0)
            {
                <div class="flex justify-between"><dt class="text-gray-500">Phí tiện ích</dt><dd class="text-tertiary">@Model.VatDisplay</dd></div>
            }
            @if ((Model.DiscountAmount ?? 0) > 0)
            {
                <div class="flex justify-between"><dt class="text-gray-500">Giảm giá</dt><dd class="text-green-600">@Model.DiscountDisplay</dd></div>
            }
            <div class="flex justify-between border-t pt-3 text-base font-bold">
                <dt class="text-tertiary">Tổng cộng</dt><dd class="text-primary">@Model.FinalAmountDisplay</dd>
            </div>
        </dl>
    </div>
</div>

<!-- Cần hỗ trợ -->
<div class="mt-6 rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
    <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-secondary/10 text-secondary">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
        </div>
        <div>
            <p class="font-semibold text-tertiary">Cần hỗ trợ?</p>
            <p class="text-sm text-gray-500">Nếu có thắc mắc về đơn hàng, gọi hotline <span class="font-semibold text-primary">1900 1234</span>.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        var qrEl = document.getElementById("qrcode");
        if (qrEl) new QRCode(qrEl, { text: "@qrContent", width: 120, height: 120, colorDark: "#002F59", colorLight: "#ffffff" });
    </script>
}
