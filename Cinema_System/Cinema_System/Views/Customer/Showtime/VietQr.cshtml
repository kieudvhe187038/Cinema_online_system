@* Trang quét VietQR: hiển thị mã QR chuyển khoản; khách chuyển xong bấm xác nhận để tạo đơn. *@
@model Cinema_System.Application.ViewModels.VietQrViewModel
@{
    ViewData["Title"] = "Chuyển khoản VietQR";
}

<div class="mx-auto max-w-md px-4 py-8 sm:px-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
        <h1 class="font-heading text-xl font-black text-tertiary">Quét VietQR để thanh toán</h1>
        <p class="mt-1 text-sm text-slate-500">@Model.MovieTitle · @Model.StartTime.ToString("HH:mm dd/MM/yyyy")</p>

        <div class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700">
            Thời gian còn lại: <span id="hold-countdown" class="font-bold">--:--</span>. Hết giờ sẽ tự quay về trang chủ.
        </div>

        <!-- Ảnh QR -->
        <div class="mt-4 flex justify-center">
            <img src="@Model.QrUrl" alt="VietQR" class="h-64 w-64 rounded-xl border border-slate-200" />
        </div>

        <!-- Thông tin chuyển khoản -->
        <div class="mt-4 space-y-2 rounded-xl bg-slate-50 p-4 text-left text-sm">
            <div class="flex justify-between"><span class="text-slate-500">Chủ tài khoản</span><span class="font-semibold text-slate-800">@Model.AccountName</span></div>
            <div class="flex justify-between"><span class="text-slate-500">Số tài khoản</span><span class="font-semibold text-slate-800">@Model.AccountNo</span></div>
            <div class="flex justify-between"><span class="text-slate-500">Nội dung</span><span class="font-semibold text-slate-800">@Model.TransferContent</span></div>
            <div class="flex justify-between border-t border-slate-200 pt-2">
                <span class="font-semibold text-slate-700">Số tiền</span>
                <span class="text-lg font-bold text-primary">@Model.Amount.ToString("N0") ₫</span>
            </div>
        </div>

        <p class="mt-3 text-xs text-slate-400">Mở app ngân hàng → quét mã → kiểm tra đúng số tiền & nội dung → chuyển khoản.</p>

        <!-- Xác nhận đã chuyển khoản -> tạo đơn -->
        <form method="post" action="@Url.Action("VietQrPaid", "Showtime")" id="paid-form" class="mt-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ShowtimeId" />
            <input type="hidden" name="pointsUsed" value="@Model.PointsUsed" />
            <input type="hidden" name="promoCode" value="@Model.PromoCode" />
            @for (int i = 0; i < Model.FoodIds.Count; i++)
            {
                <input type="hidden" name="fbId" value="@Model.FoodIds[i]" />
                <input type="hidden" name="qty" value="@Model.FoodQtys[i]" />
            }
            <button type="submit" class="w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-white transition hover:bg-primary-dark">
                Tôi đã chuyển khoản
            </button>
        </form>
        <a href="@Url.Action("SelectSeats", "Showtime", new { id = Model.ShowtimeId })" id="back-link"
           class="mt-2 block text-xs text-slate-400 hover:text-primary">Hủy & chọn lại</a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const showtimeId = '@Model.ShowtimeId';
            const homeUrl = '@Url.Action("Index", "Home")';
            const releaseAllUrl = '@Url.Action("ReleaseAll", "Showtime")';
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            let proceeding = false;

            // Đếm ngược nối tiếp thời gian giữ ghế; hết giờ về trang chủ.
            let countdown = @Model.HoldSecondsLeft;
            const el = document.getElementById('hold-countdown');
            const fmt = s => { const m = Math.floor(s / 60), ss = s % 60; return m + ':' + (ss < 10 ? '0' : '') + ss; };
            el.textContent = fmt(Math.max(0, countdown));
            const tick = setInterval(() => {
                countdown--;
                el.textContent = fmt(Math.max(0, countdown));
                if (countdown <= 0) { clearInterval(tick); window.location.href = homeUrl; }
            }, 1000);

            // Xác nhận / hủy -> rời trang trong luồng, không nhả ghế.
            document.getElementById('paid-form').addEventListener('submit', () => { proceeding = true; });
            document.getElementById('back-link').addEventListener('click', () => { proceeding = true; });

            // Đóng tab -> nhả ghế đang giữ.
            window.addEventListener('pagehide', () => {
                if (proceeding) return;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('showtimeId', showtimeId);
                navigator.sendBeacon(releaseAllUrl, fd);
            });
        })();
    </script>
}
