@* Trang thanh toán (giả lập): chọn phương thức VNPay/MoMo, xem tổng tiền, xác nhận đặt vé. *@
@model Cinema_System.Application.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="font-heading text-2xl font-black text-tertiary">Thanh toán</h1>
    <p class="mt-1 text-sm text-slate-600">
        @Model.MovieTitle <span class="text-slate-400">·</span> @Model.RoomName
        @if (!string.IsNullOrEmpty(Model.CinemaName)) { <span class="text-slate-400">· @Model.CinemaName</span> }
        <span class="text-slate-400">·</span> @Model.StartTime.ToString("HH:mm dd/MM/yyyy")
    </p>

    <form method="post" action="@Url.Action("Confirm", "Showtime")" id="pay-form" class="mt-6 grid gap-6 lg:grid-cols-[1fr_320px]">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.ShowtimeId" />
        @* Giữ lại đồ ăn đã chọn để tạo đơn khi xác nhận *@
        @foreach (var f in Model.FoodLines)
        {
            <input type="hidden" name="fbId" value="@f.FbId" />
            <input type="hidden" name="qty" value="@f.Quantity" />
        }

        <!-- Phương thức thanh toán -->
        <div id="payment-methods" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="font-heading text-lg font-bold text-tertiary">Phương thức thanh toán</h2>
            <p class="mt-1 text-xs text-slate-400">VNPay dùng môi trường sandbox (tiền thử nghiệm); MoMo là mô phỏng.</p>

            <label class="mt-4 flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                <input type="radio" name="method" value="VietQR" class="accent-primary" checked />
                <span class="flex h-9 w-14 items-center justify-center rounded bg-emerald-600 text-[10px] font-bold text-white">VietQR</span>
                <span class="text-sm font-semibold text-slate-700">Chuyển khoản VietQR</span>
            </label>
            <label class="mt-3 flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                <input type="radio" name="method" value="VNPay" class="accent-primary" />
                <span class="flex h-9 w-14 items-center justify-center rounded bg-[#005baa] text-xs font-bold text-white">VNPay</span>
                <span class="text-sm font-semibold text-slate-700">Ví điện tử VNPay</span>
            </label>
            <label class="mt-3 flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                <input type="radio" name="method" value="MoMo" class="accent-primary" />
                <span class="flex h-9 w-14 items-center justify-center rounded bg-[#a50064] text-xs font-bold text-white">MoMo</span>
                <span class="text-sm font-semibold text-slate-700">Ví MoMo</span>
            </label>
        </div>

        <!-- Tóm tắt đơn -->
        <div class="h-fit rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:sticky lg:top-28">
            <h2 class="font-heading text-lg font-bold text-tertiary">Đơn hàng</h2>

            <div class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700">
                Thời gian còn lại: <span id="hold-countdown" class="font-bold">--:--</span>
            </div>

            <div class="mt-4 border-t border-slate-100 pt-3">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Ghế (@Model.Seats.Count)</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var s in Model.Seats)
                    {
                        <span class="rounded-md bg-primary/10 px-2 py-1 text-xs font-semibold text-primary">@s.Label</span>
                    }
                </div>
                <div class="mt-2 flex justify-between text-sm">
                    <span class="text-slate-500">Tiền ghế</span>
                    <span class="font-semibold text-slate-800">@Model.SeatTotal.ToString("N0") ₫</span>
                </div>
            </div>

            @if (Model.FoodLines.Any())
            {
                <div class="mt-3 border-t border-slate-100 pt-3">
                    @foreach (var f in Model.FoodLines)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-slate-600">@f.Name × @f.Quantity</span>
                            <span class="font-semibold text-slate-800">@f.LineTotal.ToString("N0") ₫</span>
                        </div>
                    }
                    <div class="mt-2 flex justify-between text-sm">
                        <span class="text-slate-500">Tiền đồ ăn</span>
                        <span class="font-semibold text-slate-800">@Model.FoodTotal.ToString("N0") ₫</span>
                    </div>
                </div>
            }

            <div class="mt-3 flex justify-between border-t border-slate-100 pt-3 text-sm">
                <span class="text-slate-500">Tạm tính</span>
                <span class="font-semibold text-slate-800">@Model.Subtotal.ToString("N0") ₫</span>
            </div>
            <div class="mt-1 flex justify-between text-sm">
                <span class="text-slate-500">VAT (@((Model.VatRate * 100).ToString("0.#"))%)</span>
                <span class="font-semibold text-slate-800">@Model.VatAmount.ToString("N0") ₫</span>
            </div>

            @* Mã giảm giá *@
            <div class="mt-3 rounded-lg bg-slate-50 px-3 py-2">
                <div class="text-xs text-slate-500">Mã giảm giá</div>
                <div class="mt-1.5 flex items-center gap-2">
                    <input type="text" id="promo-input" placeholder="Nhập mã (vd WELCOME20)"
                           class="flex-1 rounded border border-slate-300 px-2 py-1 text-sm uppercase focus:border-primary focus:outline-none" />
                    <button type="button" id="apply-promo" class="rounded bg-primary/10 px-3 py-1 text-xs font-semibold text-primary hover:bg-primary/20">Áp dụng</button>
                </div>
                <p id="promo-msg" class="mt-1 hidden text-xs"></p>
                @* Mã đã áp dụng được gửi kèm khi xác nhận *@
                <input type="hidden" name="promoCode" id="promo-hidden" value="" />
            </div>

            <div id="promo-row" class="mt-2 hidden justify-between text-sm">
                <span id="promo-label" class="text-slate-500">Giảm bằng mã</span>
                <span id="promo-discount-amount" class="font-semibold text-emerald-600">-0 ₫</span>
            </div>

            @* Dùng điểm thưởng để giảm giá *@
            @if (Model.MaxUsablePoints > 0)
            {
                <div class="mt-3 rounded-lg bg-slate-50 px-3 py-2">
                    <div class="flex items-center justify-between text-xs text-slate-500">
                        <span>Điểm thưởng (có @Model.AvailablePoints đ, 1 đ = @Model.PointValueVnd.ToString("N0")₫)</span>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <input type="number" name="pointsUsed" id="points-input" value="0" min="0" max="@Model.MaxUsablePoints"
                               class="w-24 rounded border border-slate-300 px-2 py-1 text-sm focus:border-primary focus:outline-none" />
                        <button type="button" id="use-max-points" class="text-xs font-semibold text-primary hover:underline">Dùng tối đa (@Model.MaxUsablePoints)</button>
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" name="pointsUsed" value="0" />
            }

            <div id="discount-row" class="mt-2 hidden justify-between text-sm">
                <span class="text-slate-500">Giảm bằng điểm</span>
                <span id="discount-amount" class="font-semibold text-emerald-600">-0 ₫</span>
            </div>

            <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">
                <span class="font-semibold text-slate-700">Tổng cộng</span>
                <span class="flex items-baseline gap-2">
                    @* Giá gốc (gạch ngang) chỉ hiện khi có giảm bằng mã/điểm *@
                    <span id="grand-original" class="hidden text-sm font-medium text-slate-400 line-through">@Model.GrandTotal.ToString("N0") ₫</span>
                    <span id="grand-display" class="text-lg font-bold text-primary">@Model.GrandTotal.ToString("N0") ₫</span>
                </span>
            </div>

            <button type="submit" id="confirm-btn"
                    class="mt-4 w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-white transition hover:bg-primary-dark">
                <span id="btn-label">Thanh toán</span> <span id="pay-amount">@Model.GrandTotal.ToString("N0") ₫</span>
            </button>
            <a href="@Url.Action("SelectSeats", "Showtime", new { id = Model.ShowtimeId })" id="back-link"
               class="mt-2 block text-center text-xs text-slate-400 hover:text-primary">Hủy & chọn lại</a>
        </div>
    </form>
</div>

<partial name="_ConfirmModal" />

@section Scripts {
    <script>
        (function () {
            const showtimeId = '@Model.ShowtimeId';
            const homeUrl = '@Url.Action("Index", "Home")';
            const releaseAllUrl = '@Url.Action("ReleaseAll", "Showtime")';
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            let proceeding = false;

            // Đếm ngược nối tiếp thời gian giữ ghế; hết giờ về trang chủ.
            let countdown = @Model.HoldSecondsLeft;
            const countdownEl = document.getElementById('hold-countdown');
            const fmt = s => { const m = Math.floor(s / 60), ss = s % 60; return m + ':' + (ss < 10 ? '0' : '') + ss; };
            countdownEl.textContent = fmt(Math.max(0, countdown));
            const tick = setInterval(() => {
                countdown--;
                countdownEl.textContent = fmt(Math.max(0, countdown));
                if (countdown <= 0) { clearInterval(tick); window.location.href = homeUrl; }
            }, 1000);

            // ── Mã giảm giá + điểm thưởng (xem trước tổng tiền) ──
            const applyPromoUrl = '@Url.Action("ApplyPromo", "Showtime")';
            const foodIds = [@Html.Raw(string.Join(",", Model.FoodLines.Select(f => $"'{f.FbId}'")))];
            const foodQtys = [@string.Join(",", Model.FoodLines.Select(f => f.Quantity))];

            const grandTotal = @Model.GrandTotal;
            const pointValue = @Model.PointValueVnd;
            let maxPoints = @Model.MaxUsablePoints;   // có thể giảm sau khi áp mã
            let promoDiscount = 0;                    // số tiền mã giảm hiện tại
            let promoTarget = null;                   // đối tượng áp dụng của mã: Ticket_Only / Food_Only / All
            const vnd = n => n.toLocaleString('vi-VN') + ' ₫';
            const pointsInput = document.getElementById('points-input');
            const discountRow = document.getElementById('discount-row');
            const discountAmount = document.getElementById('discount-amount');
            const grandDisplay = document.getElementById('grand-display');
            const payAmount = document.getElementById('pay-amount');
            const methodsBox = document.getElementById('payment-methods');
            const btnLabel = document.getElementById('btn-label');

            // Tính lại tổng: trừ mã giảm giá trước, rồi trừ điểm trên phần còn lại.
            function recompute() {
                const afterPromo = grandTotal - promoDiscount;
                let used = parseInt(pointsInput?.value, 10) || 0;
                used = Math.max(0, Math.min(used, maxPoints));
                if (pointsInput) pointsInput.value = used;
                const pointsDisc = used * pointValue;
                const total = afterPromo - pointsDisc;

                const promoRow = document.getElementById('promo-row');
                const promoDiscountAmount = document.getElementById('promo-discount-amount');
                const promoLabel = document.getElementById('promo-label');
                if (promoDiscount > 0) {
                    promoRow.classList.remove('hidden'); promoRow.classList.add('flex');
                    // Hiện rõ khoản giảm bị trừ từ đâu: vé / đồ ăn / cả đơn.
                    promoLabel.textContent = promoTarget === 'Ticket_Only' ? 'Giảm giá vé'
                                           : promoTarget === 'Food_Only' ? 'Giảm giá đồ ăn'
                                           : 'Giảm giá (cả đơn)';
                    promoDiscountAmount.textContent = '-' + vnd(promoDiscount);
                } else {
                    promoRow.classList.add('hidden'); promoRow.classList.remove('flex');
                }

                if (pointsDisc > 0) {
                    discountRow.classList.remove('hidden'); discountRow.classList.add('flex');
                    discountAmount.textContent = '-' + vnd(pointsDisc);
                } else {
                    discountRow.classList.add('hidden'); discountRow.classList.remove('flex');
                }
                // Có giảm (mã hoặc điểm) -> hiện giá gốc gạch ngang bên cạnh giá đã giảm.
                const grandOriginal = document.getElementById('grand-original');
                if (promoDiscount + pointsDisc > 0) {
                    grandOriginal.textContent = vnd(grandTotal);
                    grandOriginal.classList.remove('hidden');
                } else {
                    grandOriginal.classList.add('hidden');
                }

                grandDisplay.textContent = vnd(total);

                // Đơn 0đ (điểm/mã phủ hết): ẩn phương thức thanh toán, đổi nút sang xác nhận miễn phí.
                if (total <= 0) {
                    methodsBox?.classList.add('hidden');
                    btnLabel.textContent = 'Xác nhận đặt vé (miễn phí)';
                    payAmount.classList.add('hidden');
                } else {
                    methodsBox?.classList.remove('hidden');
                    btnLabel.textContent = 'Thanh toán';
                    payAmount.classList.remove('hidden');
                    payAmount.textContent = vnd(total);
                }
            }
            if (pointsInput) {
                pointsInput.addEventListener('input', recompute);
                document.getElementById('use-max-points')?.addEventListener('click', () => {
                    pointsInput.value = maxPoints; recompute();
                });
            }

            // Áp mã giảm giá qua AJAX.
            const promoInput = document.getElementById('promo-input');
            const promoHidden = document.getElementById('promo-hidden');
            const promoMsg = document.getElementById('promo-msg');
            document.getElementById('apply-promo').addEventListener('click', async () => {
                const code = (promoInput.value || '').trim().toUpperCase();
                promoMsg.classList.remove('hidden');
                if (!code) {
                    promoDiscount = 0; promoTarget = null; promoHidden.value = '';
                    promoMsg.className = 'mt-1 text-xs text-rose-600';
                    promoMsg.textContent = 'Vui lòng nhập mã.';
                    recompute(); return;
                }
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('showtimeId', showtimeId);
                fd.append('code', code);
                foodIds.forEach(x => fd.append('fbId', x));
                foodQtys.forEach(x => fd.append('qty', x));
                try {
                    const res = await fetch(applyPromoUrl, { method: 'POST', body: fd });
                    const data = await res.json();
                    if (data.ok) {
                        promoDiscount = data.discount;
                        promoTarget = data.target;
                        promoHidden.value = data.code;
                        maxPoints = data.maxPoints;
                        promoMsg.className = 'mt-1 text-xs text-emerald-600';
                        promoMsg.textContent = data.message;
                    } else {
                        promoDiscount = 0; promoTarget = null; promoHidden.value = '';
                        maxPoints = @Model.MaxUsablePoints;
                        promoMsg.className = 'mt-1 text-xs text-rose-600';
                        promoMsg.textContent = data.message || 'Mã không hợp lệ.';
                    }
                } catch {
                    promoDiscount = 0; promoTarget = null; promoHidden.value = '';
                    promoMsg.className = 'mt-1 text-xs text-rose-600';
                    promoMsg.textContent = 'Không áp dụng được mã, thử lại.';
                }
                recompute();
            });

            // Khởi tạo trạng thái hiển thị (đơn 0đ ngay từ đầu sẽ ẩn phương thức luôn).
            recompute();

            // Bấm thanh toán -> hỏi xác nhận trước; đồng ý mới submit (đặt proceeding=true để pagehide không nhả ghế).
            document.getElementById('pay-form').addEventListener('submit', function (e) {
                if (proceeding) return;              // đã xác nhận -> cho submit đi tiếp
                e.preventDefault();
                const form = this;
                const free = payAmount.classList.contains('hidden');   // đơn 0đ
                const msg = free
                    ? 'Bạn chắc chắn đặt vé (miễn phí) không?'
                    : 'Bạn chắc chắn thanh toán và đặt vé không?';
                const go = () => { proceeding = true; form.submit(); };   // form.submit() bỏ qua listener nên không lặp lại
                if (window.confirmPopup) {
                    window.confirmPopup({ title: 'Xác nhận', message: msg, okText: free ? 'Đặt vé' : 'Thanh toán', type: 'warning' })
                        .then(ok => { if (ok) go(); });
                } else if (confirm(msg)) {
                    go();
                }
            });
            // Hủy & chọn lại -> rời trang trong luồng, không nhả ghế qua pagehide.
            document.getElementById('back-link').addEventListener('click', () => { proceeding = true; });

            // Đóng tab -> nhả ghế đang giữ.
            window.addEventListener('pagehide', () => {
                if (proceeding) return;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('showtimeId', showtimeId);
                navigator.sendBeacon(releaseAllUrl, fd);
            });
        })();
    </script>
}
